                <a href="/uslugi/opisy-produktow/">Opisy produktów</a>
                <a href="/uslugi/email-marketing/">Email marketing</a>
                <a href="/uslugi/social-media/">Social media</a>
                <a href="/uslugi/strategia-content-marketingowa/">Strategia contentowa</a>
              </div>
              <div class="header__dropdown-col">
                <span class="header__dropdown-label">Publikacje & Materiały</span>
                <a href="/uslugi/ebooki/">Ebooki</a>
                <a href="/uslugi/white-papers/">White papers</a>
                <a href="/uslugi/katalogi-broszury/">Katalogi i broszury</a>
                <a href="/uslugi/materialy-szkoleniowe/">Materiały szkoleniowe</a>
                <a href="/uslugi/prezentacje/">Prezentacje</a>
                <a href="/uslugi/dokumentacja-techniczna/">Dokumentacja techniczna</a>
                <a href="/uslugi/landing-page/">Landing page</a>
              </div>
            </div>
          </div>
        </li>
        <li class="header__item"><a href="/o-nas/" class="header__link">O nas</a></li>
        <li class="header__item"><a href="/portfolio/" class="header__link">Portfolio</a></li>
        <li class="header__item"><a href="/blog/" class="header__link">Blog</a></li>
        <li class="header__item"><a href="/cennik/" class="header__link">Cennik</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="Przełącz motyw kolorystyczny"
        title="Przełącz motyw"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a href="/kontakt/" class="header__cta">Kontakt</a>
    </div>

    <div class="header__mobile-actions">
      <button
        class="theme-toggle"
        id="theme-toggle-mobile"
        type="button"
        aria-label="Przełącz motyw kolorystyczny"
      >
        <svg class="theme-toggle__icon theme-toggle__icon--light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="theme-toggle__icon theme-toggle__icon--dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button class="header__burger" id="header-burger" aria-label="Otwórz menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav overlay -->
<div class="mobile-nav" id="mobile-nav" hidden>
  <nav aria-label="Menu mobilne">
    <ul class="mobile-nav__menu">
      <li>
        <button class="mobile-nav__toggle" aria-expanded="false">Usługi</button>
        <div class="mobile-nav__sub" hidden>
          <span class="mobile-nav__label">Content & Copywriting</span>
          <a href="/uslugi/copywriting/">Copywriting</a>
          <a href="/uslugi/seo-copywriting/">SEO Copywriting</a>
          <a href="/uslugi/artykuly-blogowe/">Artykuły blogowe</a>
          <a href="/uslugi/teksty-na-strone/">Teksty na stronę</a>
          <a href="/uslugi/opisy-produktow/">Opisy produktów</a>
          <a href="/uslugi/email-marketing/">Email marketing</a>
          <a href="/uslugi/social-media/">Social media</a>
          <a href="/uslugi/strategia-content-marketingowa/">Strategia contentowa</a>
          <span class="mobile-nav__label">Publikacje & Materiały</span>
          <a href="/uslugi/ebooki/">Ebooki</a>
          <a href="/uslugi/white-papers/">White papers</a>
          <a href="/uslugi/katalogi-broszury/">Katalogi i broszury</a>
          <a href="/uslugi/materialy-szkoleniowe/">Materiały szkoleniowe</a>
          <a href="/uslugi/prezentacje/">Prezentacje</a>
          <a href="/uslugi/dokumentacja-techniczna/">Dokumentacja techniczna</a>
          <a href="/uslugi/landing-page/">Landing page</a>
        </div>
      </li>
      <li><a href="/portfolio/">Portfolio</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/cennik/">Cennik</a></li>
      <li><a href="/kontakt/" class="mobile-nav__cta">Kontakt</a></li>
    </ul>
  </nav>
</div>

<!-- Theme: set before paint to prevent FOUC -->
<script is:inline>
  (function() {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<script>
  function toggleTheme(): void {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  }

  // Both toggle buttons (desktop + mobile)
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Sync with OS if no explicit preference
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e: MediaQueryListEvent) => {
    if (!localStorage.getItem('theme')) {
      document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
    }
  });

  // ── Header scroll ──
  const header = document.getElementById('header');
  if (header) {
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      header.classList.toggle('header--scrolled', y > 60);
      header.classList.toggle('header--hidden', y > 400 && y > lastScroll);
      lastScroll = y;
    });
  }

  // ── Desktop dropdown ──
  const dropdownItem = document.querySelector<HTMLElement>('.header__item--dropdown');
  const dropdownBtn = dropdownItem?.querySelector<HTMLButtonElement>(':scope > .header__link');

  if (dropdownItem && dropdownBtn) {
    dropdownBtn.addEventListener('click', () => {
      const expanded = dropdownBtn.getAttribute('aria-expanded') === 'true';
      dropdownBtn.setAttribute('aria-expanded', String(!expanded));
      dropdownItem.classList.toggle('open');
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as Node | null;
      if (target && !dropdownItem.contains(target)) {
        dropdownBtn.setAttribute('aria-expanded', 'false');
        dropdownItem.classList.remove('open');
      }
    });
  }

  // ── Mobile menu ──
  const burger = document.getElementById('header-burger');
  const mobileNav = document.getElementById('mobile-nav');

  if (burger && mobileNav) {
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      burger.classList.toggle('active');
      if (open) {
        mobileNav.setAttribute('hidden', '');
        document.body.style.overflow = '';
      } else {
        mobileNav.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.mobile-nav__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sub = btn.nextElementSibling as HTMLElement | null;
      if (!sub) return;
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      if (expanded) sub.setAttribute('hidden', '');
      else sub.removeAttribute('hidden');
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .header--scrolled {
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--rule-light);
  }

  .header--hidden {
    transform: translateY(-100%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  /* Logo */
  .header__logo {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    color: var(--ink);
    line-height: 1;
  }

  .header__logo-name {
    display: flex;
    align-items: baseline;
    gap: 1px;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
  }

  .header__logo-mark {
    color: var(--accent);
    font-weight: var(--fw-bold);
    font-style: italic;
  }

  .header__logo-claim {
    font-family: var(--font-mono);
    font-size: 0.53rem;
    font-weight: var(--fw-regular);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 5.5px;
    transition: color var(--transition-fast);
  }

  .header__logo:hover .header__logo-claim {
    color: var(--ink-muted);
  }

  /* Nav */
  .header__nav {
    display: none;
  }

  @media (min-width: 900px) {
    .header__nav { display: block; }
  }

  .header__menu {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--ink-soft);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
  }

  .header__link:hover {
    color: var(--ink);
    background: var(--paper-warm);
  }

  .header__chevron {
    transition: transform var(--transition-fast);
  }

  .header__item--dropdown.open .header__chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .header__item--dropdown {
    position: relative;
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 100;
  }

  .header__item--dropdown.open .header__dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    background: var(--dropdown-bg);
    border: 1px solid var(--rule-light);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-lg);
    min-width: 480px;
  }

  .header__dropdown-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .header__dropdown-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule-light);
  }

  .header__dropdown-col a {
    font-size: var(--fs-sm);
    color: var(--ink-muted);
    padding: 5px 8px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .header__dropdown-col a:hover {
    color: var(--ink);
    background: var(--paper-warm);
  }

  /* Actions (desktop: theme + CTA) */
  .header__actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
  }

  @media (min-width: 900px) {
    .header__actions { display: flex; }
  }

  /* Mobile actions (theme + burger) */
  .header__mobile-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 900px) {
    .header__mobile-actions { display: none; }
  }

  /* Theme Toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    color: var(--ink-muted);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    color: var(--ink);
    background: var(--paper-warm);
  }

  /* In light mode: show moon (switch to dark), hide sun */
  .theme-toggle__icon--light {
    display: none;
  }
  .theme-toggle__icon--dark {
    display: block;
  }

  /* In dark mode: show sun (switch to light), hide moon */
  :global([data-theme="dark"]) .theme-toggle__icon--light {
    display: block;
  }
  :global([data-theme="dark"]) .theme-toggle__icon--dark {
    display: none;
  }

  /* CTA */
  .header__cta {
    padding: 8px 20px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .header__cta:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }

  /* Burger */
  .header__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    cursor: pointer;
  }

  .header__burger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--ink);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  .header__burger:global(.active) span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .header__burger:global(.active) span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Mobile Nav */
  .mobile-nav {
    position: fixed;
    inset: 0;
    top: 72px;
    z-index: 999;
    background: var(--paper);
    overflow-y: auto;
    padding: var(--space-6) var(--gutter);
  }

  .mobile-nav[hidden] { display: none; }

  .mobile-nav__menu {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-nav__menu > li > a,
  .mobile-nav__toggle {
    display: block;
    width: 100%;
    text-align: left;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: var(--fw-medium);
    color: var(--ink);
    border-bottom: 1px solid var(--rule-light);
  }

  .mobile-nav__sub {
    padding: var(--space-2) 0 var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-nav__sub[hidden] { display: none; }

  .mobile-nav__label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .mobile-nav__sub a {
    display: block;
    padding: 6px 0;
    font-size: var(--fs-base);
    color: var(--ink-muted);
  }

  .mobile-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: var(--ink);
    color: var(--paper) !important;
    font-family: var(--font-body) !important;
    font-size: var(--fs-base) !important;
    font-weight: var(--fw-medium);
    border-radius: var(--radius-sm);
    border: none !important;
  }
</style>