---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  updated?: Date;
  author?: string;
  readingTime?: number;
  tags?: string[];
  image?: string;
}

const { title, description = '', date, updated, author = 'Karol Leszczyński', readingTime, tags = [], image } = Astro.props;
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image, 'https://www.ecopywriting.pl').href)
  : 'https://www.ecopywriting.pl/og-default.png';

const formattedDate = date.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updated?.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const currentUrl = Astro.url.href;

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.ecopywriting.pl/#organization",
      "name": "eCopywriting.pl",
      "url": "https://www.ecopywriting.pl",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.ecopywriting.pl/og-default.png"
      }
    },
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": ogImage,
      "datePublished": date.toISOString(),
      ...(updated && { "dateModified": updated.toISOString() }),
      "author": {
        "@id": "https://www.ecopywriting.pl/#organization"
      },
      "publisher": {
        "@id": "https://www.ecopywriting.pl/#organization"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": currentUrl
      },
      "inLanguage": "pl-PL"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.ecopywriting.pl/blog/" },
        { "@type": "ListItem", "position": 3, "name": title }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${title} — eCopywriting.pl`}
  description={description}
  schema={blogSchema}
  canonical={currentUrl}
  ogImage={ogImage}
  ogType="article"
>
  <article class="blog-post">
    <div class="container-narrow">

      <!-- Breadcrumbs -->
      <nav class="blog-post__breadcrumbs" aria-label="Nawigacja okruszkowa">
        <a href="/">Strona główna</a>
        <span class="blog-post__breadcrumbs-sep">/</span>
        <a href="/blog/">Blog</a>
        <span class="blog-post__breadcrumbs-sep">/</span>
        <span>{title}</span>
      </nav>

      <!-- Header -->
      <header class="blog-post__header">
        <h1 class="blog-post__title">{title}</h1>

        <div class="blog-post__meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
          {formattedUpdated && (
            <>
              <span class="blog-post__meta-sep" aria-hidden="true"></span>
              <span class="blog-post__updated">Aktualizacja: {formattedUpdated}</span>
            </>
          )}
          {readingTime && (
            <>
              <span class="blog-post__meta-sep" aria-hidden="true"></span>
              <span>{readingTime} min czytania</span>
            </>
          )}
        </div>

        {tags.length > 0 && (
          <div class="blog-post__tags">
            {tags.map((tag) => (
              <span class="blog-post__tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Content -->
      <div class="blog-post__content prose">
        <slot />
      </div>

      <!-- Footer / Back link -->
      <footer class="blog-post__footer">
        <a href="/blog/" class="blog-post__back">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 8H3M7 4l-4 4 4 4"/></svg>
          Wszystkie artykuły
        </a>
      </footer>

    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding: var(--space-8) 0 var(--space-20);
    margin-top: 20px;
  }

  /* Breadcrumbs */
  .blog-post__breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    margin-bottom: var(--space-8);
    padding-top: var(--space-4);
  }

  .blog-post__breadcrumbs a {
    color: var(--ink-faint);
    transition: color var(--transition-fast);
  }

  .blog-post__breadcrumbs a:hover {
    color: var(--accent);
  }

  .blog-post__breadcrumbs-sep {
    margin: 0 0.5em;
    opacity: 0.4;
  }

  /* Header */
  .blog-post__header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--rule-light);
  }

  .blog-post__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    color: var(--ink);
    max-width: 720px;
    margin-bottom: var(--space-5);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    font-size: var(--fs-sm);
    color: var(--ink-muted);
  }

  .blog-post__meta-sep {
    width: 1px;
    height: 14px;
    background: var(--rule);
    margin: 0 var(--space-3);
  }

  .blog-post__author {
    font-weight: var(--fw-medium);
    color: var(--ink-soft);
  }

  .blog-post__updated {
    font-style: italic;
  }

  .blog-post__tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .blog-post__tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(196, 90, 60, 0.06);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  /* Content — prose styles */
  .blog-post__content {
    max-width: 720px;
  }

  .blog-post__content :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }

  .blog-post__content :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-snug);
    color: var(--ink);
    margin-top: var(--space-10);
    margin-bottom: var(--space-3);
  }

  .blog-post__content :global(p) {
    font-size: 0.98rem;
    line-height: var(--lh-relaxed);
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }

  .blog-post__content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .blog-post__content :global(a:hover) {
    color: var(--ink);
  }

  .blog-post__content :global(strong) {
    color: var(--ink-soft);
    font-weight: var(--fw-medium);
  }

  .blog-post__content :global(ul),
  .blog-post__content :global(ol) {
    margin-bottom: var(--space-5);
    padding-left: var(--space-6);
  }

  .blog-post__content :global(li) {
    font-size: 0.98rem;
    line-height: var(--lh-relaxed);
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .blog-post__content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
    background: var(--paper-warm);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .blog-post__content :global(blockquote p) {
    font-style: italic;
    margin-bottom: 0;
  }

  .blog-post__content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin: var(--space-6) 0;
  }

  .blog-post__content :global(hr) {
    border: none;
    border-top: 1px solid var(--rule-light);
    margin: var(--space-10) 0;
  }

  /* Footer */
  .blog-post__footer {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule-light);
  }

  .blog-post__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--ink-muted);
    transition: color var(--transition-fast);
  }

  .blog-post__back:hover {
    color: var(--accent);
  }

  .blog-post__back svg {
    transition: transform var(--transition-fast);
  }

  .blog-post__back:hover svg {
    transform: translateX(-3px);
  }
</style>
