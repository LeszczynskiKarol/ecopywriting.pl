---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://www.ecopywriting.pl/#organization",
      "name": "eCopywriting.pl",
      "url": "https://www.ecopywriting.pl",
      "description": "Agencja content marketingowa. Tworzymy treści, składamy publikacje i wdrażamy rozwiązania — od strategii po gotowy produkt w każdym formacie.",
      "email": "kontakt@ecopywriting.pl",
      "areaServed": ["PL"],
      "serviceType": [
        "Content marketing",
        "Copywriting",
        "SEO Copywriting",
        "Tworzenie ebooków",
        "White papers",
        "Skład publikacji",
        "Email marketing",
        "Strategia contentowa"
      ],
      "knowsAbout": [
        "Content marketing", "Copywriting", "SEO", "Email marketing",
        "Ebooki", "Publikacje cyfrowe", "Skład tekstu", "AI content",
        "Strategia contentowa", "Technical writing"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.ecopywriting.pl/#website",
      "url": "https://www.ecopywriting.pl",
      "name": "eCopywriting.pl — Agencja Content Marketingowa",
      "publisher": { "@id": "https://www.ecopywriting.pl/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/#webpage",
      "url": "https://www.ecopywriting.pl",
      "name": "Agencja Content Marketingowa — eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "about": { "@id": "https://www.ecopywriting.pl/#organization" },
      "description": "Agencja content marketingowa, która łączy copywriting, technologię i profesjonalny skład. Od strategii treści po gotowy ebook, katalog czy landing page."
    }
  ]
};

// Content services
const contentServices = [
  {
    title: 'Copywriting',
    desc: 'Teksty sprzedażowe, oferty handlowe, slogany i hasła reklamowe, które konwertują.',
    href: '/uslugi/copywriting/'
  },
  {
    title: 'SEO Copywriting',
    desc: 'Artykuły i treści zoptymalizowane pod wyszukiwarki — z researchem fraz i intencji.',
    href: '/uslugi/seo-copywriting/'
  },
  {
    title: 'Artykuły blogowe',
    desc: 'Eksperckie treści budujące autorytet marki i generujące ruch organiczny.',
    href: '/uslugi/artykuly-blogowe/'
  },
  {
    title: 'Teksty na stronę',
    desc: 'Strony firmowe, opisy usług, „O nas" — treści, które budują zaufanie od pierwszego zdania.',
    href: '/uslugi/teksty-na-strone/'
  },
  {
    title: 'Email marketing',
    desc: 'Newslettery, sekwencje powitalne, kampanie sprzedażowe i automatyzacje.',
    href: '/uslugi/email-marketing/'
  },
  {
    title: 'Strategia contentowa',
    desc: 'Audyt treści, kalendarz publikacji, dobór fraz i kanałów — plan, który działa.',
    href: '/uslugi/strategia-content-marketingowa/'
  }
];

// Publication services
const pubServices = [
  {
    title: 'Ebooki',
    desc: 'Ebooki marketingowe, lead magnety i poradniki — piszemy treść i składamy gotową publikację z okładką i layoutem.',
    href: '/uslugi/ebooki/'
  },
  {
    title: 'White papers',
    desc: 'Raporty branżowe, case studies i materiały B2B — research, copywriting i profesjonalny skład dokumentu.',
    href: '/uslugi/white-papers/'
  },
  {
    title: 'Katalogi i broszury',
    desc: 'Katalogi produktowe, foldery i materiały targowe — tekst plus layout, gotowe do druku.',
    href: '/uslugi/katalogi-broszury/'
  },
  {
    title: 'Materiały szkoleniowe',
    desc: 'Podręczniki, skrypty kursów, zeszyty ćwiczeń, materiały onboardingowe — treść i profesjonalny skład.',
    href: '/uslugi/materialy-szkoleniowe/'
  },
  {
    title: 'Prezentacje',
    desc: 'Pitch decki, prezentacje sprzedażowe i konferencyjne — strategiczna narracja i design slajdów.',
    href: '/uslugi/prezentacje/'
  },
  {
    title: 'Dokumentacja techniczna',
    desc: 'Instrukcje, manuele, specyfikacje — technical writing i skład z indeksami i cross-referencjami.',
    href: '/uslugi/dokumentacja-techniczna/'
  }
];

// Pipeline steps
const pipeline = [
  { num: '01', label: 'Strategia', desc: 'Audyt, research fraz, analiza konkurencji, plan treści' },
  { num: '02', label: 'Copywriting', desc: 'Tworzenie treści przez doświadczonych copywriterów' },
  { num: '03', label: 'Redakcja', desc: 'Korekta językowa, fact-checking, optymalizacja SEO' },
  { num: '04', label: 'Skład', desc: 'Profesjonalny layout, typografia, projekt graficzny' },
  { num: '05', label: 'Publikacja', desc: 'Gotowy PDF, ebook, druk lub wdrożenie na stronę' }
];

// Differentiators
const diffs = [
  {
    stat: '15+',
    unit: 'lat',
    title: 'Doświadczenie w content marketingu',
    desc: 'Zaczynaliśmy od copywritingu, zanim content marketing stał się buzzwordem. Ponad 15 lat praktyki w tworzeniu treści, które generują ruch, budują autorytet i konwertują.'
  },
  {
    stat: 'End',
    unit: 'to end',
    title: 'Jeden dostawca zamiast trzech',
    desc: 'Strategia, copywriting, redakcja, skład, wdrożenie — wszystko pod jednym dachem. Nie przekazujemy surowego tekstu w Google Docs. Dostarczamy gotowy produkt.'
  },
  {
    stat: 'Tech',
    unit: '+ human',
    title: 'Technologia, która skaluje jakość',
    desc: 'Własne narzędzia, umiejętności programistyczne i profesjonalny skład tekstu. Łączymy kreatywność i skuteczność marketingową z technologią i estetyką, żeby dostarczać gotowe produkty spełniający najwyższe kryteria — bez kompromisów na jakości.'
  }
];
---

<BaseLayout
  title="Agencja Content Marketingowa — eCopywriting.pl"
  description="Agencja content marketingowa, która łączy copywriting, technologię i profesjonalny skład. Od strategii treści po gotowy ebook, katalog, prezentację czy landing page. 15+ lat doświadczenia."
  keywords="agencja content marketingowa, agencja content marketingu, agencja contentowa, agencja copywriterska, content marketing, copywriting"
  schema={homeSchema}
>

  <!-- ═══════════════════════════════════════
       HERO
       ═══════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <div class="hero__grain"></div>
      <div class="hero__gradient"></div>
    </div>

    <div class="container hero__inner">
      <div class="hero__badge">
        <span class="hero__badge-dot"></span>
        Agencja content marketingowa
      </div>

      <h1 id="hero-title" class="hero__title">
        Od strategii treści<br>
        po <em>gotową publikację</em>
      </h1>

      <p class="hero__subtitle">
        Łączymy content marketing z&nbsp;technologią i&nbsp;profesjonalnym składem.
        Dostarczamy nie tylko treści — ale gotowe produkty: ebooki, katalogi,
        prezentacje i&nbsp;strony internetowe.
      </p>

      <div class="hero__actions">
        <a href="/kontakt/" class="hero__cta-primary">
          Porozmawiajmy o Twoim projekcie
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#proces" class="hero__cta-secondary">
          Jak pracujemy
        </a>
      </div>

      <div class="hero__proof">
        <div class="hero__proof-item">
          <strong>15+</strong> lat doświadczenia
        </div>
        <div class="hero__proof-sep" aria-hidden="true"></div>
        <div class="hero__proof-item">
          <strong>End-to-end</strong> — od treści po druk
        </div>
        <div class="hero__proof-sep" aria-hidden="true"></div>
        <div class="hero__proof-item">
          <strong>Tech-powered</strong> content marketing
        </div>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true">
      <span></span>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PIPELINE — End-to-end process
       ═══════════════════════════════════════ -->
  <section class="pipeline" id="proces" aria-labelledby="pipeline-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Nasz proces"
          title="Jeden zespół. Cały proces.<br>Od pierwszego słowa po ostatni piksel."
          subtitle="Nie kończymy pracy na tekście w Google Docs. Jako agencja contentowa dostarczamy gotowy produkt — napisany, zredagowany, złożony, gotowy do publikacji. Każdy etap na najwyższym poziomie."
        />
      </div>
    </div>

    <div class="container-wide">
      <div class="pipeline__track reveal">
        <div class="pipeline__line" aria-hidden="true"></div>
        {pipeline.map((step, i) => (
          <div class="pipeline__step" style={`--delay: ${i * 0.1}s`}>
            <div class="pipeline__step-num">{step.num}</div>
            <div class="pipeline__step-dot" aria-hidden="true"></div>
            <h3 class="pipeline__step-label">{step.label}</h3>
            <p class="pipeline__step-desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="container">
      <div class="pipeline__note reveal">
        <p>
          Każdy etap realizujemy wewnętrznie — bez outsourcingu, bez przekazywania plików
          między niezależnymi podwykonawcami. To gwarantuje spójność przekazu, oszczędza czas
          i&nbsp;eliminuje „grę w&nbsp;głuchy telefon" między agencją contentową, studiem DTP i&nbsp;software house'em.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SERVICES — Content & Copywriting
       ═══════════════════════════════════════ -->
  <section class="services" id="uslugi" aria-labelledby="services-content-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Content & Copywriting"
          title="Treści, które pracują na Twój biznes"
          subtitle="Copywriting sprzedażowy, artykuły SEO, strategia contentowa — podstawa każdego skutecznego content marketingu."
        />
      </div>

      <div class="services__grid reveal">
        {contentServices.map((s) => (
          <a href={s.href} class="svc-card">
            <h3 class="svc-card__title">{s.title}</h3>
            <p class="svc-card__desc">{s.desc}</p>
            <span class="svc-card__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SERVICES — Publications & Materials
       ═══════════════════════════════════════ -->
  <section class="publications" id="publikacje" aria-labelledby="services-pub-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Publikacje & Materiały"
          title="Gotowe produkty, nie surowe teksty"
          subtitle="Ebooki, katalogi, white papers, prezentacje, dokumentacja — piszemy treść i&nbsp;dostarczamy profesjonalnie złożoną publikację. Gotową do druku, wysyłki lub publikacji online."
          inverted
        />
      </div>

      <div class="pub__grid reveal">
        {pubServices.map((s) => (
          <a href={s.href} class="pub-card">
            <div class="pub-card__inner">
              <h3 class="pub-card__title">{s.title}</h3>
              <p class="pub-card__desc">{s.desc}</p>
              <span class="pub-card__link">Dowiedz się więcej →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WHY US — Differentiators
       ═══════════════════════════════════════ -->
  <section class="why" id="dlaczego-my" aria-labelledby="why-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Agencja content marketingowa,<br>która potrafi więcej"
          centered
        />
      </div>

      <div class="why__grid">
        {diffs.map((d) => (
          <div class="why__card reveal">
            <div class="why__stat">
              <span class="why__stat-num">{d.stat}</span>
              <span class="why__stat-unit">{d.unit}</span>
            </div>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       BLOG placeholder
       ═══════════════════════════════════════ -->
  <section class="blog-preview" id="blog" aria-labelledby="blog-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Blog"
          title="Wiedza o&nbsp;content marketingu"
          subtitle="Artykuły o strategii treści, copywritingu, SEO i profesjonalnych publikacjach. Wkrótce."
        />
      </div>
      <div class="blog-preview__placeholder reveal">
        <p>Blog jest w&nbsp;przygotowaniu. Będziemy pisać o&nbsp;tym, co znamy najlepiej — o&nbsp;treściach, które działają.</p>
        <span class="blog-preview__tag">Wkrótce</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       CTA — Contact
       ═══════════════════════════════════════ -->
  <section class="cta" id="kontakt" aria-labelledby="cta-title">
    <div class="cta__bg" aria-hidden="true"></div>
    <div class="container">
      <div class="cta__inner reveal">
        <h2 id="cta-title" class="cta__title">
          Opowiedz nam o&nbsp;swoim projekcie
        </h2>
        <p class="cta__desc">
          Niezależnie od tego, czy potrzebujesz jednego artykułu, czy kompletnej strategii
          contentowej z&nbsp;ebookiem i&nbsp;landing page — chętnie porozmawiamy.
          Wycena jest bezpłatna i&nbsp;niezobowiązująca.
        </p>
        <div class="cta__actions">
          <a href="/kontakt/" class="cta__button">
            Napisz do nas
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href="mailto:kontakt@ecopywriting.pl" class="cta__email">kontakt@ecopywriting.pl</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SEO CONTENT
       ═══════════════════════════════════════ -->
  <section class="seo" aria-label="Informacje o agencji content marketingowej">
    <div class="container-narrow">
      <article class="seo__article">
        <h2>Agencja content marketingowa eCopywriting — kompleksowa obsługa treści</h2>

        <p>
          <strong>eCopywriting.pl</strong> to <strong>agencja content marketingowa</strong>, która łączy wieloletnie
          doświadczenie w&nbsp;copywritingu z&nbsp;umiejętnościami technologicznymi i&nbsp;profesjonalnym składem tekstu.
          Oferujemy pełen zakres usług <strong>content marketingowych</strong> — od strategii i&nbsp;planowania,
          przez tworzenie i&nbsp;redakcję treści, aż po profesjonalny skład i&nbsp;publikację gotowych materiałów.
        </p>

        <h3>Czym wyróżnia się nasza agencja contentowa?</h3>

        <p>
          Większość agencji content marketingu kończy swoją pracę na dostarczeniu tekstu w&nbsp;dokumencie Google
          Docs lub Word. My idziemy o&nbsp;krok dalej — dostarczamy gotowy produkt. Jeśli potrzebujesz ebooka
          firmowego, katalog produktowy, white paper czy prezentację inwestorską — nie musisz angażować osobnej
          agencji DTP ani software house'u. Nasz zespół realizuje cały proces wewnętrznie:
          od <strong>strategii content marketingowej</strong>, przez profesjonalny <strong>copywriting</strong>
          i&nbsp;redakcję, po skład typograficzny i&nbsp;wdrożenie techniczne.
        </p>

        <h3>Usługi content marketingowe</h3>

        <p>
          Jako <strong>agencja content marketingu</strong> oferujemy: profesjonalny copywriting sprzedażowy
          i&nbsp;wizerunkowy, SEO copywriting i&nbsp;pozycjonowanie treści, prowadzenie blogów firmowych,
          tworzenie strategii contentowych, email marketing i&nbsp;automatyzację newsletterów,
          treści na social media, a&nbsp;także kompleksowe tworzenie publikacji — ebooków, white papers,
          katalogów, materiałów szkoleniowych, prezentacji i&nbsp;dokumentacji technicznej.
        </p>

        <h3>Dla kogo pracujemy?</h3>

        <p>
          Współpracujemy z&nbsp;firmami B2B i&nbsp;B2C, które rozumieją wartość profesjonalnego content
          marketingu. Naszymi klientami są firmy technologiczne, e-commerce, startupy, firmy produkcyjne,
          wydawnictwa i&nbsp;instytucje edukacyjne. Niezależnie od branży — pomagamy budować autorytet
          marki i&nbsp;generować leady poprzez treści najwyższej jakości.
        </p>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  /* ═══════════════════════════════════════
     HERO
     ═══════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-32) 0 var(--space-20);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 80%, rgba(196, 90, 60, 0.06) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 20%, rgba(28, 42, 58, 0.04) 0%, transparent 50%);
  }

  .hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-6);
    opacity: 0;
    animation: fadeUp 0.8s ease 0.2s forwards;
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    font-weight: var(--fw-semibold);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 800px;
    opacity: 0;
    animation: fadeUp 0.9s ease 0.4s forwards;
  }

  .hero__title em {
    font-style: italic;
    color: var(--accent);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: var(--lh-relaxed);
    color: var(--ink-muted);
    max-width: 560px;
    margin-top: var(--space-6);
    opacity: 0;
    animation: fadeUp 0.9s ease 0.6s forwards;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-10);
    opacity: 0;
    animation: fadeUp 0.9s ease 0.8s forwards;
  }

  .hero__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .hero__cta-primary:hover {
    background: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(196, 90, 60, 0.25);
  }

  .hero__cta-primary svg {
    transition: transform var(--transition-fast);
  }

  .hero__cta-primary:hover svg {
    transform: translateX(3px);
  }

  .hero__cta-secondary {
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--ink-muted);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 2px;
    transition: all var(--transition-fast);
  }

  .hero__cta-secondary:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .hero__proof {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule-light);
    opacity: 0;
    animation: fadeUp 0.9s ease 1s forwards;
  }

  .hero__proof-item {
    font-size: var(--fs-sm);
    color: var(--ink-light);
  }

  .hero__proof-item strong {
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }

  .hero__proof-sep {
    width: 1px;
    height: 20px;
    background: var(--rule);
  }

  @media (max-width: 640px) {
    .hero__proof-sep { display: none; }
    .hero__proof { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  }

  .hero__scroll {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
