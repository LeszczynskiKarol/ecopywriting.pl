---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

// Get 3 latest blog posts
const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "@id": "https://www.ecopywriting.pl/#organization",
      "name": "eCopywriting.pl",
      "url": "https://www.ecopywriting.pl",
      "description": "Agencja content marketingowa. Tworzymy treści, składamy publikacje i wdrażamy rozwiązania — od strategii po gotowy produkt w każdym formacie.",
      "email": "kontakt@ecopywriting.pl",
      "areaServed": ["PL"],
      "serviceType": [
        "Content marketing",
        "Copywriting",
        "SEO Copywriting",
        "Tworzenie ebooków",
        "White papers",
        "Skład publikacji",
        "Email marketing",
        "Strategia contentowa"
      ],
      "knowsAbout": [
        "Content marketing", "Copywriting", "SEO", "Email marketing",
        "Ebooki", "Publikacje cyfrowe", "Skład tekstu", "AI content",
        "Strategia contentowa", "Technical writing"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://www.ecopywriting.pl/#website",
      "url": "https://www.ecopywriting.pl",
      "name": "eCopywriting.pl — Agencja Content Marketingowa",
      "publisher": { "@id": "https://www.ecopywriting.pl/#organization" }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/#webpage",
      "url": "https://www.ecopywriting.pl",
      "name": "Agencja Content Marketingowa — eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "about": { "@id": "https://www.ecopywriting.pl/#organization" },
      "description": "Agencja content marketingowa, która łączy copywriting, technologię i profesjonalny skład. Od strategii treści po gotowy ebook, katalog czy landing page."
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.ecopywriting.pl/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ile kosztuje copywriting / content marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ceny zależą od rodzaju i zakresu projektu. Pojedynczy artykuł blogowy to koszt od 400–800 zł, kompleksowa strategia contentowa od 3000 zł, ebook z profesjonalnym składem od 5000 zł. Każdy projekt wyceniamy indywidualnie."
          }
        },
        {
          "@type": "Question",
          "name": "Jak wygląda proces współpracy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Zaczynamy od briefu i analizy potrzeb. Następnie przygotowujemy strategię lub outline treści do akceptacji. Po zatwierdzeniu kierunku piszemy teksty, przeprowadzamy redakcję, a w przypadku publikacji — składamy materiał."
          }
        },
        {
          "@type": "Question",
          "name": "Czy mogę zamówić tylko copywriting, bez składu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Oczywiście. Oferujemy zarówno pełen pakiet (treść + skład), jak i same usługi copywriterskie. Jeśli potrzebujesz tylko tekstów na stronę, artykułów blogowych czy opisów produktów — dostarczymy je w formacie Google Docs lub Word."
          }
        },
        {
          "@type": "Question",
          "name": "Jak długo trwa realizacja projektu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pojedynczy artykuł to zwykle 3–5 dni roboczych. Kompleksowa strategia contentowa 2–3 tygodnie. Ebook z profesjonalnym składem 3–6 tygodni, w zależności od objętości i złożoności."
          }
        },
        {
          "@type": "Question",
          "name": "Czy korzystacie z AI do pisania tekstów?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wykorzystujemy AI jako narzędzie wspierające — do researchu, generowania outline'ów, sprawdzania spójności. Ale każdy tekst jest pisany i redagowany przez doświadczonych copywriterów. Gwarantujemy oryginalność i unikalny styl."
          }
        },
        {
          "@type": "Question",
          "name": "Czy oferujecie stałą współpracę / abonament?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tak, wielu klientów współpracuje z nami w modelu abonamentowym — stała liczba artykułów miesięcznie, prowadzenie bloga, regularne newslettery. Przy stałej współpracy oferujemy preferencyjne stawki i priorytetową realizację."
          }
        }
      ]
    }
  ]
};

// Content services
const contentServices = [
  {
    title: 'Copywriting',
    desc: 'Teksty sprzedażowe, oferty handlowe, slogany i hasła reklamowe, które konwertują.',
    href: '/uslugi/copywriting/'
  },
  {
    title: 'SEO Copywriting',
    desc: 'Artykuły i treści zoptymalizowane pod wyszukiwarki — z researchem fraz i intencji.',
    href: '/uslugi/seo-copywriting/'
  },
  {
    title: 'Artykuły blogowe',
    desc: 'Eksperckie treści budujące autorytet marki i generujące ruch organiczny.',
    href: '/uslugi/artykuly-blogowe/'
  },
  {
    title: 'Teksty na stronę',
    desc: 'Strony firmowe, opisy usług, „O nas" — treści, które budują zaufanie od pierwszego zdania.',
    href: '/uslugi/teksty-na-strone/'
  },
  {
    title: 'Email marketing',
    desc: 'Newslettery, sekwencje powitalne, kampanie sprzedażowe i automatyzacje.',
    href: '/uslugi/email-marketing/'
  },
  {
    title: 'Strategia contentowa',
    desc: 'Audyt treści, kalendarz publikacji, dobór fraz i kanałów — plan, który działa.',
    href: '/uslugi/strategia-content-marketingowa/'
  }
];

// Publication services
const pubServices = [
  {
    title: 'Ebooki',
    desc: 'Ebooki marketingowe, lead magnety i poradniki — piszemy treść i składamy gotową publikację z okładką i layoutem.',
    href: '/uslugi/ebooki/'
  },
  {
    title: 'White papers',
    desc: 'Raporty branżowe, case studies i materiały B2B — research, copywriting i profesjonalny skład dokumentu.',
    href: '/uslugi/white-papers/'
  },
  {
    title: 'Katalogi i broszury',
    desc: 'Katalogi produktowe, foldery i materiały targowe — tekst plus layout, gotowe do druku.',
    href: '/uslugi/katalogi-broszury/'
  },
  {
    title: 'Materiały szkoleniowe',
    desc: 'Podręczniki, skrypty kursów, zeszyty ćwiczeń, materiały onboardingowe — treść i profesjonalny skład.',
    href: '/uslugi/materialy-szkoleniowe/'
  },
  {
    title: 'Prezentacje',
    desc: 'Pitch decki, prezentacje sprzedażowe i konferencyjne — strategiczna narracja i design slajdów.',
    href: '/uslugi/prezentacje/'
  },
  {
    title: 'Dokumentacja techniczna',
    desc: 'Instrukcje, manuele, specyfikacje — technical writing i skład z indeksami i cross-referencjami.',
    href: '/uslugi/dokumentacja-techniczna/'
  }
];

// Pipeline steps
const pipeline = [
  { num: '01', label: 'Strategia', desc: 'Audyt, research fraz, analiza konkurencji, plan treści' },
  { num: '02', label: 'Copywriting', desc: 'Tworzenie treści przez doświadczonych copywriterów' },
  { num: '03', label: 'Redakcja', desc: 'Korekta językowa, fact-checking, optymalizacja SEO' },
  { num: '04', label: 'Skład', desc: 'Profesjonalny layout, typografia, projekt graficzny' },
  { num: '05', label: 'Publikacja', desc: 'Gotowy PDF, ebook, druk lub wdrożenie na stronę' }
];

// Differentiators
const diffs = [
  {
    stat: '15+',
    unit: 'lat',
    title: 'Doświadczenie w content marketingu',
    desc: 'Zaczynaliśmy od copywritingu, zanim content marketing stał się buzzwordem. Ponad 15 lat praktyki w tworzeniu treści, które generują ruch, budują autorytet i konwertują.'
  },
  {
    stat: 'End',
    unit: 'to end',
    title: 'Jeden dostawca zamiast trzech',
    desc: 'Strategia, copywriting, redakcja, skład, wdrożenie — wszystko pod jednym dachem. Nie przekazujemy surowego tekstu w Google Docs. Dostarczamy gotowy produkt.'
  },
  {
    stat: 'Tech',
    unit: '+ human',
    title: 'Technologia, która skaluje jakość',
    desc: 'Własne narzędzia, umiejętności programistyczne i profesjonalny skład tekstu. Łączymy kreatywność i skuteczność marketingową z technologią i estetyką, żeby dostarczać gotowe produkty spełniający najwyższe kryteria — bez kompromisów na jakości.'
  }
];

// Industries
const industries = [
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`,
    title: 'SaaS & Technologia',
    desc: 'Dokumentacja produktowa, blogi techniczne, case studies, white papers dla firm software\'owych i startupów.'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>`,
    title: 'E-commerce',
    desc: 'Opisy produktów, kategorie, poradniki zakupowe, content marketing wspierający sprzedaż online.'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: 'Medycyna & Zdrowie',
    desc: 'Treści medyczne, artykuły zdrowotne, materiały edukacyjne dla klinik, firm farmaceutycznych i wellness.'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
    title: 'Edukacja & Szkolenia',
    desc: 'Materiały kursowe, ebooki edukacyjne, skrypty szkoleniowe, treści dla platform e-learningowych.'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    title: 'B2B & Usługi profesjonalne',
    desc: 'Treści dla firm konsultingowych, kancelarii, agencji — budowanie eksperckiego wizerunku.'
  },
  {
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
    title: 'Produkcja & Przemysł',
    desc: 'Katalogi produktowe, dokumentacja techniczna, materiały targowe, treści B2B dla sektora przemysłowego.'
  }
];

// FAQ items
const faqItems = [
  {
    q: 'Ile kosztuje copywriting / content marketing?',
    a: 'Ceny zależą od rodzaju i zakresu projektu. Pojedynczy artykuł blogowy to koszt od 400–800 zł, kompleksowa strategia contentowa od 3000 zł, ebook z profesjonalnym składem od 5000 zł. Każdy projekt wyceniamy indywidualnie — <a href="/kontakt/">napisz do nas</a> z briefem, a przygotujemy bezpłatną wycenę.'
  },
  {
    q: 'Jak wygląda proces współpracy?',
    a: 'Zaczynamy od briefu i analizy potrzeb. Następnie przygotowujemy strategię lub outline treści do akceptacji. Po zatwierdzeniu kierunku piszemy teksty, przeprowadzamy redakcję, a w przypadku publikacji — składamy materiał. Klient otrzymuje gotowy produkt z możliwością poprawek.'
  },
  {
    q: 'Czy mogę zamówić tylko copywriting, bez składu?',
    a: 'Oczywiście. Oferujemy zarówno pełen pakiet (treść + skład), jak i same usługi copywriterskie. Jeśli potrzebujesz tylko tekstów na stronę, artykułów blogowych czy opisów produktów — dostarczymy je w formacie Google Docs lub Word.'
  },
  {
    q: 'Jak długo trwa realizacja projektu?',
    a: 'Pojedynczy artykuł to zwykle 3–5 dni roboczych. Kompleksowa strategia contentowa 2–3 tygodnie. Ebook z profesjonalnym składem 3–6 tygodni, w zależności od objętości i złożoności. Przy pilnych projektach możemy przyspieszyć — pytaj o opcję express.'
  },
  {
