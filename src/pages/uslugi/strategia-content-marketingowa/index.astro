---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje strategia content marketingowa?',
    a: 'Cena zależy od zakresu i złożoności projektu. Audyt treści z rekomendacjami to 2000–4000 zł. Kompletna strategia contentowa (audyt, research fraz, content plan, kalendarz, style guide) to 4000–10 000 zł. Stała obsługa strategiczna (comiesięczna analiza, aktualizacja planu, koordynacja produkcji) to 2000–5000 zł/miesiąc. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Czym strategia contentowa różni się od content planu?',
    a: 'Content plan to lista tematów do napisania. Strategia contentowa to system — audyt obecnych treści, analiza luk, research fraz z podziałem na intencje, architektura content clusterów, priorytetyzacja tematów, kalendarz publikacji, dystrybucja, KPI i plan mierzenia efektów. Plan mówi CO pisać. Strategia mówi CO, DLACZEGO, DLA KOGO, KIEDY i JAK MIERZYĆ.'
  },
  {
    q: 'Jak długo trwa przygotowanie strategii?',
    a: 'Kompletna strategia content marketingowa wymaga 2–4 tygodni pracy — audyt, research, analiza, planowanie. Przy prostszych projektach (mała strona, jedna branża) możliwe jest 1–2 tygodnie. Nie skracamy tego procesu, bo pośpiech na etapie strategii kosztuje miesiące błędnych publikacji. Lepiej 3 tygodnie strategii niż 6 miesięcy pisania nie tych tekstów.'
  },
  {
    q: 'Czy po strategii zajmujecie się też realizacją?',
    a: 'Tak — i to rekomendujemy. Strategia bez realizacji to dokument na półkę. Oferujemy pełny cykl: strategia → produkcja treści → publikacja → monitoring → optymalizacja. Możemy też przekazać strategię Twojemu zespołowi — ze szczegółowymi wytycznymi, briefami i checklistami, żeby mogli ją realizować samodzielnie.'
  },
  {
    q: 'Dla jakiego typu firm jest strategia contentowa?',
    a: 'Strategia contentowa przynosi najlepsze efekty firmom, które: chcą budować widoczność organiczną w Google, mają budżet na regularną produkcję treści (min. 4 artykuły/miesiąc), działają w branży, gdzie klienci szukają informacji przed zakupem (B2B, SaaS, e-commerce, usługi profesjonalne). Jeśli Twój klient googla przed kontaktem — potrzebujesz strategii.'
  },
  {
    q: 'Czy audytujecie istniejące treści?',
    a: 'Tak — audyt treści to pierwszy krok każdej strategii. Analizujemy wszystkie istniejące treści: pozycje, ruch, konwersje, kanibalizację fraz, thin content, outdated content. Na tej podstawie rekomendujemy: co zostawić, co zaktualizować, co połączyć, co usunąć i co napisać od zera. Często optymalizacja istniejących treści daje szybszy ROI niż pisanie nowych.'
  },
  {
    q: 'Jakich narzędzi używacie do strategii?',
    a: 'Ahrefs i Semrush (research fraz, analiza konkurencji, luki contentowe), Google Search Console i GA4 (dane o obecnym ruchu), Surfer SEO (optymalizacja on-page), własne narzędzia AI (SERP analysis, keyword clustering, content gap analysis). Przy audycie analizujemy setki stron i tysiące fraz — narzędzia pozwalają skalować ten proces.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/#service",
      "name": "Strategia content marketingowa",
      "description": "Profesjonalna strategia content marketingowa — audyt treści, research fraz, content plan, architektura clusterów, kalendarz publikacji, KPI i monitoring. Od analizy po realizację.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Content strategy",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/",
      "name": "Strategia Contentowa — Strategia Content Marketingowa | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalna strategia contentowa. Audyt treści, research fraz, content plan, architektura clusterów, kalendarz publikacji. Od analizy po realizację. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Strategia contentowa", "item": "https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Deliverables ──
const deliverables = [
  {
    title: 'Audyt treści',
    desc: 'Analiza wszystkich istniejących treści na stronie — pozycje, ruch, konwersje, kanibalizacja fraz, thin content, outdated content. Mapowanie content gap — tematy, na które rankuje konkurencja, a Ty nie. Rekomendacje: co zostawić, zaktualizować, połączyć, usunąć.',
    output: 'Raport audytowy + lista rekomendacji',
    icon: '🔍'
  },
  {
    title: 'Research fraz kluczowych',
    desc: 'Kompleksowy research fraz z podziałem na intencje (informacyjna, nawigacyjna, transakcyjna). Analiza wolumenu, trudności, potencjału konwersji. Keyword clustering — grupowanie fraz w tematy i klastry. Identyfikacja quick wins i long-term targets.',
    output: 'Baza fraz z priorytetyzacją',
    icon: '🔑'
  },
  {
    title: 'Architektura content clusterów',
    desc: 'Projektowanie struktury pillar-cluster — artykuły filarowe + supporting content + linkowanie wewnętrzne. Mapa topical authority budująca ekspercki wizerunek w wybranych tematach. Wizualizacja powiązań między treściami.',
    output: 'Mapa clusterów + schemat linkowania',
    icon: '🏗️'
  },
  {
    title: 'Content plan z priorytetyzacją',
    desc: 'Lista tematów z frazami docelowymi, rekomendowanym formatem, intencją, trudnością i priorytetem. Priorytetyzacja na podstawie: potencjału ruchu, trudności pozycjonowania, wartości biznesowej i content gap. Plan, który mówi CO pisać i W JAKIEJ KOLEJNOŚCI.',
    output: 'Spreadsheet z 50–200+ tematami',
    icon: '📋'
  },
  {
    title: 'Kalendarz publikacji',
    desc: 'Harmonogram publikacji na 3–6 miesięcy z podziałem na kanały (blog, social media, newsletter). Kadencja dopasowana do budżetu i zasobów. Kalendarz, który zamienia plan w działanie — z konkretnymi datami, formatami i odpowiedzialnościami.',
    output: 'Kalendarz 3–6 miesięcy',
    icon: '📅'
  },
  {
    title: 'Style guide i wytyczne',
    desc: 'Tone of voice, zasady pisania, struktura artykułów, formatowanie, SEO checklist. Dokument, który pozwala każdemu copywriterowi pisać spójnie z Twoją marką — niezależnie od tego, czy pisze wewnętrzny zespół czy zewnętrzna agencja.',
    output: 'Dokument style guide',
    icon: '📐'
  }
];

// ── Without vs With strategy ──
const contrasts = [
  {
    without: 'Losowe tematy artykułów na podstawie przeczuć',
    with: 'Tematy oparte na researchu fraz i analizie luk contentowych'
  },
  {
    without: 'Brak priorytetów — pisanie w przypadkowej kolejności',
    with: 'Priorytetyzacja na podstawie potencjału ruchu i wartości biznesowej'
  },
  {
    without: 'Artykuły kanibalizujące się nawzajem w Google',
    with: 'Architektura clusterów eliminująca kanibalizację'
  },
  {
    without: 'Brak linkowania wewnętrznego i topical authority',
    with: 'Strategiczne linkowanie budujące autorytet tematyczny'
  },
  {
    without: 'Nie wiadomo, czy treści działają — brak KPI',
    with: 'Mierzalne cele, monitoring pozycji, raportowanie ROI'
  },
  {
    without: 'Treści istnieją, ale nie generują ruchu ani leadów',
    with: 'Każdy tekst ma cel — ruch, lead, konwersja, autorytet'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Discovery i brief',
    desc: 'Poznajemy Twój biznes — usługi, produkty, grupę docelową, konkurencję, cele. Zbieramy dane z GSC, GA4, Ahrefs. Definiujemy zakres strategii i oczekiwane rezultaty. Brief do potwierdzenia — żebyśmy mówili tym samym językiem.'
  },
  {
    num: '02',
    title: 'Audyt i analiza',
    desc: 'Audyt istniejących treści, analiza konkurencji (kto rankuje na Twoje frazy i dlaczego), identyfikacja content gap. Wykorzystujemy Ahrefs, Semrush, GSC i własne narzędzia do przeskanowania setek stron i tysięcy fraz.'
  },
  {
    num: '03',
    title: 'Research i clustering',
    desc: 'Kompleksowy research fraz kluczowych z podziałem na intencje. Keyword clustering — grupowanie fraz w tematy i klastry tematyczne. Identyfikacja pillar topics i supporting content. Priorytetyzacja na podstawie danych.'
  },
  {
    num: '04',
    title: 'Strategia i content plan',
    desc: 'Projektowanie architektury content clusterów, mapowanie linkowania wewnętrznego, definiowanie content planu z priorytetyzacją. Kalendarz publikacji na 3–6 miesięcy. Style guide i wytyczne dla copywriterów. Prezentacja strategii do akceptacji.'
  },
  {
    num: '05',
    title: 'Realizacja i monitoring',
    desc: 'Strategia bez realizacji to dokument na półkę. Przejmujemy produkcję treści lub przekazujemy plan Twojemu zespołowi z briefami i checklistami. Monitorujemy wyniki — pozycje, ruch, konwersje. Kwartalnie aktualizujemy strategię na podstawie danych.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Dane zamiast przeczuć',
    desc: 'Każda decyzja w strategii oparta na danych — wolumeny fraz, trudność pozycjonowania, ruch konkurencji, content gap, potencjał konwersji. Nie zgadujemy, co pisać. Analizujemy, co ma największy potencjał i w jakiej kolejności to realizować.'
  },
  {
    title: 'Topical authority, nie losowe artykuły',
    desc: 'Budujemy klastry tematyczne — pillar content + supporting articles + strategiczne linkowanie. Google nagradza strony, które pokrywają temat kompleksowo. Pojedynczy artykuł ma szanse, klaster tematyczny dominuje.'
  },
  {
    title: 'Od strategii po realizację',
    desc: 'Nie zostawiamy Cię z 50-stronowym PDFem. Przejmujemy realizację strategii — pisanie artykułów, redakcję, optymalizację, publikację. Albo przekazujemy plan z takimi szczegółami, że Twój zespół może go realizować samodzielnie.'
  },
  {
    title: 'Szybsze wyniki przez quick wins',
    desc: 'Pierwszym krokiem w realizacji strategii nie jest pisanie nowych treści — to optymalizacja istniejących. Artykuły na pozycjach 5–20 często wymagają drobnych zmian, żeby wskoczyć do top 3. Quick wins dają efekty w tygodniach, nie miesiącach.'
  }
];

// ── Related ──
const related = [
  { title: 'SEO Copywriting', href: '/uslugi/seo-copywriting/', desc: 'Realizacja strategii — artykuły zoptymalizowane pod SEO' },
  { title: 'Artykuły blogowe', href: '/uslugi/artykuly-blogowe/', desc: 'Eksperckie treści realizujące content plan' },
  { title: 'Teksty na stronę', href: '/uslugi/teksty-na-strone/', desc: 'Treści na strony firmowe i usługowe' },
  { title: 'Social media', href: '/uslugi/social-media/', desc: 'Dystrybucja treści w kanałach społecznościowych' }
];
---

<BaseLayout
  title="Strategia Contentowa — Strategia Content Marketingowa | eCopywriting.pl"
  description="Profesjonalna strategia contentowa. Audyt treści, research fraz, architektura content clusterów, content plan z priorytetyzacją, kalendarz publikacji, KPI. Od analizy po realizację. Wycena w 24h."
  keywords="strategia contentowa, strategia content marketingowa, content plan, plan contentowy, audyt treści, content marketing strategia, content cluster, topical authority, kalendarz publikacji"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/strategia-content-marketingowa/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Strategia contentowa</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Strategia & Analiza</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Strategia contentowa,<br>która <em>daje&nbsp;kierunek</em>
      </h1>
      <p class="srv-hero__subtitle">
        Audyt treści, research fraz, architektura clusterów, content plan
        z&nbsp;priorytetyzacją i&nbsp;kalendarz publikacji. Żebyś wiedział
        CO pisać, DLACZEGO i&nbsp;W&nbsp;JAKIEJ KOLEJNOŚCI — zamiast zgadywać.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#deliverables" class="srv-hero__cta-secondary">Co dostarczamy</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Dane</strong> zamiast przeczuć</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>50–200+</strong> tematów w planie</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Od strategii</strong> po realizację</div>
      </div>
    </div>
  </section>

  <!-- WITHOUT vs WITH -->
  <section class="srv-contrast" aria-labelledby="srv-contrast-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego strategia"
          title="Content marketing bez strategii vs&nbsp;ze&nbsp;strategią"
          subtitle="Większość firm publikuje treści bez planu — losowe tematy, brak priorytetów, zero mierzenia. Oto różnica, którą robi strategia contentowa."
        />
      </div>

      <div class="srv-contrast__table reveal">
        <div class="srv-contrast__header">
          <span class="srv-contrast__header-label srv-contrast__header-label--without">Bez strategii</span>
          <span class="srv-contrast__header-label srv-contrast__header-label--with">Ze strategią</span>
        </div>
        {contrasts.map((c) => (
          <div class="srv-contrast__row">
            <div class="srv-contrast__cell srv-contrast__cell--without">
              <span class="srv-contrast__marker srv-contrast__marker--without" aria-hidden="true">✕</span>
              <p>{c.without}</p>
            </div>
            <div class="srv-contrast__cell srv-contrast__cell--with">
              <span class="srv-contrast__marker srv-contrast__marker--with" aria-hidden="true">✓</span>
              <p>{c.with}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="srv-deliverables" id="deliverables" aria-labelledby="srv-deliverables-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co dostarczamy"
          title="Elementy strategii contentowej"
          subtitle="Strategia content marketingowa to nie &bdquo;dokument z rekomendacjami&rdquo;. To komplet narzędzi, które pozwalają podejmować decyzje i&nbsp;działać."
        />
      </div>

      <div class="srv-deliverables__grid">
        {deliverables.map((d, i) => (
          <div class="srv-deliverables__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-deliverables__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-deliverables__card-output">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              {d.output}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLUSTER EXPLAINER -->
  <section class="srv-cluster" id="klastry" aria-labelledby="srv-cluster-title">
    <div class="container">
      <div class="srv-cluster__inner reveal">
        <span class="srv-cluster__label">Kluczowa koncepcja</span>
        <h2 id="srv-cluster-title" class="srv-cluster__title">
          Content clusters —<br><em>topical authority w&nbsp;praktyce</em>
        </h2>
        <p class="srv-cluster__desc">
          Google nie rankuje pojedynczych artykułów — rankuje strony, które pokrywają temat
          kompleksowo. Content cluster to struktura: jeden artykuł filarowy (pillar) otoczony
          artykułami wspierającymi (supporting), połączony strategicznym linkowaniem wewnętrznym.
        </p>

        <div class="srv-cluster__visual" aria-label="Schemat content clustera">
          <div class="srv-cluster__pillar">
            <span class="srv-cluster__pillar-label">Pillar</span>
            <span class="srv-cluster__pillar-title">Ultimate Guide:<br>Email Marketing</span>
          </div>
          <div class="srv-cluster__spokes" aria-hidden="true">
            <span class="srv-cluster__spoke"></span>
            <span class="srv-cluster__spoke"></span>
            <span class="srv-cluster__spoke"></span>
            <span class="srv-cluster__spoke"></span>
            <span class="srv-cluster__spoke"></span>
          </div>
          <div class="srv-cluster__supports">
            <span class="srv-cluster__support">Jak zbudować listę mailingową</span>
            <span class="srv-cluster__support">Sekwencje powitalne — guide</span>
            <span class="srv-cluster__support">A/B testy w email marketingu</span>
            <span class="srv-cluster__support">Porzucone koszyki — automatyzacja</span>
            <span class="srv-cluster__support">Email marketing KPI — co mierzyć</span>
          </div>
        </div>

        <p class="srv-cluster__benefit">
          Efekt: Google widzi, że Twoja strona jest ekspertem od email marketingu —
          i nagradza ją wyższymi pozycjami na WSZYSTKIE powiązane frazy. Pojedynczy
          artykuł walczy sam. Klaster dominuje niszę.
        </p>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od discovery po realizację strategii"
          subtitle="Nasz proces łączy analitykę z&nbsp;pragmatyzmem. Strategia to nie 50-stronowy PDF, który ląduje na&nbsp;półce — to żywy dokument z&nbsp;konkretnymi priorytetami i&nbsp;planem działania."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Strategia, która się realizuje"
          subtitle="Największy problem ze strategiami contentowymi? Nikt ich nie realizuje. Nasze podejście rozwiązuje ten problem — od pierwszego dnia."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="srv-tools" aria-label="Narzędzia strategii contentowej">
    <div class="container">
      <div class="srv-tools__inner reveal">
        <span class="srv-tools__label">Narzędzia</span>
        <h2 class="srv-tools__title">Strategia oparta na profesjonalnych narzędziach</h2>
        <p class="srv-tools__desc">
          Nie pracujemy na przeczuciach. Każda rekomendacja oparta jest na danych
          z&nbsp;profesjonalnych narzędzi SEO i content marketingu.
        </p>
        <div class="srv-tools__list">
