---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje prowadzenie social media?',
    a: 'Cena zależy od liczby kanałów, częstotliwości publikacji i zakresu obsługi. Podstawowy pakiet (1 kanał, 8–12 postów/miesiąc, grafiki + copy) to 1500–3000 zł/miesiąc. Pakiet rozszerzony (2–3 kanały, 16–24 posty, strategia + raportowanie) to 3000–6000 zł/miesiąc. Kompleksowa obsługa z moderacją i kampaniami płatnymi wyceniamy indywidualnie. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Na jakich platformach pracujecie?',
    a: 'Specjalizujemy się w platformach, gdzie content marketing przynosi najlepsze efekty: LinkedIn (B2B, personal branding, employer branding), Instagram (wizualne marki, e-commerce, lifestyle), Facebook (community, lokalne biznesy, kampanie), X/Twitter (thought leadership, real-time marketing). Wspieramy też TikTok i YouTube w zakresie skryptów i copywritingu.'
  },
  {
    q: 'Czy zajmujecie się tylko pisaniem postów, czy też strategią?',
    a: 'Jedno i drugie. Możemy napisać posty na zadany temat, ale najlepsze efekty daje współpraca strategiczna — audyt obecnych kanałów, analiza grupy docelowej, content plan z filiarami tematycznymi, kalendarz publikacji i systematyczna obsługa z raportowaniem. Strategia zamienia losowe publikacje w spójną komunikację z mierzalnymi efektami.'
  },
  {
    q: 'Czy tworzycie też grafiki i kreacje wizualne?',
    a: 'Tak — dostarczamy kompletne posty: copy + grafika/kreacja. Projektujemy szablony graficzne w identyfikacji wizualnej Twojej marki, które zapewniają spójność i przyspieszają produkcję. Przy bardziej zaawansowanych projektach (reelsy, animacje, video) współpracujemy z grafikami i motion designerami.'
  },
  {
    q: 'Jak mierzycie efektywność social media?',
    a: 'Śledzimy metryki dopasowane do celów: zasięg i impressions (awareness), engagement rate (zaangażowanie), kliknięcia i ruch na stronie (traffic), leady i konwersje (sprzedaż), wzrost followerów (community). Raportujemy co miesiąc z konkretnymi wnioskami i rekomendacjami — nie „ładnym PDFem z wykresami".'
  },
  {
    q: 'Czy obsługujecie kampanie płatne (Meta Ads, LinkedIn Ads)?',
    a: 'Obsługujemy kampanie płatne w zakresie kreacji — copy reklamowe, grafiki, warianty A/B. Możemy też doradzić w strategii targetowania i budżetowania. Nie prowadzimy jednak kompleksowego performance marketingu (zarządzanie budżetem, bidding, retargeting) — to domena agencji performance. Chętnie współpracujemy z Twoją agencją performance, dostarczając kreacje.'
  },
  {
    q: 'Ile postów miesięcznie powinno wychodzić?',
    a: 'Zależy od platformy i celów. LinkedIn: 3–5 postów tygodniowo dla najlepszych efektów. Instagram: 3–5 feedów + 5–10 stories tygodniowo. Facebook: 3–4 posty tygodniowo. Ważniejsza od ilości jest jakość i regularność. Lepiej 3 wartościowe posty tygodniowo niż codzienny spam bez wartości. Pomagamy ustalić optymalną kadencję.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/social-media/#service",
      "name": "Social media",
      "description": "Profesjonalne prowadzenie social media — strategia, copywriting, kreacje graficzne, kalendarz publikacji i raportowanie. LinkedIn, Instagram, Facebook, X/Twitter.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Social media management",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/social-media/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/social-media/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/social-media/",
      "name": "Social Media — Prowadzenie i Obsługa Kanałów Social Media | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne prowadzenie social media. Strategia, copywriting, kreacje, kalendarz publikacji. LinkedIn, Instagram, Facebook. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/social-media/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/social-media/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Social media", "item": "https://www.ecopywriting.pl/uslugi/social-media/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Platforms ──
const platforms = [
  {
    name: 'LinkedIn',
    desc: 'Platforma #1 dla B2B, personal branding i employer branding. Posty eksperckie, artykuły, karuzele, dokumenty. Organiczny zasięg wciąż żyje — dobrze napisany post na LinkedIn może dotrzeć do tysięcy decydentów bez złotówki na reklamy.',
    best: 'B2B, SaaS, usługi, rekrutacja, thought leadership',
    formats: 'Posty tekstowe, karuzele, artykuły, newslettery LinkedIn',
    icon: '💼'
  },
  {
    name: 'Instagram',
    desc: 'Wizualna platforma dla marek lifestyle, e-commerce, HoReCa, beauty i fashion. Feed buduje wizerunek, Stories budują relację, Reels budują zasięg. Kluczem jest spójność wizualna i wartościowe podpisy — nie same zdjęcia.',
    best: 'E-commerce, lifestyle, beauty, HoReCa, design',
    formats: 'Posty, karuzele, Stories, Reels, captions',
    icon: '📸'
  },
  {
    name: 'Facebook',
    desc: 'Wciąż największa platforma w Polsce — 26 mln użytkowników. Najlepsza do budowania community (grupy), komunikacji lokalnych biznesów i eventów. Organiczny zasięg jest niski, ale strategiczna kombinacja contentu i kampanii płatnych wciąż daje wyniki.',
    best: 'Lokalne biznesy, eventy, community, grupy',
    formats: 'Posty, wydarzenia, grupy, live, stories',
    icon: '👥'
  },
  {
    name: 'X / Twitter',
    desc: 'Platforma real-time — thought leadership, komentarze branżowe, szybka komunikacja. Idealna dla CEO, ekspertów, firm technologicznych. Krótka forma wymaga precyzyjnego copywritingu — każde słowo musi pracować.',
    best: 'Tech, SaaS, personal branding, real-time marketing',
    formats: 'Tweety, wątki (threads), cytaty, ankiety',
    icon: '𝕏'
  }
];

// ── Content pillars ──
const pillars = [
  {
    title: 'Treści edukacyjne',
    desc: 'How-to, porady, tipy, wyjaśnienia. Treści, które rozwiązują problemy Twojej grupy docelowej i budują pozycję eksperta. Najwyższy potencjał zapisu i udostępnienia.',
    pct: '40%'
  },
  {
    title: 'Treści wizerunkowe',
    desc: 'Behind the scenes, zespół, kultura firmy, wartości. Treści, które humanizują markę i budują zaufanie. Ludzie kupują od ludzi — pokaż, kto stoi za firmą.',
    pct: '20%'
  },
  {
    title: 'Treści sprzedażowe',
    desc: 'Case studies, rezultaty, oferty, social proof. Treści, które prowadzą do konwersji — ale nie więcej niż 20% całości. Za dużo sprzedaży = unfollow.',
    pct: '20%'
  },
  {
    title: 'Treści angażujące',
    desc: 'Pytania, ankiety, kontrowersyjne tezy, memy branżowe. Treści generujące komentarze i dyskusje. Algorytm nagradza zaangażowanie — a engagement buduje zasięg.',
    pct: '20%'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Audyt i strategia',
    desc: 'Analizujemy obecne kanały, konkurencję, grupę docelową i tone of voice. Definiujemy cele, KPI, filary tematyczne i platformy docelowe. Strategia do akceptacji przed startem — z jasnym planem, czego się spodziewać.'
  },
  {
    num: '02',
    title: 'Identyfikacja i szablony',
    desc: 'Projektujemy system wizualny dla social media — szablony graficzne, paleta kolorów, typografia, styl zdjęć. Spójność wizualna to podstawa rozpoznawalności. Szablony przyspieszają produkcję i zapewniają jakość na skali.'
  },
  {
    num: '03',
    title: 'Kalendarz i produkcja',
    desc: 'Tworzymy miesięczny kalendarz publikacji — tematy, formaty, daty. Piszemy copy, projektujemy grafiki, przygotowujemy warianty. Wszystko do akceptacji w arkuszu lub narzędziu (Notion, Trello, Asana) z wyprzedzeniem 1–2 tygodni.'
  },
  {
    num: '04',
    title: 'Publikacja i moderacja',
    desc: 'Publikujemy posty w optymalnych godzinach. Monitorujemy komentarze, odpowiadamy w imieniu marki (w ramach ustalonych reguł), reagujemy na wzmianki. Moderacja buduje community — ignorowanie komentarzy je niszczy.'
  },
  {
    num: '05',
    title: 'Analiza i optymalizacja',
    desc: 'Raportujemy wyniki co miesiąc — metryki, wnioski, rekomendacje. Analizujemy, co działa (i dlaczego), co nie działa (i co zmienić). Optymalizujemy strategię na podstawie danych, nie przeczuć. Iteracja to klucz do wzrostu.'
  }
];

// ── Differentiators ──
const diffs = [
  {
    title: 'Copywriting, nie lorem ipsum',
    desc: 'Jesteśmy agencją copywriterską — pisanie to nasze DNA. Każdy post jest napisany z taką samą uwagą jak tekst na stronę czy oferta handlowa. Precyzyjny hook, wartościowa treść, jasne CTA. Nie lorem ipsum z ładną grafiką.'
  },
  {
    title: 'Strategia zamiast losowych postów',
    desc: 'Nie publikujemy „bo trzeba coś wrzucić". Każdy post ma swoje miejsce w strategii — realizuje cel, trafia w filar tematyczny, buduje spójną narrację. Kalendarz zamiast improwizacji, system zamiast chaosu.'
  },
  {
    title: 'Content repurposing — jeden temat, wiele formatów',
    desc: 'Artykuł blogowy zamienia się w 5 postów na LinkedIn, karuzelę na Instagramie i thread na X. Ebook staje się serią postów edukacyjnych. Maksymalizujemy zwrot z każdego contentu, zamiast za każdym razem zaczynać od zera.'
  },
  {
    title: 'Dane, nie przeczucia',
    desc: 'Każda decyzja oparta na danych — od wyboru godzin publikacji, przez formaty, po filary tematyczne. Testujemy, mierzymy, optymalizujemy. Miesięczne raporty z konkretnymi rekomendacjami, nie „ładne PDFy z wykresami".'
  }
];

// ── Related ──
const related = [
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe, slogany i hasła reklamowe' },
  { title: 'Artykuły blogowe', href: '/uslugi/artykuly-blogowe/', desc: 'Eksperckie treści do repurposingu w social media' },
  { title: 'Email marketing', href: '/uslugi/email-marketing/', desc: 'Dystrybucja treści w newsletterach i sekwencjach' },
  { title: 'Strategia contentowa', href: '/uslugi/strategia-content-marketingowa/', desc: 'Spójna strategia obejmująca blog, social i email' }
];
---

<BaseLayout
  title="Social Media — Prowadzenie i Obsługa Kanałów Social Media | eCopywriting.pl"
  description="Profesjonalne prowadzenie social media. Strategia, copywriting, kreacje graficzne, kalendarz publikacji i raportowanie wyników. LinkedIn, Instagram, Facebook, X/Twitter. Wycena w 24h."
  keywords="social media, prowadzenie social media, obsługa social media, treści social media, posty social media, social media marketing, social media agencja, prowadzenie profili social media, copywriting social media"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/social-media/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Social media</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Social Media & Content</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Social media, które<br><em>buduje markę i&nbsp;sprzedaje</em>
      </h1>
      <p class="srv-hero__subtitle">
        Profesjonalne prowadzenie social media — strategia, copywriting, kreacje
        i&nbsp;publikacja. Treści, które angażują, budują community i&nbsp;przekładają się
        na&nbsp;realne wyniki biznesowe. Nie „ładne posty" — mierzalny marketing.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#platformy" class="srv-hero__cta-secondary">Platformy i formaty</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Strategia</strong> + copy + grafika</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Kalendarz</strong> z wyprzedzeniem</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Raport</strong> z wnioskami co miesiąc</div>
      </div>
    </div>
  </section>

  <!-- PLATFORMS -->
  <section class="srv-platforms" id="platformy" aria-labelledby="srv-platforms-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Platformy"
          title="Gdzie prowadzmy social media?"
          subtitle="Nie musisz być wszędzie. Dobieramy platformy do Twojej grupy docelowej i&nbsp;celów biznesowych — zamiast rozpraszać budżet na 5 kanałów, skupiamy się na 1–2, które dają najlepszy zwrot."
        />
      </div>
      <div class="srv-platforms__grid">
        {platforms.map((p, i) => (
          <div class="srv-platforms__card reveal" style={`--delay: ${i * 0.06}s`}>
            <div class="srv-platforms__card-head">
              <span class="srv-platforms__card-icon" aria-hidden="true">{p.icon}</span>
              <h3>{p.name}</h3>
            </div>
            <p class="srv-platforms__card-desc">{p.desc}</p>
            <div class="srv-platforms__card-meta">
              <div class="srv-platforms__card-row">
                <span class="srv-platforms__card-label">Najlepsze dla:</span>
                <span>{p.best}</span>
              </div>
              <div class="srv-platforms__card-row">
                <span class="srv-platforms__card-label">Formaty:</span>
                <span>{p.formats}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTENT PILLARS -->
  <section class="srv-pillars" id="filary" aria-labelledby="srv-pillars-title">
    <div class="container">
      <div class="srv-pillars__inner reveal">
        <span class="srv-pillars__label">Nasze podejście</span>
        <h2 id="srv-pillars-title" class="srv-pillars__title">
          Filary tematyczne —<br><em>system zamiast chaosu</em>
        </h2>
        <p class="srv-pillars__desc">
          Każda strategia social media opiera się na filarach tematycznych — kategoriach treści
          z jasnym podziałem procentowym. To zamienia „co dziś wrzucić?" w przewidywalny system,
          który buduje markę i&nbsp;generuje wyniki.
        </p>
        <div class="srv-pillars__grid">
          {pillars.map((pil) => (
            <div class="srv-pillars__card">
              <div class="srv-pillars__card-header">
                <span class="srv-pillars__card-pct">{pil.pct}</span>
                <h3>{pil.title}</h3>
              </div>
              <p>{pil.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od strategii po miesięczny raport"
          subtitle="Przejrzysty proces, w&nbsp;którym wiesz, co się dzieje na każdym etapie. Kalendarz do akceptacji z&nbsp;wyprzedzeniem, posty gotowe do publikacji, raport z&nbsp;wnioskami co&nbsp;miesiąc."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REPURPOSING -->
  <section class="srv-repurpose" id="repurposing" aria-labelledby="srv-repurpose-title">
    <div class="container">
      <div class="srv-repurpose__inner reveal">
        <span class="srv-repurpose__label">Efektywność</span>
        <h2 id="srv-repurpose-title" class="srv-repurpose__title">
          Jeden content,<br><em>dziesięć formatów</em>
        </h2>
        <p class="srv-repurpose__desc">
          Nie tworzymy każdego postu od zera. Strategicznie przetwarzamy treści
          między kanałami — artykuł blogowy, ebook, webinar czy case study staje
          się dziesiątkami postów social media. Więcej contentu, mniej wysiłku, niższy koszt.
        </p>
        <div class="srv-repurpose__flow" aria-label="Schemat content repurposingu">
          <div class="srv-repurpose__source">
            <span class="srv-repurpose__source-label">Źródło</span>
            <div class="srv-repurpose__source-item">Artykuł blogowy</div>
          </div>
          <div class="srv-repurpose__arrow" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="srv-repurpose__outputs">
            <span class="srv-repurpose__output">5× post LinkedIn</span>
            <span class="srv-repurpose__output">3× karuzela Instagram</span>
            <span class="srv-repurpose__output">1× thread X/Twitter</span>
            <span class="srv-repurpose__output">2× story Instagram</span>
            <span class="srv-repurpose__output">1× newsletter snippet</span>
            <span class="srv-repurpose__output">1× infografika</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Social media prowadzone przez copywriterów"
          subtitle="Na rynku nie brakuje &bdquo;agencji social media&rdquo;. Oto dlaczego warto powierzyć social media agencji, której DNA to copywriting i&nbsp;content marketing."
        />
      </div>
      <div class="srv-benefits__grid">
        {diffs.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading label="FAQ" title="Najczęściej zadawane pytania" subtitle="Odpowiedzi na pytania o&nbsp;prowadzeniu social media, które słyszymy najczęściej." />
      </div>
      <div class="srv-faq__list">
        {faqs.map((faq, i) => (
          <details class="srv-faq__item reveal" style={`--delay: ${i * 0.04}s`}>
            <summary class="srv-faq__question">
              <span>{faq.q}</span>
              <svg class="srv-faq__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="srv-faq__answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="srv-related" id="powiazane">
    <div class="container">
      <div class="reveal"><SectionHeading label="Powiązane usługi" title="Może Cię zainteresować" /></div>
      <div class="srv-related__grid reveal">
        {related.map((r) => (
          <a href={r.href} class="srv-related__card">
            <h3>{r.title}</h3><p>{r.desc}</p><span class="srv-related__arrow">→</span>
          </a>
        ))}
      </div>
