---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje opis produktu?',
    a: 'Cena zależy od długości, złożoności produktu i zakresu researchu. Krótki opis produktu (150–300 słów) to 50–120 zł, rozbudowany opis z benefitami i specyfikacją (300–600 słów) to 120–250 zł. Opisy kategorii to 300–800 zł za kategorię. Przy dużych wolumenach (50+ opisów) oferujemy stawki pakietowe — nawet o 30–40% niższe. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Ile opisów produktów możecie dostarczyć miesięcznie?',
    a: 'Nasze procesy i narzędzia pozwalają skalować od kilku do kilkuset opisów miesięcznie. Przy małych wolumenach (10–30) pracujemy w pełni manualnie. Przy większych (50–500+) wykorzystujemy własne narzędzia AI do przyspieszenia researchu i draftu, a doświadczony copywriter redaguje i finalizuje każdy tekst. To daje szybkość maszyny i jakość człowieka.'
  },
  {
    q: 'Czy opisy będą unikalne, nie skopiowane od producenta?',
    a: 'Tak — każdy opis jest pisany od zera. Kopiowanie opisów producenta to jeden z najczęstszych błędów SEO w e-commerce — Google traktuje to jako duplicate content i obniża pozycje. Nasze opisy są w 100% unikalne, pisane językiem korzyści i zoptymalizowane pod frazy, których szukają Twoi klienci.'
  },
  {
    q: 'Czy piszecie opisy w konkretnych branżach?',
    a: 'Mamy doświadczenie w ponad 20 kategoriach e-commerce — od elektroniki, mody i kosmetyków, przez meble, narzędzia i części samochodowe, po żywność, suplementy i produkty medyczne. Przy specjalistycznych branżach przeprowadzamy pogłębiony research i w razie potrzeby konsultujemy się z ekspertami.'
  },
  {
    q: 'Czy wgrywacie opisy bezpośrednio do sklepu?',
    a: 'Tak — nasz zespół programistów może wdrożyć opisy bezpośrednio w Twoim CMS (WooCommerce, Shopify, PrestaShop, Magento, BaseLinker i inne). Przy dużych wolumenach przygotowujemy import CSV/XML dopasowany do struktury Twojego systemu. To oszczędza dziesiątki godzin ręcznego wklejania.'
  },
  {
    q: 'Czy opisy są zoptymalizowane pod SEO?',
    a: 'Tak — każdy opis produktu zawiera research fraz kluczowych, naturalnie wplecione frazy transakcyjne i informacyjne, zoptymalizowane nagłówki i meta tagi. Opisy kategorii dodatkowo zawierają strategiczne linkowanie wewnętrzne i strukturę budującą topical authority w obrębie sklepu.'
  },
  {
    q: 'Czy mogę zamówić opisy próbne?',
    a: 'Tak. Dla nowych klientów przygotowujemy 2–3 opisy próbne, które pozwalają ocenić styl, głębokość i dopasowanie do tonu Twojej marki. Na tej podstawie decydujesz o dalszej współpracy — bez zobowiązań.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/opisy-produktow/#service",
      "name": "Opisy produktów",
      "description": "Profesjonalne opisy produktów i kategorii dla sklepów internetowych. Unikalne treści zoptymalizowane pod SEO i konwersję. Skalowalne procesy — od 10 do 500+ opisów miesięcznie.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Product description writing",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/opisy-produktow/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/opisy-produktow/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/opisy-produktow/",
      "name": "Opisy Produktów — Profesjonalne Opisy dla Sklepów Internetowych | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne opisy produktów i kategorii dla e-commerce. Unikalne treści SEO, skalowalne procesy, wdrożenie w CMS. Od 10 do 500+ opisów miesięcznie. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/opisy-produktow/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/opisy-produktow/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Opisy produktów", "item": "https://www.ecopywriting.pl/uslugi/opisy-produktow/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Description types ──
const descTypes = [
  {
    title: 'Opisy produktów',
    desc: 'Unikalne opisy produktów pisane językiem korzyści, nie specyfikacji. Przekształcamy suche parametry w argumenty zakupowe — „bateria 5000 mAh" staje się „dwa dni bez ładowania". Zoptymalizowane pod frazy transakcyjne i long-tail keywords.',
    scale: '10–500+ opisów / miesiąc',
    icon: '📦'
  },
  {
    title: 'Opisy kategorii',
    desc: 'Strategiczne teksty na stronach kategorii — filary SEO w e-commerce. Opis kategorii odpowiada na pytanie „co tu znajdę i dlaczego warto kupić tutaj". Budują topical authority, wspierają linkowanie wewnętrzne i pozycjonowanie na frazy ogólne.',
    scale: 'Kategorie + podkategorie',
    icon: '🗂️'
  },
  {
    title: 'Opisy wariantów i zestawów',
    desc: 'Unikalne opisy dla wariantów kolorystycznych, rozmiarowych, smakowych. Zestawy i bundled products z opisem wartości pakietu. Eliminujemy duplicate content, który powstaje, gdy warianty mają identyczny opis z różnicą w jednym słowie.',
    scale: 'Deduplikacja treści',
    icon: '🔀'
  },
  {
    title: 'Opisy techniczne i specyfikacje',
    desc: 'Dla produktów wymagających precyzji technicznej — elektronika, narzędzia, części, materiały budowlane. Łączymy dokładne parametry z przystępnym językiem. Tabele specyfikacji, porównania, kompatybilność — wszystko w formacie czytelnym dla klienta i Google.',
    scale: 'Branże techniczne',
    icon: '⚙️'
  },
  {
    title: 'Opisy krótkie / karty produktowe',
    desc: 'Zwięzłe opisy (50–150 słów) na potrzeby marketplace\'ów (Allegro, Amazon, Ceneo), porównywarek cenowych i reklam produktowych. Komunikacja wartości w minimalnej liczbie słów — nagłówek, 2–3 key benefits, CTA.',
    scale: 'Marketplace & porównywarki',
    icon: '📋'
  },
  {
    title: 'Opisy premium / lifestyle',
    desc: 'Opisy produktów premium z elementami storytellingu — moda, kosmetyki, design, żywność rzemieślnicza, alkohole. Budujemy narrację wokół produktu: pochodzenie, rzemiosło, doświadczenie użytkowania. Tekst, który sprzedaje aspirację, nie tylko przedmiot.',
    scale: 'Marki premium & lifestyle',
    icon: '✨'
  }
];

// ── Problems ──
const ecomProblems = [
  {
    problem: 'Duplicate content — opisy skopiowane od producenta',
    result: 'Google obniża pozycje stron z powielanymi treściami. Twoje produkty przegrywają z konkurencją, która ma unikalne opisy.',
    fix: 'Każdy opis pisany od zera — 100% unikatowa treść'
  },
  {
    problem: 'Opis to lista specyfikacji bez kontekstu',
    result: 'Klient nie rozumie, dlaczego ten produkt jest lepszy. Porównuje wyłącznie cenę — i wybiera tańszą opcję u konkurencji.',
    fix: 'Język korzyści: parametry → argumenty zakupowe'
  },
  {
    problem: 'Brak opisów kategorii',
    result: 'Strony kategorii nie rankują na frazy ogólne. Trafiasz jedynie z długich fraz produktowych — tracisz ruch na szczycie lejka.',
    fix: 'Opisy kategorii budujące topical authority'
  },
  {
    problem: 'Niespójny ton i format opisów',
    result: 'Każdy opis wygląda inaczej — pisany przez inną osobę, w innym stylu, z różną głębokością. Brak profesjonalnego wrażenia.',
    fix: 'Style guide + spójna redakcja na każdym opisie'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Audyt i style guide',
    desc: 'Analizujemy obecne opisy, konkurencję i grupę docelową. Tworzymy style guide — ton, struktura, długość, kluczowe elementy każdego opisu. Szablon do akceptacji przed startem masowej produkcji.'
  },
  {
    num: '02',
    title: 'Research fraz i priorytetyzacja',
    desc: 'Research fraz kluczowych dla produktów i kategorii. Priorytetyzujemy — najpierw produkty z najwyższym potencjałem sprzedażowym lub SEO. Własne narzędzia SERP i clustering pomagają skalować research na setki produktów.'
  },
  {
    num: '03',
    title: 'Pisanie opisów',
    desc: 'Opisy pisane przez copywriterów według zatwierdzonego style guide\'u. AI wspiera research produktu, drafting i kontrolę spójności. Finalny tekst to zawsze praca człowieka — zweryfikowana merytorycznie i stylistycznie.'
  },
  {
    num: '04',
    title: 'Redakcja i QA',
    desc: 'Każdy opis przechodzi kontrolę jakości — unikatowość (Copyscape), zgodność ze style guide\'em, poprawność fraz kluczowych, korekta językowa. Przy dużych wolumenach stosujemy warstwowy system QA z losowymi audytami.'
  },
  {
    num: '05',
    title: 'Dostawa i wdrożenie',
    desc: 'Dostarczamy opisy w ustalonym formacie — Google Docs, CSV, XML lub bezpośredni import do CMS (WooCommerce, Shopify, PrestaShop, Magento, BaseLinker). Nasi programiści przygotują feed dopasowany do Twojego systemu.'
  }
];

// ── Scale advantage ──
const scalePoints = [
  {
    title: 'Własne narzędzia AI',
    desc: 'Nasze narzędzia przyspieszają research produktu, generują drafty i kontrolują spójność na setkach opisów. AI robi 70% pracy — copywriter finalizuje 100% jakości.'
  },
  {
    title: 'Style guide = jakość na skali',
    desc: 'Przed startem definiujemy szablon opisu: struktura, ton, długość, elementy obowiązkowe. Każdy nowy copywriter pisze według tych samych reguł — wynik jest spójny niezależnie od wolumenu.'
  },
  {
    title: 'Import do CMS',
    desc: 'Nie zostawiamy Cię z arkuszem Excel. Nasi programiści przygotują feed CSV/XML dopasowany do Twojego sklepu lub wdrożą opisy bezpośrednio w CMS. Setki opisów na stronę w godziny, nie tygodnie.'
  },
  {
    title: 'Warstwowy QA',
    desc: 'Przy dużych wolumenach stosujemy system kontroli jakości: automatyczna weryfikacja unikatowości, zgodność ze style guide\'em, losowe audyty edytorskie. Jakość nie spada przy skali 50, 200 czy 500 opisów.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Język korzyści, nie specyfikacji',
    desc: 'Przekształcamy parametry techniczne w argumenty zakupowe. „Materiał: poliester 600D" staje się „Wodoodporny materiał, który wytrzyma deszcz i brud — nie musisz się o niego martwić". Klient kupuje rozwiązanie problemu, nie specyfikację.'
  },
  {
    title: 'SEO w każdym opisie',
    desc: 'Research fraz kluczowych dla każdego produktu i kategorii. Naturalne wplatanie fraz transakcyjnych i long-tail keywords. Zoptymalizowane nagłówki, meta tagi, alt-tagi obrazów. Opisy, które rankują — nie tylko dobrze wyglądają.'
  },
  {
    title: 'Skalowalne od 10 do 500+',
    desc: 'Nasze procesy, narzędzia i style guide pozwalają skalować produkcję opisów bez utraty jakości. Potrzebujesz 20 opisów na start? Albo 500 na migrację sklepu? Dostarczamy w ustalonym harmonogramie z tą samą jakością.'
  },
  {
    title: 'Zero duplicate content',
    desc: 'Każdy opis pisany od zera — żadnego kopiowania od producenta, żadnego powielania między wariantami. Własne narzędzia do weryfikacji unikatowości (Copyscape + wewnętrzny checker) gwarantują 100% oryginalności.'
  }
];

// ── Related ──
const related = [
  { title: 'SEO Copywriting', href: '/uslugi/seo-copywriting/', desc: 'Zaawansowana optymalizacja treści z researchem fraz i wdrożeniem' },
  { title: 'Teksty na stronę', href: '/uslugi/teksty-na-strone/', desc: 'Kompletne treści na strony firmowe — od hero po FAQ' },
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe, oferty handlowe, slogany reklamowe' },
  { title: 'Strategia contentowa', href: '/uslugi/strategia-content-marketingowa/', desc: 'Audyt treści, plan publikacji, dobór fraz i kanałów' }
];
---

<BaseLayout
  title="Opisy Produktów — Profesjonalne Opisy dla Sklepów Internetowych | eCopywriting.pl"
  description="Profesjonalne opisy produktów i kategorii dla e-commerce. Unikalne treści zoptymalizowane pod SEO i konwersję. Skalowalne procesy — od 10 do 500+ opisów miesięcznie. Wdrożenie w CMS. Wycena w 24h."
  keywords="opisy produktów, opisy produktów sklep internetowy, tworzenie opisów produktów, pisanie opisów produktów, opisy kategorii, opisy e-commerce, copywriting e-commerce, unikalne opisy produktów"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/opisy-produktow/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Opisy produktów</li>
      </ol>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════
       HERO
       ═══════════════════════════════════════ -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true">
      <div class="srv-hero__grain"></div>
      <div class="srv-hero__gradient"></div>
    </div>

    <div class="container srv-hero__inner">
      <div class="srv-hero__badge">
        <span class="srv-hero__badge-dot"></span>
        E-commerce & Copywriting
      </div>

      <h1 id="srv-hero-title" class="srv-hero__title">
        Opisy produktów, które<br>
        <em>sprzedają i&nbsp;rankują</em>
      </h1>

      <p class="srv-hero__subtitle">
        Profesjonalne opisy produktów i&nbsp;kategorii dla sklepów internetowych.
        Unikalne treści pisane językiem korzyści, zoptymalizowane pod SEO
        i&nbsp;skalowalne od&nbsp;10 do&nbsp;500+ opisów miesięcznie.
      </p>

      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#rodzaje" class="srv-hero__cta-secondary">
          Rodzaje opisów
        </a>
      </div>

      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item">
          <strong>100%</strong> unikatowa treść
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>10–500+</strong> opisów / miesiąc
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>Import</strong> do CMS w cenie
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       E-COMMERCE PROBLEMS
       ═══════════════════════════════════════ -->
  <section class="srv-problems" aria-label="Problemy z opisami w e-commerce">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego to ważne"
          title="Opisy produktów to Twój cichy handlowiec"
          subtitle="W e-commerce nie masz sprzedawcy, który odpowie na pytania. Opis produktu musi zrobić to za niego — przekonać, rozwiać wątpliwości i&nbsp;domknąć sprzedaż."
        />
      </div>

      <div class="srv-problems__grid">
        {ecomProblems.map((p, i) => (
          <div class="srv-problems__card reveal" style={`--delay: ${i * 0.06}s`}>
            <div class="srv-problems__problem">
              <span class="srv-problems__icon srv-problems__icon--problem" aria-hidden="true">✕</span>
              <p class="srv-problems__problem-text">{p.problem}</p>
            </div>
            <p class="srv-problems__result">{p.result}</p>
            <div class="srv-problems__fix">
              <span class="srv-problems__icon srv-problems__icon--fix" aria-hidden="true">✓</span>
              <p>{p.fix}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       DESCRIPTION TYPES
       ═══════════════════════════════════════ -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co dostarczamy"
          title="Rodzaje opisów produktów"
          subtitle="Każdy typ opisu ma inne zastosowanie i&nbsp;inną głębokość. Dobieramy format do produktu, kanału sprzedaży i&nbsp;grupy docelowej."
        />
      </div>

      <div class="srv-types__grid">
        {descTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-scale">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              {d.scale}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       BEFORE / AFTER — live example
       ═══════════════════════════════════════ -->
  <section class="srv-example" aria-labelledby="srv-example-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Przed i po"
          title="Jak zmieniamy opisy produktów"
          subtitle="Ten sam produkt — dwa zupełnie różne opisy. Jeden informuje, drugi sprzedaje."
        />
      </div>

      <div class="srv-example__comparison reveal">
        <div class="srv-example__col srv-example__col--before">
          <span class="srv-example__label srv-example__label--before">Typowy opis</span>
          <div class="srv-example__text">
            <p><strong>Plecak turystyczny 40L</strong></p>
            <p>Materiał: poliester 600D. Pojemność: 40 litrów. Wymiary: 55×32×20 cm. Waga: 0,9 kg. Kolor: czarny. System nośny z pasem biodrowym. Kieszenie boczne na butelkę. Pokrowiec przeciwdeszczowy w komplecie.</p>
          </div>
        </div>

        <div class="srv-example__divider" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>

        <div class="srv-example__col srv-example__col--after">
          <span class="srv-example__label srv-example__label--after">Nasz opis</span>
          <div class="srv-example__text">
            <p><strong>Plecak turystyczny 40L — Twój partner na każdy szlak</strong></p>
            <p>Dwa dni w górach bez bólu pleców. System nośny z regulowanym pasem biodrowym przenosi ciężar z ramion na biodra — nawet z pełnym załadunkiem 40 litrów poczujesz różnicę już po pierwszej godzinie marszu.</p>
            <p>Wodoodporny poliester 600D wytrzyma deszcz i otarcia o skały. A jeśli pogoda naprawdę się zepsuje — wbudowany pokrowiec przeciwdeszczowy ochroni cały plecak w 10 sekund. Butelka, kijki, powerbank? Boczne kieszenie i system mocowań trzymają wszystko na wyciągnięcie ręki.</p>
            <p>Waży 900 gramów — lżejszy niż litr wody, który w nim poniesiesz.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PROCESS
       ═══════════════════════════════════════ -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od audytu po import do&nbsp;sklepu"
