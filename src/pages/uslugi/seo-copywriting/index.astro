---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Czym SEO copywriting różni się od zwykłego copywritingu?',
    a: 'SEO copywriting łączy umiejętność pisania angażujących tekstów z techniczną optymalizacją pod wyszukiwarki. Zwykły copywriter pisze dla ludzi — SEO copywriter pisze dla ludzi i algorytmów jednocześnie. To oznacza research fraz kluczowych, optymalizację nagłówków i meta tagów, planowanie struktury pod intencję wyszukiwania, linkowanie wewnętrzne i techniczne aspekty, których większość copywriterów nie obsługuje.'
  },
  {
    q: 'Ile kosztuje SEO copywriting?',
    a: 'Cena zależy od głębokości researchu, konkurencyjności frazy i długości tekstu. Artykuł blogowy z optymalizacją SEO to zazwyczaj 600–1500 zł, opis kategorii 400–800 zł, a kompleksowa strona usługowa z researchem fraz 1000–3000 zł. Przy stałej współpracy i większych wolumenach oferujemy pakiety z lepszymi stawkami. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Po jakim czasie zobaczę efekty SEO?',
    a: 'Pierwsze efekty w postaci indeksacji i początkowych pozycji widać po 2–4 tygodniach. Stabilne pozycje w top 10 dla fraz o średniej konkurencyjności to zazwyczaj 2–4 miesiące. Frazy wysokokonkurencyjne mogą wymagać 4–8 miesięcy systematycznej pracy. Dlatego SEO to maraton, nie sprint — ale to maraton z rosnącym compound interest.'
  },
  {
    q: 'Czy sami wdrażacie teksty na stronę?',
    a: 'Tak — i to nas wyróżnia. Mamy programistów w zespole, więc nie tylko piszemy teksty SEO, ale też wdrażamy je na stronę z pełną optymalizacją techniczną: schema markup, dane strukturalne, Core Web Vitals, linkowanie wewnętrzne, sitemap. Jeśli wolisz wdrażać samodzielnie, dostarczymy tekst z pełną specyfikacją techniczną.'
  },
  {
    q: 'Czy korzystacie z AI do pisania tekstów SEO?',
    a: 'Wykorzystujemy AI jako narzędzie wspierające — do researchu, analizy konkurencji, generowania wariantów nagłówków i przyspieszania procesu. Dysponujemy własnymi narzędziami AI zbudowanymi pod nasze potrzeby. Ale ostateczny tekst to zawsze praca doświadczonego copywritera, który weryfikuje fakty, nadaje ton i zapewnia jakość, której sam AI nie osiągnie.'
  },
  {
    q: 'Czy oferujecie stałą współpracę content SEO?',
    a: 'Tak — i to model, który przynosi najlepsze efekty. SEO wymaga systematyczności. Oferujemy pakiety miesięczne obejmujące: stały wolumen artykułów, cykliczny research fraz, monitoring pozycji, optymalizację istniejących treści i raportowanie wyników. Minimalny okres współpracy to 3 miesiące — bo tyle potrzeba, żeby zobaczyć realne efekty.'
  },
  {
    q: 'Jakie narzędzia SEO wykorzystujecie?',
    a: 'Pracujemy z Ahrefs, Semrush, Surfer SEO, Google Search Console, Google Analytics i własnymi narzędziami do analizy SERP i intencji wyszukiwania. Nasz zespół programistów buduje wewnętrzne narzędzia, które automatyzują research, analizę konkurencji i monitoring — dzięki temu pracujemy szybciej i dokładniej niż agencje opierające się wyłącznie na gotowych rozwiązaniach.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/seo-copywriting/#service",
      "name": "SEO Copywriting",
      "description": "Profesjonalny SEO copywriting — teksty zoptymalizowane pod wyszukiwarki z researchem fraz, analizą intencji i wdrożeniem technicznym. Mierzalne wyniki i skalowalne procesy.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "SEO Copywriting",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/seo-copywriting/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/seo-copywriting/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/seo-copywriting/",
      "name": "SEO Copywriting — Teksty SEO z Researchem i Wdrożeniem | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalny SEO copywriting. Teksty zoptymalizowane pod wyszukiwarki — research fraz, analiza intencji, wdrożenie techniczne. Mierzalne wyniki. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/seo-copywriting/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/seo-copywriting/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "SEO Copywriting", "item": "https://www.ecopywriting.pl/uslugi/seo-copywriting/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── What we deliver ──
const deliverables = [
  {
    title: 'Artykuły blogowe SEO',
    desc: 'Eksperckie artykuły pod long-tail keywords. Research fraz, analiza SERP, optymalna struktura nagłówków, linkowanie wewnętrzne. Treści, które rankują i generują ruch organiczny miesiącami po publikacji.',
    metrics: 'Średni wzrost ruchu: +40–120% w 3 miesiące',
    examples: 'Poradniki, how-to, listicle, ultimate guide, porównania'
  },
  {
    title: 'Opisy kategorii i produktów',
    desc: 'Teksty e-commerce zoptymalizowane pod frazy transakcyjne i informacyjne. Unikalne opisy, które wyróżniają się w SERP, budują autorytet kategorii i pomagają użytkownikom podjąć decyzję zakupową.',
    metrics: 'Skalowalne: od 10 do 1000+ opisów miesięcznie',
    examples: 'Opisy kategorii, Opisy produktów, Filtry i tagi SEO'
  },
  {
    title: 'Strony usługowe i ofertowe',
    desc: 'Landing page zoptymalizowane pod frazy komercyjne — „usługa + miasto", „firma + branża". Tekst, który konwertuje i jednocześnie buduje widoczność w Google. Struktura pod featured snippets i rich results.',
    metrics: 'Konwersja + pozycja = podwójny zwrot z inwestycji',
    examples: 'Strona usługowa, Strona lokalna, Landing page SEO'
  },
  {
    title: 'Treści filarowe i klastry tematyczne',
    desc: 'Strategiczne content hubs — strona filarowa (pillar page) otoczona klastrem powiązanych artykułów z wewnętrznym linkowaniem. Architektura treści, która buduje topical authority i dominuje niszę tematyczną.',
    metrics: 'Topical authority = więcej pozycji na mniej wysiłku',
    examples: 'Pillar page, Content cluster, Topic hub, Cornerstone content'
  },
  {
    title: 'Optymalizacja istniejących treści',
    desc: 'Content refresh — audyt i aktualizacja treści, które straciły pozycje lub nigdy ich nie zdobyły. Analiza content gap, dodanie brakujących sekcji, poprawa struktury, aktualizacja danych. Szybsze efekty niż pisanie od zera.',
    metrics: 'Często szybszy ROI niż nowy content',
    examples: 'Content audit, Content refresh, Content gap analysis'
  },
  {
    title: 'Meta tagi i dane strukturalne',
    desc: 'Optymalizacja title i description pod CTR w SERP. Schema markup (FAQ, HowTo, Product, Article, Breadcrumb) dla rich snippets. Dane strukturalne, które zwiększają widoczność i klikalność w wynikach wyszukiwania.',
    metrics: 'Wzrost CTR z SERP o 15–35% dzięki rich snippets',
    examples: 'Meta title, Meta description, Schema.org, Open Graph'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Audyt i research fraz',
    desc: 'Analizujemy Twoją obecną widoczność, identyfikujemy luki i możliwości. Research fraz kluczowych z podziałem na intencje (informacyjna, nawigacyjna, transakcyjna). Analiza konkurencji w SERP — kto rankuje, dlaczego i jak to pobić.',
    tools: 'Ahrefs, Semrush, GSC, własne narzędzia SERP'
  },
  {
    num: '02',
    title: 'Strategia i content plan',
    desc: 'Tworzymy plan treści z priorytetyzacją — które frazy atakować najpierw, jaką strukturę linkowania wewnętrznego zbudować, ile treści potrzeba i w jakim harmonogramie. Każdy tekst ma przypisaną frazę główną, frazy wspierające i intencję.',
    tools: 'Content mapping, keyword clustering, topical authority plan'
  },
  {
    num: '03',
    title: 'Pisanie i optymalizacja',
    desc: 'Tworzymy tekst z natywną optymalizacją — frazy w nagłówkach, naturalnie w treści, w meta tagach. Struktura pod featured snippets, czytelność pod użytkownika, depth pod algorytm. AI wspiera research i drafting, copywriter finalizuje.',
    tools: 'Surfer SEO, własne AI tools, redakcja ludzka'
  },
  {
    num: '04',
    title: 'Wdrożenie techniczne',
    desc: 'Nasz zespół programistów wdraża treść na stronę z pełną optymalizacją techniczną: poprawne nagłówki H1-H6, schema markup, dane strukturalne, linkowanie wewnętrzne, optymalizacja obrazów, sitemap. Nie zostawiamy Cię z dokumentem w Google Docs.',
    tools: 'CMS, schema markup, Core Web Vitals, sitemap'
  },
  {
    num: '05',
    title: 'Monitoring i iteracja',
    desc: 'Śledzimy pozycje, ruch organiczny, CTR i konwersje. Raportujemy wyniki i na ich podstawie iterujemy — optymalizujemy treści, które nie performują, i skalujemy te, które działają. SEO to proces ciągły, nie jednorazowy.',
    tools: 'GSC, GA4, Ahrefs rank tracker, własne dashboardy'
  }
];

// ── Differentiators ──
const diffs = [
  {
    icon: '⚙️',
    title: 'Technologia w&nbsp;DNA',
    desc: 'Nie jesteśmy typową agencją contentową. Mamy programistów w zespole i własne narzędzia AI do researchu, analizy SERP i optymalizacji treści. To pozwala nam pracować szybciej, dokładniej i w skali, która jest nieosiągalna dla tradycyjnych agencji copywriterskich.'
  },
  {
    icon: '📊',
    title: 'Mierzalne wyniki',
    desc: 'Każdy tekst SEO, który tworzymy, jest powiązany z konkretnymi KPI — pozycje, ruch organiczny, CTR z SERP, konwersje. Nie piszemy „żeby było" — piszemy, żeby rankować. I mierzymy, czy to działa. Raportujemy wyniki, nie liczbę napisanych słów.'
  },
  {
    icon: '🚀',
    title: 'Skalowanie bez tarcia',
    desc: 'Potrzebujesz 5 artykułów miesięcznie? Albo 50? Nasze procesy i narzędzia pozwalają skalować produkcję treści SEO bez utraty jakości. Łączymy AI-powered research z ludzką redakcją — to daje szybkość maszyny i jakość człowieka.'
  },
  {
    icon: '🔧',
    title: 'End-to-end: tekst + wdrożenie',
    desc: 'Większość agencji SEO contentowych kończy na dokumencie w Google Docs. My wdrażamy treści na stronę z pełną optymalizacją techniczną — schema markup, linkowanie, sitemap, Core Web Vitals. Jeden dostawca zamiast agencji contentowej + programisty.'
  },
  {
    icon: '🧠',
    title: '15+ lat w&nbsp;content marketingu',
    desc: 'SEO copywriting to nie tylko frazy kluczowe — to zrozumienie odbiorcy, rynku i intencji. Nasze 15+ lat doświadczenia w tworzeniu treści oznacza, że nie tworzymy „tekstów pod roboty". Tworzymy treści, które ludzie chcą czytać — a Google chce rankować.'
  },
  {
    icon: '🔗',
    title: 'Strategia, nie pojedyncze teksty',
    desc: 'Pojedynczy artykuł SEO to za mało. Budujemy topical authority — sieci powiązanych treści z przemyślanym linkowaniem wewnętrznym, content clusters i pillar pages. Strategia, która rośnie z każdym opublikowanym tekstem.'
  }
];

// ── Related ──
const related = [
  { title: 'Artykuły blogowe', href: '/uslugi/artykuly-blogowe/', desc: 'Eksperckie treści budujące autorytet i generujące ruch organiczny' },
  { title: 'Strategia contentowa', href: '/uslugi/strategia-content-marketingowa/', desc: 'Audyt treści, plan publikacji, dobór fraz i kanałów' },
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe, oferty handlowe, slogany i hasła reklamowe' },
  { title: 'Landing page', href: '/uslugi/landing-page/', desc: 'Strony lądowania z tekstem i wdrożeniem technicznym' }
];
---

<BaseLayout
  title="SEO Copywriting — Teksty SEO z Researchem i Wdrożeniem | eCopywriting.pl"
  description="Profesjonalny SEO copywriting. Teksty zoptymalizowane pod wyszukiwarki — research fraz kluczowych, analiza intencji, optymalizacja techniczna i wdrożenie. Własne narzędzia AI, programiści w zespole. Mierzalne wyniki. Wycena w 24h."
  keywords="seo copywriting, teksty seo, pisanie tekstów seo, copywriting seo, seo copywriter, treści seo, artykuły seo, optymalizacja treści, content seo"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/seo-copywriting/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">SEO Copywriting</li>
      </ol>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════
       HERO
       ═══════════════════════════════════════ -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true">
      <div class="srv-hero__grain"></div>
      <div class="srv-hero__gradient"></div>
    </div>

    <div class="container srv-hero__inner">
      <div class="srv-hero__badge">
        <span class="srv-hero__badge-dot"></span>
        Content & Copywriting
      </div>

      <h1 id="srv-hero-title" class="srv-hero__title">
        SEO Copywriting, który<br>
        <em>rankuje i&nbsp;konwertuje</em>
      </h1>

      <p class="srv-hero__subtitle">
        Teksty SEO pisane przez copywriterów i&nbsp;optymalizowane przez programistów.
        Research fraz, analiza intencji, profesjonalny copywriting i&nbsp;wdrożenie techniczne
        — w&nbsp;jednym zespole. Mierzalne wyniki, nie obietnice.
      </p>

      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#co-dostarczamy" class="srv-hero__cta-secondary">
          Co dostarczamy
        </a>
      </div>

      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item">
          <strong>Tech + SEO</strong> w jednym zespole
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>Własne narzędzia</strong> AI &amp; SERP
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>Mierzalne</strong> wyniki
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       KEY NUMBERS
       ═══════════════════════════════════════ -->
  <section class="srv-numbers" aria-label="Kluczowe liczby">
    <div class="container-wide">
      <div class="srv-numbers__track reveal">
        <div class="srv-numbers__item">
          <span class="srv-numbers__value">15<span class="srv-numbers__plus">+</span></span>
          <span class="srv-numbers__label">lat doświadczenia<br>w content marketingu</span>
        </div>
        <div class="srv-numbers__divider" aria-hidden="true"></div>
        <div class="srv-numbers__item">
          <span class="srv-numbers__value">100<span class="srv-numbers__plus">%</span></span>
          <span class="srv-numbers__label">treści z researchem<br>fraz i intencji</span>
        </div>
        <div class="srv-numbers__divider" aria-hidden="true"></div>
        <div class="srv-numbers__item">
          <span class="srv-numbers__value">E2E</span>
          <span class="srv-numbers__label">od researchu po<br>wdrożenie na stronę</span>
        </div>
        <div class="srv-numbers__divider" aria-hidden="true"></div>
        <div class="srv-numbers__item">
          <span class="srv-numbers__value">AI<span class="srv-numbers__plus">+</span></span>
          <span class="srv-numbers__label">własne narzędzia<br>do researchu i analizy</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       DELIVERABLES
       ═══════════════════════════════════════ -->
  <section class="srv-types" id="co-dostarczamy" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co dostarczamy"
          title="Teksty SEO, które pracują na&nbsp;pozycje"
          subtitle="Nie piszemy &bdquo;pod roboty&rdquo;. Tworzymy treści, które ludzie chcą czytać, a&nbsp;Google chce rankować. Każdy tekst SEO zaczyna się od danych — i&nbsp;kończy na mierzalnych wynikach."
        />
      </div>

      <div class="srv-types__grid">
        {deliverables.map((s, i) => (
          <div class="srv-type reveal" style={`--delay: ${i * 0.05}s`}>
            <div class="srv-type__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <div class="srv-type__content">
              <h3 class="srv-type__title">{s.title}</h3>
              <p class="srv-type__desc">{s.desc}</p>
              <div class="srv-type__meta">
                <span class="srv-type__metric">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                  {s.metrics}
                </span>
              </div>
              <div class="srv-type__examples">
                <span class="srv-type__examples-label">Formaty:</span>
                {s.examples}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PROCESS
       ═══════════════════════════════════════ -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od researchu fraz po&nbsp;monitoring pozycji"
          subtitle="Nasz proces łączy analitykę, kreatywność i&nbsp;technologię. Na każdym etapie korzystamy z&nbsp;własnych narzędzi i&nbsp;kompetencji programistycznych — dlatego dostarczamy szybciej i&nbsp;dokładniej."
          inverted
        />
      </div>

      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
              <span class="srv-process__step-tools">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                {step.tools}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WHY US
       ═══════════════════════════════════════ -->
  <section class="srv-why" id="dlaczego" aria-labelledby="srv-why-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="SEO copywriting oparty na&nbsp;technologii i&nbsp;doświadczeniu"
          subtitle="Łączymy kompetencje, których inni nie mają w jednym zespole: copywriting, SEO, programowanie i&nbsp;własne narzędzia AI."
        />
      </div>

      <div class="srv-why__grid">
        {diffs.map((d, i) => (
          <div class="srv-why__card reveal" style={`--delay: ${i * 0.06}s`}>
            <div class="srv-why__card-icon" aria-hidden="true">{d.icon}</div>
            <h3 set:html={d.title} />
            <p>{d.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       TECH EDGE — wyróżnik technologiczny
       ═══════════════════════════════════════ -->
  <section class="srv-tech" id="technologia" aria-labelledby="srv-tech-title">
    <div class="container">
      <div class="srv-tech__inner reveal">
        <div class="srv-tech__content">
