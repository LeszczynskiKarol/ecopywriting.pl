---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie dokumentacji technicznej?',
    a: 'Cena zależy od złożoności, objętości i formatu. Instrukcja obsługi produktu (20–40 stron, jedno urządzenie/system) to 3000–8000 zł. Dokumentacja API/SDK (endpointy, przykłady kodu, integracje) to 5000–15 000 zł. Baza wiedzy / help center (20–60 artykułów, struktura, wyszukiwanie) to 8000–25 000 zł. Kompletna dokumentacja produktowa (user guide + admin guide + API + release notes) to 15 000–40 000 zł. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Czy piszecie dokumentację od zera, czy potrzebujecie materiały źródłowe?',
    a: 'Jedno i drugie. Możemy napisać dokumentację od zera — na podstawie briefu, dostępu do produktu, rozmów z inżynierami i własnych testów. Możemy też przepisać/zredagować istniejącą dokumentację: uporządkować strukturę, uprościć język, ustandaryzować format, dodać przykłady i screenshoty. Najczęstsza opcja: klient daje dostęp do produktu + eksperta technicznego, a my piszemy, redagujemy i składamy.'
  },
  {
    q: 'W jakich formatach dostarczacie dokumentację?',
    a: 'Dobieramy format do kontekstu: Markdown/MDX (docs-as-code, Git-friendly, do generatorów statycznych), HTML (baza wiedzy, help center, Docusaurus/GitBook/ReadTheDocs), PDF (instrukcje do druku, manuali, offline), LaTeX/Quarto (dokumentacja z kodem, formułami, danymi), Notion/Confluence (wiki firmowe), DITA XML (duże systemy dokumentacji, lokalizacja). Standardowo dostarczamy Markdown + PDF.'
  },
  {
    q: 'Czy tworzycie dokumentację API?',
    a: 'Tak — piszemy dokumentację REST API, GraphQL, SDK i bibliotek. Endpointy z opisami, parametry, kody odpowiedzi, przykłady requestów i responsów w kilku językach (cURL, Python, JavaScript, PHP). Integrujemy z OpenAPI/Swagger. Dokumentacja API to nie auto-generowany spec — to przewodnik, który pozwala developerowi zintegrować się w godziny, nie dni.'
  },
  {
    q: 'Jak długo trwa stworzenie dokumentacji?',
    a: 'Instrukcja obsługi (20–40 stron) to 2–4 tygodnie. Dokumentacja API to 3–6 tygodni (zależnie od liczby endpointów). Baza wiedzy (20–60 artykułów) to 4–8 tygodni. Kompletna dokumentacja produktowa to 6–16 tygodni. Czas zależy od: złożoności produktu, dostępności ekspertów, liczby formatów i rund akceptacji. Przy produktach z frequent releases rekomendujemy stałą współpracę.'
  },
  {
    q: 'Czy pomagacie z docs-as-code i CI/CD dla dokumentacji?',
    a: 'Tak — nasz zespół programistów wdraża pipeline docs-as-code: dokumentacja w Markdown/MDX w repozytorium Git, automatyczny build przez CI/CD (GitHub Actions, GitLab CI), deploy na platformę (Docusaurus, Astro Starlight, GitBook, ReadTheDocs). Każda zmiana w kodzie może triggerować aktualizację dokumentacji. Docs-as-code = dokumentacja, która żyje z produktem.'
  },
  {
    q: 'Dla jakich branż tworzycie dokumentację techniczną?',
    a: 'Najczęściej pracujemy z: SaaS i platformy technologiczne (dokumentacja produktowa, API, SDK), fintech (compliance, procedury, integracje), IoT i hardware (instrukcje obsługi, specyfikacje), przemysł i manufacturing (instrukcje montażu, procedury BHP, specyfikacje techniczne), medtech (dokumentacja regulacyjna, instrukcje użytkowania). Ale format dokumentacji technicznej sprawdza się wszędzie, gdzie produkt wymaga wyjaśnienia.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/#service",
      "name": "Dokumentacja techniczna",
      "description": "Profesjonalne tworzenie dokumentacji technicznej. Instrukcje obsługi, dokumentacja API, bazy wiedzy, manuali, SOP. Technical writing, redakcja, skład, wdrożenie docs-as-code.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Technical documentation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/",
      "name": "Dokumentacja Techniczna — Tworzenie Dokumentacji Technicznej na Zamówienie | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie dokumentacji technicznej. Instrukcje obsługi, dokumentacja API, bazy wiedzy, help center. Technical writing + development. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Dokumentacja techniczna", "item": "https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Doc types ──
const docTypes = [
  {
    title: 'Instrukcje obsługi',
    desc: 'User guides, manuali, getting started guides. Krok po kroku — od instalacji po zaawansowane funkcje. Screenshoty, diagramy, callouty, tabelki. Język użytkownika, nie inżyniera. Wersja PDF do druku i/lub online.',
    audience: 'Użytkownicy końcowi',
    icon: '📘'
  },
  {
    title: 'Dokumentacja API i SDK',
    desc: 'REST API, GraphQL, SDK, biblioteki. Endpointy, parametry, kody odpowiedzi, przykłady kodu w kilku językach. Integracja z OpenAPI/Swagger. Quickstart guide, który pozwala zintegrować się w godziny. Docs, które developerzy chcą czytać.',
    audience: 'Developerzy',
    icon: '⚡'
  },
  {
    title: 'Bazy wiedzy i help center',
    desc: 'Zorganizowany zbiór artykułów z wyszukiwaniem — FAQ, troubleshooting, how-to, best practices. Struktura kategorii, tagowanie, cross-linking. Redukuje liczbę ticketów supportowych o 30–60%. Platforma: Docusaurus, GitBook, Zendesk, Intercom.',
    audience: 'Klienci i support',
    icon: '🏗️'
  },
  {
    title: 'Dokumentacja produktowa',
    desc: 'Kompletna dokumentacja SaaS/platformy — user guide + admin guide + release notes + changelog + migration guide. Modularnie: każdy moduł produktu = jeden rozdział. Wersjonowanie docs per release. Docs, które rosną z produktem.',
    audience: 'Użytkownicy i admini',
    icon: '📦'
  },
  {
    title: 'Specyfikacje techniczne',
    desc: 'Dokumenty techniczne dla inżynierów — specyfikacje produktów, schematy, parametry, standardy. Precyzyjny język, tabelki z danymi, rysunki techniczne, normy. Format: PDF, LaTeX, DITA. Dla branż: przemysł, IoT, hardware, budownictwo.',
    audience: 'Inżynierowie i technicy',
    icon: '⚙️'
  },
  {
    title: 'Procedury i SOP',
    desc: 'Standardowe procedury operacyjne — step-by-step instrukcje procesów. Decision trees, flowcharty, checklisty, role i odpowiedzialności. Dokumenty, które pozwalają skalować operacje bez utraty jakości. Compliance-ready.',
    audience: 'Zespoły operacyjne',
    icon: '📋'
  }
];

// ── Good vs Bad docs ──
const goodVsBad = [
  { bad: 'Żargon inżyniera', good: 'Język dopasowany do odbiorcy', desc: 'Dokumentacja pisana przez devów dla devów, gdy odbiorcą jest product manager. Piszemy na poziomie odbiorcy — nie niżej (to obraża), nie wyżej (to wyłącza).' },
  { bad: 'Ściana tekstu bez struktury', good: 'Skanowalność i hierarchia', desc: 'Nagłówki, callouty, tabelki, numbered steps, code blocks. Czytelnik skanuje, nie czyta od deski do deski. Struktura musi pozwalać znaleźć odpowiedź w 30 sekund.' },
  { bad: 'Dokumentacja pisana raz — nigdy aktualizowana', good: 'Docs-as-code i wersjonowanie', desc: 'Dokumentacja w Git, automatyczny build, wersja per release. Zmiana w produkcie = zmiana w docs. Nie PDF z 2021 roku na sharepoinie.' },
  { bad: 'Brak przykładów', good: 'Przykłady na każdym kroku', desc: 'Każde wyjaśnienie poparte przykładem: screenshot, code snippet, scenariusz. „Pokaż, nie mów". Jeden dobry przykład zastępuje paragraf opisu.' },
  { bad: 'Zero kontekstu — co, ale nie dlaczego', good: 'Kontekst: co, jak i dlaczego', desc: 'Dobra dokumentacja wyjaśnia nie tylko jak coś zrobić, ale DLACZEGO tak, a nie inaczej. Kontekst redukuje błędy i buduje zrozumienie systemu.' }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Audyt i planowanie',
    desc: 'Audyt istniejącej dokumentacji (lub zakresu nowej), analiza produktu, identyfikacja odbiorców i ich potrzeb. Information architecture — mapa dokumentów, struktura kategorii, naming convention. Content plan do akceptacji.'
  },
  {
    num: '02',
    title: 'Research i wywiady',
    desc: 'Dostęp do produktu, rozmowy z inżynierami/product managerami (SME interviews), własne testy i eksploracja. Zbieramy wiedzę, którą zamieniamy w zrozumiałą dokumentację. Nie piszemy z „głowy" — piszemy z produktu i ekspertów.'
  },
  {
    num: '03',
    title: 'Technical writing i redakcja',
    desc: 'Pisanie w języku odbiorcy — step-by-step, z przykładami, screenshotami, code snippetami. Dwuetapowa redakcja: merytoryczna (z SME — czy to technicznie poprawne?) i językowa (czy to zrozumiałe?). Style guide dla spójności terminologii.'
  },
  {
    num: '04',
    title: 'Design i skład',
    desc: 'Projekt graficzny dopasowany do kontekstu — callout boxy, tabele, diagramy, code blocks z syntax highlighting. Skład w Markdown/MDX (docs-as-code), LaTeX (PDF/druk), HTML (baza wiedzy). Spójny design system dokumentacji.'
  },
  {
    num: '05',
    title: 'Wdrożenie i maintenance',
    desc: 'Wdrożenie na platformie: Docusaurus, Astro Starlight, GitBook, ReadTheDocs, Confluence, Notion lub dedykowany system. Pipeline CI/CD dla automatycznego build. Opcjonalnie: stała współpraca i aktualizacja docs per release cycle.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Technical writers + programiści',
    desc: 'Nasz zespół łączy technical writing z programowaniem. Piszemy dokumentację API i testujemy endpointy. Tworzymy instrukcje i sprawdzamy je na produkcie. Wdrażamy docs-as-code i pipeline CI/CD. Nie „piszemy o technologii" — rozumiemy technologię.'
  },
  {
    title: 'Język użytkownika, nie inżyniera',
    desc: 'Jesteśmy agencją copywriterską — pisanie zrozumiałych tekstów to nasze DNA. Dokumentacja techniczna nie musi być sucha i niezrozumiała. Piszemy na poziomie odbiorcy: inaczej dla developera (code-first), inaczej dla end usera (task-based), inaczej dla admina (config-focused).'
  },
  {
    title: 'Docs-as-code: dokumentacja, która żyje',
    desc: 'Dokumentacja w Markdown w repozytorium Git, automatyczny build przez CI/CD, deploy na wybraną platformę. Każdy release triggeruje aktualizację docs. Wersjonowanie, branching, code review na dokumentacji — tak jak na kodzie. Zero stale docs.'
  },
  {
    title: 'Mniej ticketów, szybszy onboarding',
    desc: 'Dobra dokumentacja to najlepsza inwestycja w customer success: redukuje tickety supportowe o 30–60%, skraca czas onboardingu, zmniejsza obciążenie zespołu. Każdy artykuł w bazie wiedzy to support agent, który pracuje 24/7 i nigdy nie bierze L4.'
  }
];

// ── Tech/platforms ──
const platforms = [
  { group: 'Docs-as-code', items: ['Docusaurus', 'Astro Starlight', 'GitBook', 'ReadTheDocs', 'MkDocs', 'VitePress'] },
  { group: 'Wiki & knowledge base', items: ['Confluence', 'Notion', 'Zendesk Guide', 'Intercom Articles', 'HelpScout'] },
  { group: 'Formaty', items: ['Markdown / MDX', 'LaTeX / Quarto', 'HTML / CSS', 'PDF (druk + ekran)', 'DITA XML', 'OpenAPI / Swagger'] },
  { group: 'Tooling', items: ['Git + CI/CD', 'GitHub Actions', 'GitLab CI', 'Vale (linting)', 'Mermaid (diagramy)', 'Algolia (search)'] }
];

// ── Related ──
const related = [
  { title: 'Materiały szkoleniowe', href: '/uslugi/materialy-szkoleniowe/', desc: 'Szkolenia i onboarding' },
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Publikacje techniczne i eksperckie' },
  { title: 'White papers', href: '/uslugi/white-papers/', desc: 'Dokumenty eksperckie B2B' },
  { title: 'Teksty na stronę', href: '/uslugi/teksty-na-strone/', desc: 'Copy na strony produktowe' }
];
---

<BaseLayout
  title="Dokumentacja Techniczna — Tworzenie Dokumentacji Technicznej na Zamówienie | eCopywriting.pl"
  description="Profesjonalne tworzenie dokumentacji technicznej. Instrukcje obsługi, dokumentacja API, bazy wiedzy, help center, specyfikacje, SOP. Technical writing, docs-as-code, wdrożenie. Wycena w 24h."
  keywords="dokumentacja techniczna, tworzenie dokumentacji technicznej, instrukcja obsługi, dokumentacja API, baza wiedzy, help center, technical writing, docs-as-code, dokumentacja produktowa, instrukcje techniczne"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/dokumentacja-techniczna/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Dokumentacja techniczna</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Dokumentacja & Technical Writing</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Dokumentacja techniczna,<br>którą <em>ludzie naprawdę czytają</em>
      </h1>
      <p class="srv-hero__subtitle">
        Instrukcje obsługi, dokumentacja API, bazy wiedzy, help center, specyfikacje
        i&nbsp;procedury. Technical writing + programiści = dokumentacja, która redukuje
        tickety, skraca onboarding i&nbsp;żyje z&nbsp;produktem.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#rodzaje" class="srv-hero__cta-secondary">Rodzaje dokumentacji</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Technical writers</strong> + programiści</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Docs-as-code</strong> — Git + CI/CD</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>−30–60%</strong> ticketów supportowych</div>
      </div>
    </div>
  </section>

  <!-- GOOD vs BAD DOCS -->
  <section class="srv-compare" aria-labelledby="srv-compare-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Zła vs dobra dokumentacja"
          title="5 różnic między dokumentacją, która frustruje, a&nbsp;dokumentacją, która pomaga"
          subtitle="Większość dokumentacji technicznej jest pisana przez inżynierów dla inżynierów. Problem: odbiorcy to nie zawsze inżynierowie."
        />
      </div>

      <div class="srv-compare__table reveal">
        <div class="srv-compare__header">
          <span class="srv-compare__header-bad">✕ Zła dokumentacja</span>
          <span class="srv-compare__header-good">✓ Dobra dokumentacja</span>
        </div>
        {goodVsBad.map((row) => (
          <div class="srv-compare__row">
            <div class="srv-compare__cell srv-compare__cell--bad">{row.bad}</div>
            <div class="srv-compare__cell srv-compare__cell--good">{row.good}</div>
            <div class="srv-compare__cell srv-compare__cell--desc">{row.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOC TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co tworzymy"
          title="Rodzaje dokumentacji technicznej"
          subtitle="Od 20-stronowej instrukcji obsługi po kompletną dokumentację platformy SaaS z&nbsp;bazą wiedzy, API docs i&nbsp;release notes. Dobieramy format do odbiorcy."
        />
      </div>
      <div class="srv-types__grid">
        {docTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-audience">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {d.audience}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od audytu po wdrożenie i&nbsp;maintenance"
          subtitle="Pięć etapów, jeden zespół. Audyt → research → technical writing → design i&nbsp;skład → wdrożenie na platformie. Opcjonalnie: stała współpraca z&nbsp;aktualizacją per release."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Dokumentacja od technical writerów z&nbsp;zespołem dev"
          subtitle="Freelance technical writer pisze dobrze, ale nie wdroży docs-as-code. Agencja webowa wdroży platformę, ale nie napisze dobrej dokumentacji. My robimy jedno i&nbsp;drugie."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PLATFORMS & TECH -->
  <section class="srv-tech" id="technologia" aria-label="Platformy i technologie">
    <div class="container">
      <div class="srv-tech__inner reveal">
        <span class="srv-tech__label">Platformy i narzędzia</span>
        <h2 class="srv-tech__title">Stack technologiczny dokumentacji</h2>
        <p class="srv-tech__desc">
          Dobieramy platformę i format do kontekstu — Docusaurus dla open source,
          Confluence dla enterprise, Markdown + Git dla docs-as-code, LaTeX dla
          dokumentacji z formułami i kodem. Plus pełen zestaw narzędzi do lintingu,
          diagramów i wyszukiwania.
        </p>
        <div class="srv-tech__groups">
          {platforms.map((group) => (
            <div class="srv-tech__group">
              <span class="srv-tech__group-label">{group.group}</span>
              <div class="srv-tech__items">
                {group.items.map((item) => (
                  <span class="srv-tech__item">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
