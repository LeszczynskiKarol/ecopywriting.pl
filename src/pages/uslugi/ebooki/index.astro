---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie ebooka?',
    a: 'Cena zależy od objętości, złożoności tematu i zakresu prac. Krótki ebook (15–25 stron, lead magnet) to 3000–6000 zł. Ebook ekspercki (30–60 stron, pogłębiony temat) to 6000–12 000 zł. Publikacja premium (80–150+ stron, pełny research, wywiady, case studies) to 12 000–25 000 zł. W cenę wliczone: strategia, pisanie, redakcja, skład, projekt graficzny i rendering do wybranych formatów.'
  },
  {
    q: 'Jak długo trwa stworzenie ebooka?',
    a: 'Krótki lead magnet (15–25 stron) to 2–3 tygodnie. Ebook ekspercki (30–60 stron) to 3–5 tygodni. Publikacja premium (80–150+ stron) to 6–10 tygodni. Czas obejmuje: brief, research, pisanie, redakcję merytoryczną i językową, skład i projekt graficzny, rendering i testy. Przy pilnych projektach oferujemy tryb ekspresowy.'
  },
  {
    q: 'W jakich formatach dostarczacie gotowy ebook?',
    a: 'Dostarczamy ebooki w dowolnych formatach: PDF (druk + ekran), EPUB (czytniki, Apple Books), MOBI/KF8 (Kindle), a także pliki źródłowe (LaTeX/Quarto) do przyszłych edycji. Standardowo dostarczamy PDF + EPUB. Format dobieramy do kanału dystrybucji — inny do pobrania ze strony, inny do Amazon Kindle, inny do druku.'
  },
  {
    q: 'Czy mogę zamówić sam skład i projekt graficzny (mam już tekst)?',
    a: 'Tak — oferujemy sam skład i rendering ebooków z gotowego tekstu. Dostarczasz treść w dowolnym formacie (Docs, Word, Markdown), a my zajmujemy się: redakcją, projektem graficznym, składem typograficznym i renderingiem do PDF/EPUB/MOBI. To opcja dla firm, które mają copywritera, ale potrzebują profesjonalnego składu.'
  },
  {
    q: 'Czy ebook może być lead magnetem na stronie?',
    a: 'Tak — i to jedno z najskuteczniejszych zastosowań. Projektujemy ebooki jako lead magnety: wartościowa treść w zamian za adres email. Pomagamy też z landing page, formularzem zapisu i integracją z platformą email (Mailchimp, MailerLite, ConvertKit i inne). Ebook + landing page + sekwencja powitalna = kompletny lejek pozyskiwania leadów.'
  },
  {
    q: 'Jakich narzędzi używacie do składu ebooków?',
    a: 'Pracujemy z profesjonalnymi narzędziami DTP i publishing: LaTeX i Quarto (publikacje techniczne, akademickie, raporty z danymi, publikacje wizualne, lifestyle, marketing), własne pipeline\'y renderingu do PDF/EPUB/MOBI. Przeważnie korzystamy z LaTeX dla precyzji typograficznej i swobody wizualnej.'
  },
  {
    q: 'Czy pomagacie z dystrybucją ebooka?',
    a: 'Tak — doradzamy w strategii dystrybucji: landing page z formularzem zapisu (lead magnet), publikacja na Amazon Kindle (KDP), dystrybucja przez newsletter, promocja w social media, gated content na stronie. Możemy też przygotować materiały promocyjne — grafiki social media, fragmenty do newslettera, landing page z copy i wdrożeniem.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/ebooki/#service",
      "name": "Tworzenie ebooków",
      "description": "Profesjonalne tworzenie ebooków na zamówienie. Kompleksowa usługa: strategia, pisanie, redakcja, projekt graficzny, skład typograficzny i rendering do PDF, EPUB, MOBI. Lead magnety, publikacje eksperckie, raporty branżowe.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Ebook creation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/ebooki/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/ebooki/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/ebooki/",
      "name": "Ebooki — Tworzenie Ebooków na Zamówienie | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie ebooków na zamówienie. Pisanie, redakcja, skład, projekt graficzny, rendering PDF/EPUB/MOBI. Lead magnety, publikacje eksperckie. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/ebooki/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/ebooki/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Ebooki", "item": "https://www.ecopywriting.pl/uslugi/ebooki/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Ebook types ──
const ebookTypes = [
  {
    title: 'Lead magnety',
    desc: 'Kompaktowe ebooki (15–25 stron) zaprojektowane jako narzędzie pozyskiwania leadów. Wartościowa treść w zamian za adres email. Checklisty, mini-poradniki, szablony, frameworki. Projektowane pod szybkie czytanie i natychmiastową wartość.',
    best: 'Pozyskiwanie subskrybentów i leadów',
    icon: '🧲'
  },
  {
    title: 'Ebooki eksperckie',
    desc: 'Pogłębione publikacje (30–60 stron) budujące autorytet w branży. Kompleksowe omówienie tematu z danymi, case studies i praktycznymi rekomendacjami. Pozycjonują firmę jako eksperta i stanowią trwałe aktywo content marketingowe.',
    best: 'Budowanie autorytetu i thought leadership',
    icon: '📘'
  },
  {
    title: 'Raporty branżowe',
    desc: 'Publikacje oparte na danych — wyniki badań, analizy rynku, trendy, benchmarki. Profesjonalny skład z wykresami, tabelami i infografikami. Raporty generują backlinki, cytowania w mediach i pozycję lidera opinii w branży.',
    best: 'Dane, PR i backlinki',
    icon: '📊'
  },
  {
    title: 'White papers',
    desc: 'Techniczne lub biznesowe dokumenty (15–30 stron) adresujące konkretny problem i proponujące rozwiązanie. Format popularny w B2B, SaaS i enterprise. Skuteczne w środku i na dole lejka sprzedażowego — edukują i przesuwają lead bliżej decyzji.',
    best: 'B2B, SaaS, enterprise sales',
    icon: '📄'
  },
  {
    title: 'Poradniki i kursy',
    desc: 'Obszerne publikacje edukacyjne (60–150+ stron) — step-by-step guides, podręczniki, materiały szkoleniowe. Struktura modułowa z ćwiczeniami, checklistami i podsumowaniami. Mogą być produktem płatnym lub elementem onboardingu klientów.',
    best: 'Edukacja, onboarding, produkty cyfrowe',
    icon: '🎓'
  },
  {
    title: 'Repurposing — blog → ebook',
    desc: 'Przekształcenie istniejących artykułów blogowych w spójną publikację. Selekcja najlepszych treści, redakcja, uzupełnienie, nowa struktura, profesjonalny skład. Maksymalizacja ROI z treści, które już masz — bez pisania od zera.',
    best: 'Maksymalizacja istniejącego contentu',
    icon: '♻️'
  }
];

// ── Full-stack pipeline ──
const pipeline = [
  {
    num: '01',
    title: 'Strategia i brief',
    desc: 'Definiujemy cel ebooka (lead magnet, autorytet, sprzedaż), grupę docelową, ton, zakres i format. Research tematu, analiza konkurencyjnych publikacji, plan rozdziałów. Brief do akceptacji — żebyśmy pisali dokładnie to, czego potrzebujesz.',
    tag: 'Planowanie'
  },
  {
    num: '02',
    title: 'Research i pisanie',
    desc: 'Głęboki research tematu — dane, źródła, wywiady z ekspertami (jeśli potrzeba). Pisanie rozdziałów przez copywritera specjalizującego się w Twojej branży. AI wspiera research i drafting, człowiek finalizuje i nadaje eksperckość. Tekst do akceptacji przed składem.',
    tag: 'Content'
  },
  {
    num: '03',
    title: 'Redakcja merytoryczna i językowa',
    desc: 'Dwuetapowa redakcja: najpierw merytoryczna (fakty, logika, spójność argumentacji), potem językowa (styl, gramatyka, interpunkcja). Korekta eliminuje błędy, redakcja podnosi jakość. Każdy ebook przechodzi przez dwóch redaktorów.',
    tag: 'Redakcja'
  },
  {
    num: '04',
    title: 'Projekt graficzny i kreacja',
    desc: 'Projektowanie identyfikacji wizualnej ebooka — okładka, layout stron, typografia, paleta kolorów, ikony, infografiki, wykresy. Spójność z brandingiem Twojej firmy. Kreacja dopasowana do formatu — inny layout dla PDF do pobrania, inny dla EPUB na czytniku.',
    tag: 'Design'
  },
  {
    num: '05',
    title: 'Skład typograficzny',
    desc: 'Profesjonalny skład — łamanie tekstu, hierarchia typograficzna, kerning, leading, wdowy i sieroty, paginacja. Pracujemy z LaTeX/Quarto (publikacje techniczne, raporty z danymi, precyzja typograficzna, publikacje wizualne, lifestyle). Skład na poziomie wydawnictwa, nie „eksport z Worda".',
    tag: 'Skład'
  },
  {
    num: '06',
    title: 'Rendering i dostawa',
    desc: 'Rendering do finalnych formatów: PDF (druk + ekran, z profilem kolorów CMYK/RGB), EPUB (czytniki, Apple Books — reflowable layout), MOBI/KF8 (Amazon Kindle). Testy na urządzeniach, optymalizacja rozmiaru pliku, embedding fontów. Dostawa plików finalnych + źródłowych do przyszłych edycji.',
    tag: 'Rendering'
  }
];

// ── Tech stack ──
const techStack = [
  {
    name: 'LaTeX / Quarto',
    desc: 'Publikacje techniczne, akademickie i raporty z danymi. Precyzja typograficzna na poziomie profesjonalnego składu. Idealne, gdy ebook zawiera kod, formuły, tabele z danymi lub wymaga perfekcyjnej paginacji.',
    type: 'Skład techniczny'
  },  
  {
    name: 'Pipeline renderingu',
    desc: 'Własne narzędzia do automatycznego renderowania z jednego źródła do wielu formatów — PDF, EPUB, MOBI, HTML. Eliminuje ręczne konwersje i zapewnia spójność między formatami. Aktualizacja treści = jedno źródło, wiele outputów.',
    type: 'Automatyzacja'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Wszystko pod jednym dachem',
    desc: 'Nie musisz koordynować copywritera, redaktora, grafika i składacza. Jeden zespół prowadzi projekt od briefu po gotowy plik — strategia, pisanie, redakcja, design, skład, rendering. Jeden punkt kontaktu, jeden harmonogram, zero luk między etapami.'
  },
  {
    title: 'Skład na poziomie wydawnictwa',
    desc: 'Profesjonalny skład typograficzny — nie „eksport z Google Docs z dodaną okładką". LaTeX dla precyzji i swobody wizualnej. Kerning, leading, hierarchia, paginacja, wdowy i sieroty — detale, które odróżniają amatorską publikację od profesjonalnej.'
  },
  {
    title: 'Wieloformatowy rendering',
    desc: 'Jeden ebook, wiele formatów — PDF do pobrania ze strony, EPUB na czytniki, MOBI na Kindle, HTML do embedowania. Własne pipeline\'y renderingu zapewniają spójność między formatami i eliminują ręczne konwersje, które generują błędy.'
  },
  {
    title: 'Ebook jako element systemu',
    desc: 'Nie tworzymy ebooka w próżni. Ebook to element większego systemu — lead magnet na landing page, gated content w sekwencji email, materiał do repurposingu na blog i social media. Projektujemy ebooki, które pracują w Twoim lejku marketingowym.'
  }
];

// ── Related ──
const related = [
  { title: 'Artykuły blogowe', href: '/uslugi/artykuly-blogowe/', desc: 'Treści blogowe do repurposingu w ebooki' },
  { title: 'Email marketing', href: '/uslugi/email-marketing/', desc: 'Dystrybucja ebooków jako lead magnety' },
  { title: 'Landing page', href: '/uslugi/landing-page/', desc: 'Strony lądowania do pobierania ebooków' },
  { title: 'Strategia contentowa', href: '/uslugi/strategia-content-marketingowa/', desc: 'Ebook jako element strategii content marketingowej' }
];
---

<BaseLayout
  title="Ebooki — Tworzenie Ebooków na Zamówienie | eCopywriting.pl"
  description="Profesjonalne tworzenie ebooków na zamówienie. Pisanie, redakcja, projekt graficzny, skład typograficzny (LaTeX) i rendering do PDF, EPUB, MOBI. Lead magnety, publikacje eksperckie, raporty. Wycena w 24h."
  keywords="tworzenie ebooków, tworzenie ebooków na zamówienie, tworzenie ebooków na zlecenie, pisanie ebooków, składanie ebooków, ebook na zamówienie, ebook lead magnet, skład ebooka, rendering ebooka"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/ebooki/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Ebooki</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Ebooki & Publishing</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Tworzenie ebooków —<br><em>od briefu po gotowy plik</em>
      </h1>
      <p class="srv-hero__subtitle">
        Kompleksowe tworzenie ebooków na zamówienie — planujemy, piszemy, redagujemy,
        projektujemy, składamy i&nbsp;renderujemy do&nbsp;PDF, EPUB i&nbsp;MOBI. Jeden
        zespół, zero luk między etapami, profesjonalny rezultat.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#proces" class="srv-hero__cta-secondary">Jak tworzymy ebooki</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>6 etapów</strong> w jednym zespole</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>LaTeX</strong> — profesjonalny skład</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>PDF + EPUB + MOBI</strong> w standardzie</div>
      </div>
    </div>
  </section>

  <!-- FULL-STACK PIPELINE — the key differentiator -->
  <section class="srv-pipeline" id="proces" aria-labelledby="srv-pipeline-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Kompleksowy proces"
          title="6 etapów — jeden zespół, zero luk"
          subtitle="Tworzenie ebooka na zamówienie to nie &bdquo;napisanie tekstu i eksport do PDF&rdquo;. To 6 odrębnych etapów wymagających różnych kompetencji. Nasz zespół pokrywa każdy z&nbsp;nich — od&nbsp;strategii po rendering."
        />
      </div>

      <div class="srv-pipeline__timeline">
        {pipeline.map((step, i) => (
          <div class="srv-pipeline__step reveal" style={`--delay: ${i * 0.06}s`}>
            <div class="srv-pipeline__step-header">
              <span class="srv-pipeline__step-num">{step.num}</span>
              <span class="srv-pipeline__step-tag">{step.tag}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EBOOK TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co tworzymy"
          title="Rodzaje ebooków na zamówienie"
          subtitle="Od kompaktowego lead magnetu po 150-stronowy poradnik. Dobieramy format, objętość i&nbsp;głębokość do celu — pozyskiwanie leadów, budowanie autorytetu, edukacja czy sprzedaż."
        />
      </div>
      <div class="srv-types__grid">
        {ebookTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-best">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
              {d.best}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TECH STACK — publishing tools -->
  <section class="srv-tech" id="narzedzia" aria-labelledby="srv-tech-title">
    <div class="container">
      <div class="srv-tech__inner reveal">
        <span class="srv-tech__label">Nasz stack publishingowy</span>
        <h2 id="srv-tech-title" class="srv-tech__title">
          Profesjonalne narzędzia —<br><em>skład na poziomie wydawnictwa</em>
        </h2>
        <p class="srv-tech__desc">
          Nie eksportujemy z Google Docs i nie nazywamy tego ebookiem.
          Pracujemy z profesjonalnymi narzędziami DTP i publishing — dobranymi
          do typu publikacji, nie na zasadzie „co mamy pod ręką".
        </p>

        <div class="srv-tech__grid">
          {techStack.map((t) => (
            <div class="srv-tech__card">
              <span class="srv-tech__card-type">{t.type}</span>
              <h3>{t.name}</h3>
              <p>{t.desc}</p>
            </div>
          ))}
        </div>

        <div class="srv-tech__formats">
          <span class="srv-tech__formats-label">Formaty wyjściowe:</span>
          <div class="srv-tech__formats-list">
            <span class="srv-tech__format">PDF <small>(druk + ekran)</small></span>
            <span class="srv-tech__format">EPUB <small>(czytniki)</small></span>
            <span class="srv-tech__format">MOBI / KF8 <small>(Kindle)</small></span>
            <span class="srv-tech__format">HTML <small>(web embed)</small></span>
            <span class="srv-tech__format">Pliki źródłowe <small>(edycja)</small></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Full-stack publishing, nie &bdquo;pisanie ebooków&rdquo;"
          subtitle="Na rynku nie brakuje copywriterów, którzy &bdquo;napiszą ebooka&rdquo;. Oto dlaczego warto zlecić tworzenie ebooka zespołowi, który pokrywa cały łańcuch — od&nbsp;strategii po rendering."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOLO LAYOUT OPTION -->
  <section class="srv-layout-only" aria-labelledby="srv-layout-title">
    <div class="container">
      <div class="srv-layout-only__inner reveal">
        <span class="srv-layout-only__label">Masz już tekst?</span>
        <h2 id="srv-layout-title" class="srv-layout-only__title">
          Sam skład i&nbsp;rendering —<br><em>bez pisania od zera</em>
        </h2>
        <p class="srv-layout-only__desc">
          Jeśli masz gotowy tekst, ale potrzebujesz profesjonalnego składu —
          przejmujemy od etapu redakcji. Dostarczasz treść w dowolnym formacie
          (Google Docs, Word, Markdown, LaTeX), a&nbsp;my zajmujemy się resztą:
        </p>
        <div class="srv-layout-only__steps">
          <div class="srv-layout-only__step">
            <span class="srv-layout-only__step-num">1</span>
            <span>Redakcja językowa i&nbsp;merytoryczna</span>
          </div>
          <div class="srv-layout-only__step-arrow" aria-hidden="true">→</div>
          <div class="srv-layout-only__step">
            <span class="srv-layout-only__step-num">2</span>
            <span>Projekt graficzny i&nbsp;kreacja</span>
          </div>
          <div class="srv-layout-only__step-arrow" aria-hidden="true">→</div>
          <div class="srv-layout-only__step">
            <span class="srv-layout-only__step-num">3</span>
            <span>Skład typograficzny</span>
          </div>
          <div class="srv-layout-only__step-arrow" aria-hidden="true">→</div>
