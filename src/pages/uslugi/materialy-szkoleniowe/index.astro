---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie materiałów szkoleniowych?',
    a: 'Cena zależy od objętości, złożoności tematu i formatu. Krótki moduł szkoleniowy (10–20 stron, jeden temat) to 2000–5000 zł. Komplet materiałów do szkolenia (podręcznik + ćwiczenia + prezentacja, 40–80 stron) to 5000–12 000 zł. Pełny program szkoleniowy (wielomodułowy, 100–300+ stron, różne formaty) to 12 000–35 000 zł. W cenę wliczone: struktura dydaktyczna, pisanie, redakcja, projekt graficzny, skład i rendering.'
  },
  {
    q: 'Jakie formaty materiałów szkoleniowych tworzycie?',
    a: 'Tworzymy materiały w dowolnych formatach: podręczniki szkoleniowe (PDF/druk), zeszyty ćwiczeń (PDF z formularzami do wypełnienia), prezentacje (PowerPoint/Google Slides/PDF), karty pracy i checklisty, one-pagery i ściągi, materiały do LMS (SCORM-kompatybilne). Dobieramy format do metody szkoleniowej — inny materiał do szkolenia stacjonarnego, inny do e-learningu.'
  },
  {
    q: 'Czy tworzycie materiały pod konkretną platformę LMS?',
    a: 'Tak — dostosowujemy materiały do wymagań Twojego LMS (Moodle, Teachable, Thinkific, LearnDash i inne). Dostarczamy treści w formatach kompatybilnych z platformą — od prostych PDF po moduły z quizami i interaktywnymi elementami. Nasz zespół programistów może też pomóc z technicznym wdrożeniem na platformie.'
  },
  {
    q: 'Czy piszecie materiały szkoleniowe od zera, czy potrzebujecie gotowe treści?',
    a: 'Jedno i drugie. Możemy napisać materiały od zera — na podstawie briefu, rozmów z ekspertami merytorycznymi (SME) i własnego researchu. Możemy też przetworzyć istniejące materiały: uporządkować, zredagować, dodać strukturę dydaktyczną, zaprojektować i złożyć. Często najlepsze efekty daje połączenie — Twoja wiedza ekspercka + nasz warsztat dydaktyczny i redaktorski.'
  },
  {
    q: 'Jak długo trwa stworzenie materiałów szkoleniowych?',
    a: 'Pojedynczy moduł (10–20 stron) to 1–2 tygodnie. Komplet materiałów do szkolenia to 3–5 tygodni. Pełny program wielomodułowy to 6–12 tygodni. Czas zależy od: dostępności ekspertów merytorycznych, złożoności tematu, liczby formatów i rund akceptacji. Przy cyklicznych szkoleniach (onboarding, compliance) rekomendujemy stałą współpracę z kwartalną aktualizacją.'
  },
  {
    q: 'Czy pomagacie z aktualizacją istniejących materiałów?',
    a: 'Tak — przejmujemy istniejące materiały i aktualizujemy: nowe regulacje, zmienione procedury, odświeżony branding, dodatkowe moduły. Jeśli materiały są w złym stanie (niespójne, nieaktualne, amatorski skład), robimy redesign i restrukturyzację. Tworzymy modularną strukturę, która ułatwia przyszłe aktualizacje bez przerabiania całości.'
  },
  {
    q: 'Dla jakich branż tworzycie materiały szkoleniowe?',
    a: 'Pracujemy z firmami z różnych sektorów: IT i SaaS (onboarding produktowy, dokumentacja), finanse i bankowość (compliance, procedury), produkcja i przemysł (BHP, procedury operacyjne), HR (onboarding pracowników, szkolenia miękkie), sprzedaż (playbooki, metodologie), healthcare (procedury, certyfikacje). Format materiałów szkoleniowych sprawdza się wszędzie, gdzie wiedza musi być przekazana systematycznie i powtarzalnie.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/#service",
      "name": "Materiały szkoleniowe",
      "description": "Profesjonalne tworzenie materiałów szkoleniowych. Podręczniki, zeszyty ćwiczeń, prezentacje, karty pracy, materiały e-learningowe. Struktura dydaktyczna, copywriting, design, skład i rendering.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Training materials creation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/",
      "name": "Materiały Szkoleniowe — Tworzenie Materiałów Szkoleniowych na Zamówienie | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie materiałów szkoleniowych. Podręczniki, ćwiczenia, prezentacje, e-learning. Struktura dydaktyczna, pisanie, design, skład. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Materiały szkoleniowe", "item": "https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Material types ──
const materialTypes = [
  {
    title: 'Podręczniki szkoleniowe',
    desc: 'Kompleksowe materiały do nauki — teoria, przykłady, case studies, podsumowania rozdziałów. Struktura modułowa z jasną progresją trudności. Od 20 do 300+ stron. Format do druku i/lub PDF.',
    format: 'PDF / druk / EPUB',
    icon: '📖'
  },
  {
    title: 'Zeszyty ćwiczeń (workbooki)',
    desc: 'Materiały do pracy samodzielnej lub warsztatowej — ćwiczenia, pytania refleksyjne, szablony, checklisty. PDF z interaktywnymi formularzami do wypełniania na ekranie lub drukowania. Uzupełnienie podręcznika.',
    format: 'PDF interaktywny / druk',
    icon: '✏️'
  },
  {
    title: 'Prezentacje szkoleniowe',
    desc: 'Slajdy do prowadzenia szkoleń stacjonarnych i online — speaker notes, struktura dydaktyczna, wizualizacje danych, ćwiczenia grupowe. PowerPoint, Google Slides lub PDF. Gotowe do użycia przez trenera.',
    format: 'PPTX / Google Slides / PDF',
    icon: '📊'
  },
  {
    title: 'Materiały onboardingowe',
    desc: 'Kompletne pakiety dla nowych pracowników lub klientów — welcome book, przewodnik po firmie/produkcie, FAQ, procedury, checklisty pierwszych dni/tygodni. Systematyzują onboarding i redukują czas wdrożenia.',
    format: 'PDF / LMS / druk',
    icon: '🚀'
  },
  {
    title: 'Playbooki i SOP',
    desc: 'Standardowe procedury operacyjne i playbooki sprzedażowe/marketingowe — step-by-step instrukcje, decision trees, scenariusze, skrypty. Dokumenty, które pozwalają skalować procesy bez utraty jakości.',
    format: 'PDF / wiki / Notion',
    icon: '📋'
  },
  {
    title: 'Materiały e-learningowe',
    desc: 'Treści do platform LMS — moduły tekstowe, quizy, scenariusze, skrypty do video. Kompatybilne z Moodle, Teachable, Thinkific i innymi. Struktura mikro-learningu: krótkie moduły, jasne cele, natychmiastowa weryfikacja.',
    format: 'LMS / SCORM / HTML',
    icon: '💻'
  }
];

// ── Use cases / scenarios ──
const useCases = [
  {
    scenario: 'Onboarding pracowników',
    problem: 'Każdy nowy pracownik jest wdrażany inaczej, wiedza przekazywana ustnie, brak standardu',
    solution: 'Welcome book + checklista pierwszych 90 dni + podręcznik produktowy + FAQ',
    result: 'Skrócenie onboardingu o 40%, jednolity standard, samodzielność nowego pracownika szybciej'
  },
  {
    scenario: 'Szkolenie produktowe',
    problem: 'Handlowcy nie znają produktu, prezentacje nieaktualne, każdy sprzedaje po swojemu',
    solution: 'Playbook sprzedażowy + karty produktowe + prezentacja + zeszyt ćwiczeń z obiekcjami',
    result: 'Spójny przekaz, krótszy cykl sprzedaży, wyższa konwersja w rozmowach handlowych'
  },
  {
    scenario: 'Compliance i regulacje',
    problem: 'Zmieniające się regulacje, pracownicy nie znają procedur, audyty wykazują braki',
    solution: 'Podręcznik compliance + checklisty + moduły e-learningowe z quizami + certyfikaty',
    result: 'Zgodność z regulacjami, udokumentowane szkolenia, gotowość na audyty'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Analiza potrzeb i brief',
    desc: 'Definiujemy: kto jest odbiorcą, co ma umieć po szkoleniu, jaki format i kanał dostarczenia. Analiza istniejących materiałów, rozmowy z ekspertami merytorycznymi (SME), identyfikacja luk wiedzy. Plan modułów i struktura dydaktyczna do akceptacji.'
  },
  {
    num: '02',
    title: 'Struktura dydaktyczna',
    desc: 'Projektowanie architektury szkolenia — moduły, cele uczenia się, progresja trudności, metody weryfikacji. Każdy moduł: cel → teoria → przykład → ćwiczenie → podsumowanie. Instructional design, który angażuje i utrwala wiedzę, nie męczy ścianami tekstu.'
  },
  {
    num: '03',
    title: 'Pisanie i redakcja',
    desc: 'Pisanie treści w języku zrozumiałym dla odbiorcy — nie żargon eksperta, a jasne wyjaśnienia z przykładami z życia. Dwuetapowa redakcja: merytoryczna (z SME) i językowa (klarowność, spójność, gramatyka). Ćwiczenia, pytania kontrolne, podsumowania.'
  },
  {
    num: '04',
    title: 'Design, skład i rendering',
    desc: 'Projekt graficzny dopasowany do kontekstu (korporacyjny, edukacyjny, tech). Skład typograficzny z profesjonalnym DTP. Rendering do wybranych formatów: PDF (druk/ekran), PPTX, interaktywny PDF z formularzami, moduły LMS. Pliki źródłowe do przyszłych edycji.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Instructional design, nie tylko copywriting',
    desc: 'Materiały szkoleniowe to nie „długi tekst na temat". Każdy moduł ma jasny cel uczenia się, strukturę dydaktyczną, ćwiczenia i weryfikację. Projektujemy doświadczenie edukacyjne — cel → teoria → przykład → praktyka → podsumowanie — nie ścianę tekstu z nagłówkami.'
  },
  {
    title: 'Język ucznia, nie eksperta',
    desc: 'Największy problem materiałów szkoleniowych pisanych przez ekspertów? Są pisane językiem eksperta. My piszemy językiem odbiorcy — jasne wyjaśnienia, analogie z życia, przykłady z kontekstu. Jeśli nowy pracownik nie zrozumie tekstu bez pomocy trenera — materiał jest zły.'
  },
  {
    title: 'Full-stack: od briefu po gotowe materiały',
    desc: 'Jeden zespół prowadzi projekt od analizy potrzeb po rendering — structure, pisanie, redakcja z ekspertami, design, skład, pliki gotowe do druku/LMS/prezentacji. Zero koordynacji między copywriterem, grafikiem i „kimś od PowerPointa".'
  },
  {
    title: 'Modularność i aktualizacje',
    desc: 'Projektujemy materiały modularnie — zmiana procedury nie wymaga przerabiania 200 stron, a podmianę jednego modułu. Pliki źródłowe w przejrzystej strukturze, naming convention, version control. Aktualizacja w godzinach, nie tygodniach.'
  }
];

// ── Related ──
const related = [
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Publikacje cyfrowe i lead magnety edukacyjne' },
  { title: 'Prezentacje', href: '/uslugi/prezentacje/', desc: 'Slajdy do prezentacji i wystąpień' },
  { title: 'Dokumentacja techniczna', href: '/uslugi/dokumentacja-techniczna/', desc: 'Dokumentacja produktowa i API' },
  { title: 'Katalogi i broszury', href: '/uslugi/katalogi-broszury/', desc: 'Materiały drukowane i cyfrowe' }
];
---

<BaseLayout
  title="Materiały Szkoleniowe — Tworzenie Materiałów Szkoleniowych na Zamówienie | eCopywriting.pl"
  description="Profesjonalne tworzenie materiałów szkoleniowych. Podręczniki, zeszyty ćwiczeń, prezentacje, playbooki, materiały onboardingowe i e-learningowe. Instructional design, copywriting, skład, rendering. Wycena w 24h."
  keywords="materiały szkoleniowe, tworzenie materiałów szkoleniowych, materiały szkoleniowe na zamówienie, podręcznik szkoleniowy, materiały onboardingowe, materiały e-learningowe, playbook, SOP, zeszyt ćwiczeń"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/materialy-szkoleniowe/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Materiały szkoleniowe</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Szkolenia & E-learning</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Materiały szkoleniowe,<br>z&nbsp;których <em>ludzie się uczą</em>
      </h1>
      <p class="srv-hero__subtitle">
        Podręczniki, workbooki, prezentacje, playbooki, materiały onboardingowe
        i&nbsp;e-learningowe. Instructional design, copywriting, projekt graficzny,
        skład i&nbsp;rendering — od&nbsp;analizy potrzeb po&nbsp;gotowe pliki.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#rodzaje" class="srv-hero__cta-secondary">Rodzaje materiałów</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Instructional design</strong> nie ściana tekstu</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>PDF + PPTX + LMS</strong> w standardzie</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Modularnie</strong> — łatwe aktualizacje</div>
      </div>
    </div>
  </section>

  <!-- USE CASES — scenario-based -->
  <section class="srv-cases" aria-labelledby="srv-cases-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Zastosowania"
          title="Materiały szkoleniowe rozwiązują realne problemy"
          subtitle="Nie tworzymy materiałów &bdquo;bo trzeba mieć szkolenie&rdquo;. Projektujemy je pod konkretny problem biznesowy — i&nbsp;mierzymy efekt."
        />
      </div>

      <div class="srv-cases__grid">
        {useCases.map((c, i) => (
          <div class="srv-cases__card reveal" style={`--delay: ${i * 0.08}s`}>
            <span class="srv-cases__card-scenario">{c.scenario}</span>
            <div class="srv-cases__card-row">
              <span class="srv-cases__card-label">Problem</span>
              <p>{c.problem}</p>
            </div>
            <div class="srv-cases__card-row">
              <span class="srv-cases__card-label srv-cases__card-label--accent">Rozwiązanie</span>
              <p>{c.solution}</p>
            </div>
            <div class="srv-cases__card-result">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              <span>{c.result}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MATERIAL TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co tworzymy"
          title="Rodzaje materiałów szkoleniowych"
          subtitle="Od 10-stronowego one-pagera po 300-stronowy program wielomodułowy. Dobieramy format do metody szkoleniowej, kanału i&nbsp;grupy docelowej."
        />
      </div>
      <div class="srv-types__grid">
        {materialTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-format">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
              {d.format}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIDACTIC STRUCTURE -->
  <section class="srv-didactic" id="struktura" aria-labelledby="srv-didactic-title">
    <div class="container">
      <div class="srv-didactic__inner reveal">
        <span class="srv-didactic__label">Nasze podejście</span>
        <h2 id="srv-didactic-title" class="srv-didactic__title">
          Struktura dydaktyczna —<br><em>każdy moduł uczy, nie nuży</em>
        </h2>
        <p class="srv-didactic__desc">
          Materiały szkoleniowe pisane przez eksperta to często „brain dump" — wszystko,
          co wie, wylane na papier. Nasze podejście to instructional design: każdy moduł
          ma jasny cel i&nbsp;sprawdzoną strukturę, która angażuje i&nbsp;utrwala wiedzę.
        </p>

        <div class="srv-didactic__flow">
          <div class="srv-didactic__step">
            <span class="srv-didactic__step-num">1</span>
            <div>
              <strong>Cel uczenia się</strong>
              <p>„Po tym module będziesz umiał..." — jasna obietnica wartości</p>
            </div>
          </div>
          <div class="srv-didactic__step">
            <span class="srv-didactic__step-num">2</span>
            <div>
              <strong>Teoria z kontekstem</strong>
              <p>Wiedza podana z analogiami i przykładami z życia odbiorcy</p>
            </div>
          </div>
          <div class="srv-didactic__step">
            <span class="srv-didactic__step-num">3</span>
            <div>
              <strong>Przykład / case study</strong>
              <p>Konkretne zastosowanie teorii — „oto jak to wygląda w praktyce"</p>
            </div>
          </div>
          <div class="srv-didactic__step">
            <span class="srv-didactic__step-num">4</span>
            <div>
              <strong>Ćwiczenie / praktyka</strong>
              <p>Zadanie do wykonania — utrwalenie przez działanie, nie czytanie</p>
            </div>
          </div>
          <div class="srv-didactic__step">
            <span class="srv-didactic__step-num">5</span>
            <div>
              <strong>Podsumowanie i weryfikacja</strong>
              <p>Key takeaways + pytanie kontrolne / quiz. Czy cel został osiągnięty?</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od analizy potrzeb po gotowe materiały"
          subtitle="Nasz proces łączy instructional design z profesjonalnym publishingiem. Analiza → struktura → pisanie → design + skład → rendering do wybranych formatów."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Materiały szkoleniowe od copywriterów, nie&nbsp;trenerów"
