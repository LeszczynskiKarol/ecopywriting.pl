---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje obsługa email marketingu?',
    a: 'Cena zależy od zakresu: pojedynczy newsletter to 300–600 zł, sekwencja powitalna (5–7 maili) to 1500–3000 zł, a stała obsługa email marketingu (strategia + 4–8 kampanii miesięcznie) to 2000–5000 zł/miesiąc. Przy kompleksowych projektach z automatyzacjami i segmentacją wyceniamy indywidualnie. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Na jakich platformach pracujecie?',
    a: 'Pracujemy ze wszystkimi popularnymi platformami: Mailchimp, MailerLite, ConvertKit, ActiveCampaign, GetResponse, Klaviyo, HubSpot, Brevo (dawniej Sendinblue). Jeśli korzystasz z innej platformy — dostosujemy się. Nasz zespół programistów potrafi też zintegrować narzędzie email z Twoim CRM, e-commerce czy stroną.'
  },
  {
    q: 'Czy zajmujecie się tylko pisaniem maili, czy też strategią?',
    a: 'Jedno i drugie. Możemy napisać pojedynczy newsletter na Twój temat, ale najlepsze efekty daje współpraca strategiczna — audyt obecnego email marketingu, segmentacja listy, zaplanowanie sekwencji automatycznych, kalendarz kampanii i systematyczna obsługa. Strategia zamienia losowe wysyłki w system generowania przychodów.'
  },
  {
    q: 'Czy pomagacie w budowaniu listy mailingowej?',
    a: 'Tak — projektujemy lead magnety (ebooki, checklisty, szablony), formularze zapisu, pop-upy i landing page zoptymalizowane pod konwersję. Piszemy copy, a nasz zespół programistów wdraża formularze i integruje je z platformą email. Pomagamy też w strategii pozyskiwania subskrybentów z bloga, social media i płatnych kampanii.'
  },
  {
    q: 'Jak mierzycie efektywność kampanii email?',
    a: 'Śledzimy kluczowe metryki: open rate, click-through rate (CTR), conversion rate, unsubscribe rate i revenue per email. Przy e-commerce mierzymy bezpośredni przychód z kampanii. Raportujemy wyniki co miesiąc z rekomendacjami optymalizacji. A/B testujemy tematy, treści i CTA, żeby systematycznie poprawiać wyniki.'
  },
  {
    q: 'Jak często powinien wychodzić newsletter?',
    a: 'Optymalna częstotliwość zależy od branży i oczekiwań subskrybentów. Dla większości firm B2B to 1–2 razy w tygodniu, dla e-commerce 2–4 razy. Ważniejsza od częstotliwości jest regularność i wartość — lepiej wysyłać raz w tygodniu coś wartościowego niż codziennie coś bezwartościowego. Pomagamy ustalić optymalną kadencję.'
  },
  {
    q: 'Czy możecie przejąć obsługę istniejącego email marketingu?',
    a: 'Tak — zaczynamy od audytu obecnego stanu: analiza listy, segmentacji, dotychczasowych kampanii, automatyzacji i wyników. Na tej podstawie przygotowujemy plan optymalizacji i płynnie przejmujemy obsługę. Nie zaczynamy od zera — budujemy na tym, co już działa, i naprawiamy to, co nie działa.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/email-marketing/#service",
      "name": "Email marketing",
      "description": "Profesjonalna obsługa email marketingu — newslettery, sekwencje automatyczne, kampanie sprzedażowe. Strategia, copywriting, design, wdrożenie i raportowanie.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Email marketing",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/email-marketing/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/email-marketing/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/email-marketing/",
      "name": "Email Marketing — Newslettery, Sekwencje i Kampanie Mailowe | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalny email marketing. Newslettery, sekwencje powitalne, kampanie sprzedażowe, automatyzacje. Strategia + copywriting + wdrożenie. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/email-marketing/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/email-marketing/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Email marketing", "item": "https://www.ecopywriting.pl/uslugi/email-marketing/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Email types ──
const emailTypes = [
  {
    title: 'Newslettery',
    desc: 'Regularne wysyłki budujące relację z subskrybentami — wartościowe treści, nowości, porady eksperckie. Newsletter, który ludzie otwierają, bo wiedzą, że dostaną coś wartościowego, a nie kolejny spam.',
    metric: 'Średni OR: 25–45%',
    icon: '📬'
  },
  {
    title: 'Sekwencje powitalne',
    desc: 'Automatyczna seria maili po zapisie na listę — od potwierdzenia, przez dostarczenie lead magnetu, po budowanie zaufania i prowadzenie do pierwszego zakupu. 5–7 maili, które zamieniają subskrybenta w klienta.',
    metric: 'Najwyższy OR w email marketingu',
    icon: '👋'
  },
  {
    title: 'Kampanie sprzedażowe',
    desc: 'Sekwencje mailowe pod launch produktu, promocję, Black Friday, wyprzedaż sezonową. Struktura: teaser → oferta → social proof → urgency → last call. Sprawdzone frameworki, które generują przychód na żądanie.',
    metric: 'Bezpośredni revenue z kampanii',
    icon: '💰'
  },
  {
    title: 'Automatyzacje e-commerce',
    desc: 'Maile transakcyjne i behawioralne: porzucony koszyk, przeglądane produkty, cross-sell po zakupie, win-back nieaktywnych klientów, urodziny, rocznice. Raz ustawione — pracują 24/7 bez Twojego udziału.',
    metric: 'Revenue on autopilot',
    icon: '🤖'
  },
  {
    title: 'Drip campaigns / nurturing',
    desc: 'Sekwencje edukacyjne prowadzące lead przez lejek — od świadomości problemu, przez rozważanie rozwiązań, po decyzję zakupową. Każdy mail przesuwa odbiorcę bliżej konwersji z treścią dopasowaną do etapu.',
    metric: 'Lead → klient w autopilot',
    icon: '🌊'
  },
  {
    title: 'Re-engagement i win-back',
    desc: 'Sekwencje odzyskiwania nieaktywnych subskrybentów i klientów. Zanim usuniesz ich z listy — daj im szansę wrócić. Strategicznie zaplanowane kampanie, które odzyskują 5–15% „martwej" bazy.',
    metric: 'Odzyskanie 5–15% nieaktywnych',
    icon: '🔄'
  }
];

// ── Why email ──
const whyEmail = [
  {
    stat: '36:1',
    label: 'ROI z email marketingu',
    desc: 'Każda złotówka zainwestowana w email marketing zwraca średnio 36 zł (wg Litmus). Żaden inny kanał marketingowy nie oferuje takiego zwrotu z inwestycji.'
  },
  {
    stat: '4,4 mld',
    label: 'użytkowników email na świecie',
    desc: 'Email to największy kanał komunikacji cyfrowej — większy niż Facebook, Instagram i TikTok razem wzięte. I w przeciwieństwie do social media, Ty jesteś właścicielem swojej listy.'
  },
  {
    stat: '3×',
    label: 'wyższa konwersja niż social media',
    desc: 'Email generuje 3× więcej konwersji niż social media (wg McKinsey). Odbiorca, który dał Ci swój adres email, jest wielokrotnie bardziej zaangażowany niż follower na Instagramie.'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Audyt i strategia',
    desc: 'Analizujemy obecny stan email marketingu — listę, segmentację, dotychczasowe kampanie, wyniki. Definiujemy cele, grupę docelową, tone of voice. Tworzymy strategię: jakie sekwencje, jakie kampanie, jaka kadencja, jakie KPI.'
  },
  {
    num: '02',
    title: 'Architektura automatyzacji',
    desc: 'Projektujemy mapę automatyzacji — welcome series, nurturing, e-commerce flows, re-engagement. Definiujemy triggery, warunki, segmenty. Wizualna mapa flowów do akceptacji przed wdrożeniem.'
  },
  {
    num: '03',
    title: 'Copywriting i design',
    desc: 'Piszemy treści maili — tematy (subject lines), preheadery, body copy, CTA. Projektujemy szablony dopasowane do Twojej marki. A/B testy tematów i wariantów treści od pierwszej kampanii.'
  },
  {
    num: '04',
    title: 'Wdrożenie techniczne',
    desc: 'Nasz zespół programistów wdraża sekwencje i automatyzacje w Twojej platformie email. Konfigurujemy segmentację, tagi, triggery, integracje z CRM i e-commerce. Testujemy deliverability i renderowanie na różnych klientach pocztowych.'
  },
  {
    num: '05',
    title: 'Wysyłka, analiza, optymalizacja',
    desc: 'Obsługujemy regularne wysyłki lub monitorujemy automatyzacje. Analizujemy wyniki — open rate, CTR, konwersje, revenue. A/B testujemy systematycznie. Raportujemy co miesiąc z konkretnymi rekomendacjami na kolejny okres.'
  }
];

// ── Differentiators ──
const diffs = [
  {
    title: 'Strategia, nie losowe wysyłki',
    desc: 'Nie piszemy „kolejnego newslettera". Projektujemy system — sekwencje, automatyzacje, segmentacja, kalendarz kampanii. Każdy mail ma swoje miejsce w lejku i konkretny cel. Strategia zamienia email w przewidywalny kanał przychodu.'
  },
  {
    title: 'Copy, które otwierają i klikają',
    desc: '15+ lat doświadczenia w copywritingu oznacza, że piszemy tematy maili, które ludzie otwierają, i treści, które prowadzą do kliknięcia. Subject line to najważniejszy tekst w email marketingu — i traktujemy go z taką samą uwagą jak headline na landing page.'
  },
  {
    title: 'Technologia + copywriting',
    desc: 'Programiści w zespole oznaczają, że nie kończymy na tekście w Google Docs. Wdrażamy automatyzacje, konfigurujemy segmentację, integrujemy z CRM i e-commerce, dbamy o deliverability. Jeden dostawca zamiast agencji copywriterskiej + freelancera od Mailchimpa.'
  },
  {
    title: 'Mierzalne wyniki, nie „ładne maile"',
    desc: 'Każda kampania ma przypisane KPI — open rate, CTR, konwersja, revenue. Raportujemy wyniki, A/B testujemy systematycznie i optymalizujemy na podstawie danych. Widzisz, co działa — i ile na tym zarabiasz.'
  }
];

// ── Anatomy ──
const anatomyParts = [
  { label: 'Temat (subject line)', desc: 'Najważniejszy element maila — decyduje o otwarciu. Testujemy 2–3 warianty na każdą kampanię.', highlight: true },
  { label: 'Preheader', desc: 'Tekst widoczny w podglądzie skrzynki. Uzupełnia temat i zwiększa open rate o 10–20%.', highlight: false },
  { label: 'Lead / hook', desc: 'Pierwsze 2 zdania — muszą zatrzymać czytelnika. Personalizacja, pytanie, kontrowersja, historia.', highlight: true },
  { label: 'Body copy', desc: 'Treść główna — krótko, konkretnie, z jednym jasnym przekazem. Jeden mail = jeden cel.', highlight: false },
  { label: 'CTA', desc: 'Wezwanie do działania — widoczne, jednoznaczne, z językiem korzyści. „Odbierz -30%" > „Kliknij tutaj".', highlight: true },
  { label: 'PS / postscriptum', desc: 'Drugie najczęściej czytane miejsce w mailu (po temacie). Idealne na urgency lub alternatywne CTA.', highlight: false }
];

// ── Related ──
const related = [
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe, oferty handlowe, slogany reklamowe' },
  { title: 'Artykuły blogowe', href: '/uslugi/artykuly-blogowe/', desc: 'Eksperckie treści do dystrybucji w newsletterach' },
  { title: 'Landing page', href: '/uslugi/landing-page/', desc: 'Strony lądowania pod kampanie email i lead magnety' },
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Lead magnety przyciągające subskrybentów na listę' }
];
---

<BaseLayout
  title="Email Marketing — Newslettery, Sekwencje i Kampanie Mailowe | eCopywriting.pl"
  description="Profesjonalny email marketing. Newslettery, sekwencje powitalne, kampanie sprzedażowe, automatyzacje e-commerce. Strategia, copywriting, wdrożenie techniczne i raportowanie wyników. Wycena w 24h."
  keywords="email marketing, newsletter, newslettery, kampanie email, sekwencje mailowe, automatyzacje email, email marketing agencja, obsługa email marketingu, copywriting email"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/email-marketing/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Email marketing</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Email & Automatyzacja</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Email marketing, który<br><em>generuje przychód</em>
      </h1>
      <p class="srv-hero__subtitle">
        Newslettery, sekwencje automatyczne, kampanie sprzedażowe — strategia, copywriting
        i&nbsp;wdrożenie techniczne w&nbsp;jednym zespole. Maile, które ludzie otwierają,
        klikają i&nbsp;kupują.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#uslugi" class="srv-hero__cta-secondary">Co robimy</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Strategia</strong> + copy + wdrożenie</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>A/B testy</strong> od pierwszej kampanii</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>ROI</strong> mierzony w złotówkach</div>
      </div>
    </div>
  </section>

  <!-- WHY EMAIL — ROI stats -->
  <section class="srv-roi" aria-label="Dlaczego email marketing">
    <div class="container">
      <div class="srv-roi__grid reveal">
        {whyEmail.map((r) => (
          <div class="srv-roi__card">
            <div class="srv-roi__stat">
              <span class="srv-roi__stat-value">{r.stat}</span>
              <span class="srv-roi__stat-label">{r.label}</span>
            </div>
            <p class="srv-roi__desc">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EMAIL TYPES -->
  <section class="srv-types" id="uslugi" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co robimy"
          title="Rodzaje kampanii i&nbsp;automatyzacji email"
          subtitle="Od jednorazowego newslettera po kompleksowy system automatyzacji e-commerce. Dobieramy typ kampanii do celu — budowanie relacji, sprzedaż, retencja czy odzyskiwanie klientów."
        />
      </div>
      <div class="srv-types__grid">
        {emailTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-metric">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
              {d.metric}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ANATOMY OF A GREAT EMAIL -->
  <section class="srv-anatomy" id="anatomia" aria-labelledby="srv-anatomy-title">
    <div class="container">
      <div class="srv-anatomy__inner reveal">
        <span class="srv-anatomy__label">Nasze podejście</span>
        <h2 id="srv-anatomy-title" class="srv-anatomy__title">Anatomia maila,<br>który <em>konwertuje</em></h2>
        <p class="srv-anatomy__desc">
          Każdy element maila ma swoją funkcję. Optymalizujemy każdy z nich osobno
          — od tematu po PS — i testujemy warianty na prawdziwych odbiorcach.
        </p>

        <div class="srv-anatomy__mail">
          {anatomyParts.map((part) => (
            <div class={`srv-anatomy__part ${part.highlight ? 'srv-anatomy__part--hl' : ''}`}>
              <span class="srv-anatomy__part-label">{part.label}</span>
              <span class="srv-anatomy__part-desc">{part.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od audytu po&nbsp;miesięczne raportowanie"
          subtitle="Nasz proces obejmuje całość — od strategii i&nbsp;architektury automatyzacji, przez copywriting i&nbsp;design, po wdrożenie techniczne i&nbsp;optymalizację na&nbsp;podstawie danych."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Email marketing oparty na&nbsp;strategii i&nbsp;danych"
          subtitle="Na rynku nie brakuje freelancerów od Mailchimpa. Oto dlaczego warto pracować z&nbsp;agencją, która łączy copywriting, technologię i&nbsp;analitykę."
        />
      </div>
      <div class="srv-benefits__grid">
        {diffs.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PLATFORMS -->
  <section class="srv-platforms" aria-label="Platformy email marketing">
    <div class="container">
      <div class="srv-platforms__inner reveal">
        <span class="srv-platforms__label">Platformy</span>
        <h2 class="srv-platforms__title">Pracujemy z Twoim narzędziem</h2>
        <p class="srv-platforms__desc">
          Nie narzucamy platformy. Wdrażamy i optymalizujemy email marketing
          na narzędziu, z którego już korzystasz — lub pomagamy wybrać najlepsze.
        </p>
        <div class="srv-platforms__list">
          <span class="srv-platforms__item">Mailchimp</span>
          <span class="srv-platforms__item">MailerLite</span>
          <span class="srv-platforms__item">ConvertKit</span>
          <span class="srv-platforms__item">ActiveCampaign</span>
          <span class="srv-platforms__item">GetResponse</span>
          <span class="srv-platforms__item">Klaviyo</span>
          <span class="srv-platforms__item">HubSpot</span>
          <span class="srv-platforms__item">Brevo</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading label="FAQ" title="Najczęściej zadawane pytania" subtitle="Odpowiedzi na pytania o&nbsp;email marketingu, które słyszymy najczęściej." />
      </div>
      <div class="srv-faq__list">
        {faqs.map((faq, i) => (
          <details class="srv-faq__item reveal" style={`--delay: ${i * 0.04}s`}>
            <summary class="srv-faq__question">
              <span>{faq.q}</span>
              <svg class="srv-faq__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="srv-faq__answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="srv-related" id="powiazane">
