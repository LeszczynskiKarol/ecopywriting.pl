---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie white papera?',
    a: 'Cena zależy od złożoności tematu, objętości i zakresu prac. Kompaktowy white paper (10–15 stron, jeden problem, jedno rozwiązanie) to 4000–8000 zł. White paper ekspercki (15–30 stron, pogłębiony research, dane, wywiady) to 8000–15 000 zł. W cenę wliczone: strategia, research, pisanie, redakcja merytoryczna i językowa, projekt graficzny, skład typograficzny i rendering do PDF/EPUB. Wycenę przygotowujemy w 24h.'
  },
  {
    q: 'Czym white paper różni się od ebooka?',
    a: 'White paper to dokument ekspercki o jednym, konkretnym problemie — z analizą, danymi i propozycją rozwiązania. Format typowy dla B2B, SaaS i enterprise. Ebook jest bardziej ogólny — poradnik, przewodnik, raport. White paper jest bardziej techniczny, bardziej skoncentrowany i bardziej perswazyjny. Ebook buduje awareness, white paper przesuwa lead w lejku sprzedażowym.'
  },
  {
    q: 'Jak długo trwa stworzenie white papera?',
    a: 'Kompaktowy white paper (10–15 stron) to 2–3 tygodnie. Ekspercki (15–30 stron z pogłębionym researchem, wywiadami, danymi branżowymi) to 3–5 tygodni. Czas obejmuje: brief, research, pisanie, redakcję dwuetapową, projekt graficzny, skład i rendering. Przy pilnych projektach oferujemy tryb ekspresowy.'
  },
  {
    q: 'Czy potrzebuję eksperckiej wiedzy, żeby zlecić white paper?',
    a: 'Nie musisz być ekspertem w temacie. Nasz proces obejmuje research i wywiady z ekspertami — Twoimi lub zewnętrznymi. Potrzebujemy od Ciebie: problemu, który white paper ma adresować, grupy docelowej i celu biznesowego. Resztę — research, strukturę, argumentację, dane — przygotowujemy my. Ale jeśli masz ekspertów w firmie, chętnie z nimi porozmawiamy.'
  },
  {
    q: 'W jakich formatach dostarczacie gotowy white paper?',
    a: 'Standardowo dostarczamy PDF (ekran + opcjonalnie druk) i EPUB. Na życzenie: MOBI/KF8, HTML i pliki źródłowe (InDesign, Figma, LaTeX/Quarto) do przyszłych edycji. PDF to dominujący format dystrybucji white paperów — zoptymalizowany pod pobieranie ze strony i forwarding mailem.'
  },
  {
    q: 'Czy white paper może być gated content na stronie?',
    a: 'Tak — i to najczęstsze zastosowanie. White paper jako gated content (treść za formularzem) to jeden z najskuteczniejszych lead magnetów w B2B. Pomagamy też z landing page, formularzem, integracją z CRM/platformą email i sekwencją nurturingową po pobraniu. White paper + landing page + follow-up = kompletny lejek B2B.'
  },
  {
    q: 'Dla jakich branż tworzycie white papers?',
    a: 'Najczęściej pracujemy z firmami z sektorów: SaaS i technologia, fintech i finanse, cyberbezpieczeństwo, healthcare i medtech, przemysł i manufacturing, HR i rekrutacja. Ale format white paper sprawdza się wszędzie, gdzie decyzje zakupowe są złożone, długie i wymagają edukacji. Jeśli Twój klient musi zrozumieć problem, zanim kupi rozwiązanie — white paper jest idealnym narzędziem.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/white-papers/#service",
      "name": "White papers",
      "description": "Profesjonalne tworzenie white paperów na zamówienie. Research, pisanie, redakcja, projekt graficzny, skład typograficzny i rendering do PDF/EPUB. Dokumenty eksperckie dla B2B, SaaS i enterprise.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "White paper creation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/white-papers/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/white-papers/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/white-papers/",
      "name": "White Papers — Tworzenie White Paperów na Zamówienie | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie white paperów. Research, pisanie, redakcja, skład, rendering PDF. Dokumenty eksperckie dla B2B i SaaS. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/white-papers/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/white-papers/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "White papers", "item": "https://www.ecopywriting.pl/uslugi/white-papers/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── White paper anatomy ──
const anatomy = [
  { label: 'Tytuł i streszczenie', desc: 'Hook, który zatrzymuje i executive summary dla tych, którzy skanują. Tytuł adresuje konkretny problem — nie „Wszystko o AI", a „Jak AI redukuje czas onboardingu o 60%".', highlight: true },
  { label: 'Problem', desc: 'Precyzyjne zdefiniowanie problemu, który white paper adresuje. Dane, skala, konsekwencje. Czytelnik musi poczuć: „to jest mój problem".', highlight: false },
  { label: 'Kontekst i analiza', desc: 'Tło branżowe, dotychczasowe podejścia, dlaczego nie działają. Research, dane z rynku, cytaty ekspertów. Budowanie autorytetu i zaufania.', highlight: true },
  { label: 'Rozwiązanie', desc: 'Proponowane podejście — nie sprzedażowo, a edukacyjnie. Framework, metodologia, technologia. „Oto jak firmy rozwiązują ten problem" — z Twoim produktem jako jedną z opcji.', highlight: false },
  { label: 'Dowody i case studies', desc: 'Dane, wyniki, przykłady wdrożeń. Konkretne liczby zamiast ogólników. „Firma X zredukowała koszty o 35% w 6 miesięcy" > „nasze rozwiązanie jest skuteczne".', highlight: true },
  { label: 'Wnioski i CTA', desc: 'Podsumowanie kluczowych wniosków, następne kroki, wezwanie do działania. Subtelne, ale jednoznaczne — demo, konsultacja, kontakt. Nie „kup teraz", a „porozmawiajmy o Twojej sytuacji".', highlight: false }
];

// ── Where in funnel ──
const funnelPositions = [
  {
    stage: 'Top of funnel',
    title: 'Edukacyjny white paper',
    desc: 'Adresuje problem bez wskazywania konkretnego rozwiązania. Buduje awareness i pozycjonuje firmę jako eksperta. Dystrybuowany jako gated content — email za pobranie. Najszerszy zasięg, najniższy próg wejścia.',
    example: '„5 największych zagrożeń cyberbezpieczeństwa w 2025"'
  },
  {
    stage: 'Middle of funnel',
    title: 'Porównawczy white paper',
    desc: 'Porównuje podejścia do problemu — metodologie, technologie, narzędzia. Edukuje leada w procesie decyzyjnym. Twoje rozwiązanie jest jednym z porównywanych — ale obiektywnie najlepszym. Buduje zaufanie przez transparentność.',
    example: '„Cloud vs On-Premise: Analiza TCO dla firm 50–500 pracowników"'
  },
  {
    stage: 'Bottom of funnel',
    title: 'Techniczny white paper',
    desc: 'Pogłębiona dokumentacja rozwiązania — architektura, integracje, bezpieczeństwo, compliance. Adresuje obiekcje techniczne decision makerów. Ostatni content przed decyzją zakupową — dla CTOs, architektów, zespołów IT.',
    example: '„Architektura zero-trust: Implementacja w środowisku hybrydowym"'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Brief i strategia',
    desc: 'Definiujemy cel biznesowy white papera, grupę docelową, pozycję w lejku, kluczowe przesłanie i ton. Analiza konkurencyjnych white paperów w branży. Struktura i outline do akceptacji — zanim napiszemy pierwsze zdanie.'
  },
  {
    num: '02',
    title: 'Research i wywiady',
    desc: 'Głęboki research tematu — dane branżowe, raporty, badania, źródła akademickie. Wywiady z ekspertami (Twoimi i/lub zewnętrznymi). Zbieramy materiał, który nadaje white paperowi wiarygodność i unikalność. Nie piszemy z głowy — piszemy z danych.'
  },
  {
    num: '03',
    title: 'Pisanie i redakcja',
    desc: 'Pisanie przez copywritera specjalizującego się w B2B i technologii. Dwuetapowa redakcja: merytoryczna (fakty, logika, argumentacja) i językowa (styl, klarowność, precyzja). Tekst do akceptacji przed składem — z jedną rundą poprawek w cenie.'
  },
  {
    num: '04',
    title: 'Design, skład i rendering',
    desc: 'Projekt graficzny (okładka, layout, wykresy, infografiki), skład typograficzny w LaTeX/Quarto lub InDesign/Figma, rendering do PDF i EPUB. Testy na urządzeniach, optymalizacja rozmiaru pliku. Dostawa plików finalnych + źródłowych.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Copywriting B2B — nie content marketing ogólny',
    desc: 'White paper to nie długi artykuł blogowy. Wymaga argumentacji, struktury perswazyjnej, technicznej precyzji i subtelnego pozycjonowania rozwiązania. Piszemy white papers od lat — znamy różnicę między edukacją a sprzedażą w B2B.'
  },
  {
    title: 'Research oparty na danych, nie opiniach',
    desc: 'Każde twierdzenie w white paperze poparte danymi — raporty branżowe, badania, statystyki, cytaty ekspertów. Własne narzędzia AI pozwalają przeskanować setki źródeł i wyciągnąć kluczowe insighty. White paper bez danych to broszura reklamowa.'
  },
  {
    title: 'Full-stack: od briefu po gotowy PDF',
    desc: 'Nie musisz koordynować copywritera, redaktora, grafika i składacza. Jeden zespół prowadzi projekt od briefu po rendering — strategia, research, pisanie, redakcja, design, skład, PDF/EPUB. Jeden punkt kontaktu, zero luk między etapami.'
  },
  {
    title: 'White paper jako element lejka',
    desc: 'Nie tworzymy white papera w próżni. Projektujemy go jako element systemu: gated content na landing page, lead magnet w kampanii, materiał do sekwencji nurturingowej. Pomagamy z landing page, formularzem i follow-up emailami.'
  }
];

// ── Related ──
const related = [
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Publikacje o szerszym zakresie niż white paper' },
  { title: 'Landing page', href: '/uslugi/landing-page/', desc: 'Strona do pobierania white papera' },
  { title: 'Email marketing', href: '/uslugi/email-marketing/', desc: 'Sekwencje nurturingowe po pobraniu' },
  { title: 'SEO Copywriting', href: '/uslugi/seo-copywriting/', desc: 'Treści organiczne wspierające dystrybucję' }
];
---

<BaseLayout
  title="White Papers — Tworzenie White Paperów na Zamówienie | eCopywriting.pl"
  description="Profesjonalne tworzenie white paperów na zamówienie. Research, pisanie, redakcja, projekt graficzny, skład typograficzny i rendering PDF/EPUB. Dokumenty eksperckie dla B2B, SaaS, enterprise. Wycena w 24h."
  keywords="white paper, white paper na zamówienie, tworzenie white papers, pisanie white paper, white paper B2B, white paper SaaS, dokument ekspercki, white paper lead magnet"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/white-papers/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">White papers</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>White Papers & B2B</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        White papers, które<br><em>przesuwają leady w&nbsp;lejku</em>
      </h1>
      <p class="srv-hero__subtitle">
        Eksperckie dokumenty dla B2B, SaaS i&nbsp;enterprise — research, pisanie,
        redakcja, design, skład i&nbsp;rendering w&nbsp;jednym zespole. White paper,
        który edukuje, buduje zaufanie i&nbsp;prowadzi do&nbsp;decyzji zakupowej.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#anatomia" class="srv-hero__cta-secondary">Anatomia white papera</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Research</strong> oparty na danych</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Full-stack</strong> — brief → gotowy PDF</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>B2B</strong> — SaaS, tech, enterprise</div>
      </div>
    </div>
  </section>

  <!-- FUNNEL POSITIONS -->
  <section class="srv-funnel" id="lejek" aria-labelledby="srv-funnel-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Gdzie w lejku"
          title="White paper na każdy etap lejka sprzedażowego"
          subtitle="Nie każdy white paper jest taki sam. Dobieramy typ, ton i&nbsp;głębokość do&nbsp;etapu lejka — od&nbsp;budowania awareness po adresowanie obiekcji technicznych przed zakupem."
        />
      </div>

      <div class="srv-funnel__grid">
        {funnelPositions.map((f, i) => (
          <div class="srv-funnel__card reveal" style={`--delay: ${i * 0.08}s`}>
            <span class="srv-funnel__card-stage">{f.stage}</span>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
            <div class="srv-funnel__card-example">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>{f.example}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ANATOMY -->
  <section class="srv-anatomy" id="anatomia" aria-labelledby="srv-anatomy-title">
    <div class="container">
      <div class="srv-anatomy__inner reveal">
        <span class="srv-anatomy__label">Struktura</span>
        <h2 id="srv-anatomy-title" class="srv-anatomy__title">Anatomia skutecznego<br><em>white papera</em></h2>
        <p class="srv-anatomy__desc">
          Skuteczny white paper to nie artykuł blogowy w PDF. Ma precyzyjną strukturę
          perswazyjną — od zdefiniowania problemu, przez budowanie zaufania danymi,
          po subtelne pozycjonowanie rozwiązania. Każda sekcja ma swoją funkcję.
        </p>

        <div class="srv-anatomy__stack">
          {anatomy.map((part) => (
            <div class={`srv-anatomy__part ${part.highlight ? 'srv-anatomy__part--hl' : ''}`}>
              <span class="srv-anatomy__part-label">{part.label}</span>
              <span class="srv-anatomy__part-desc">{part.desc}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od briefu po gotowy white paper"
          subtitle="Cztery etapy, jeden zespół, zero luk. Każdy white paper przechodzi pełny pipeline — strategia, research, pisanie, redakcja, design, skład, rendering."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="White papers pisane przez specjalistów B2B"
          subtitle="White paper to format wymagający — techniczny, perswazyjny, oparty na danych. Oto dlaczego warto zlecić go zespołowi, który łączy copywriting B2B z&nbsp;profesjonalnym publishingiem."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="srv-industries" aria-label="Branże">
    <div class="container">
      <div class="srv-industries__inner reveal">
        <span class="srv-industries__label">Branże</span>
        <h2 class="srv-industries__title">White papers dla wymagających branż</h2>
        <p class="srv-industries__desc">
          Tworzymy white papers dla branż, w których decyzje zakupowe są złożone,
          długie i&nbsp;wymagają edukacji. Wszędzie, gdzie klient musi zrozumieć
          problem, zanim kupi rozwiązanie.
        </p>
        <div class="srv-industries__list">
          <span class="srv-industries__item">SaaS i technologia</span>
          <span class="srv-industries__item">Fintech i finanse</span>
          <span class="srv-industries__item">Cyberbezpieczeństwo</span>
          <span class="srv-industries__item">Healthcare i medtech</span>
          <span class="srv-industries__item">Przemysł i manufacturing</span>
          <span class="srv-industries__item">HR i rekrutacja</span>
          <span class="srv-industries__item">Logistyka i supply chain</span>
          <span class="srv-industries__item">Legal i compliance</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading label="FAQ" title="Najczęściej zadawane pytania" subtitle="Odpowiedzi na pytania o&nbsp;tworzeniu white paperów, które słyszymy najczęściej." />
      </div>
      <div class="srv-faq__list">
        {faqs.map((faq, i) => (
          <details class="srv-faq__item reveal" style={`--delay: ${i * 0.04}s`}>
            <summary class="srv-faq__question">
              <span>{faq.q}</span>
              <svg class="srv-faq__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="srv-faq__answer"><p>{faq.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="srv-related" id="powiazane">
    <div class="container">
      <div class="reveal"><SectionHeading label="Powiązane usługi" title="Może Cię zainteresować" /></div>
      <div class="srv-related__grid reveal">
        {related.map((r) => (
          <a href={r.href} class="srv-related__card">
            <h3>{r.title}</h3><p>{r.desc}</p><span class="srv-related__arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="srv-cta" id="kontakt" aria-labelledby="srv-cta-title">
    <div class="srv-cta__bg" aria-hidden="true"></div>
    <div class="container">
      <div class="srv-cta__inner reveal">
        <h2 id="srv-cta-title" class="srv-cta__title">Potrzebujesz white papera, który sprzedaje?</h2>
        <p class="srv-cta__desc">
          Opisz temat, branżę i&nbsp;cel biznesowy — odpowiemy z&nbsp;wyceną,
          propozycją struktury i&nbsp;harmonogramem w&nbsp;ciągu 24&nbsp;godzin.
        </p>
        <div class="srv-cta__actions">
          <a href="/kontakt/" class="srv-cta__button">
            Zamów wycenę white papera
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a href="mailto:kontakt@ecopywriting.pl" class="srv-cta__email">kontakt@ecopywriting.pl</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO CONTENT -->
