---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie prezentacji?',
    a: 'Cena zależy od objętości, złożoności i zakresu prac. Prezentacja firmowa (15–25 slajdów, copy + design) to 2000–5000 zł. Pitch deck / prezentacja inwestorska (20–35 slajdów, storytelling + dane + design premium) to 5000–12 000 zł. Szablon prezentacji (master template z wariantami slajdów do wielokrotnego użytku) to 3000–8000 zł. W cenę wliczone: strategia, copywriting, projekt graficzny i rendering do wybranych formatów.'
  },
  {
    q: 'W jakich formatach dostarczacie prezentacje?',
    a: 'Dostarczamy prezentacje w dowolnym formacie: PowerPoint (.pptx) — edytowalny, najczęściej wybierany; Google Slides — do współpracy w chmurze; Keynote — dla użytkowników Apple; PDF — do wysyłki, druku i archiwizacji; PDF interaktywny — z klikalną nawigacją i animacjami. Standardowo dostarczamy PPTX + PDF. Format dobieramy do kontekstu — inny do prezentowania na żywo, inny do wysyłki mailem.'
  },
  {
    q: 'Czy mogę samodzielnie edytować gotową prezentację?',
    a: 'Tak — każda prezentacja w formacie PPTX/Google Slides/Keynote jest w pełni edytowalna. Dostarczamy master template z zdefiniowanymi layoutami slajdów, paletą kolorów, typografią i placeholderami. Dzięki temu Twój zespół może tworzyć nowe slajdy w spójnym designie bez grafika. Na życzenie przygotowujemy też instrukcję użytkowania szablonu.'
  },
  {
    q: 'Czy piszecie treści prezentacji, czy potrzebujecie gotowy tekst?',
    a: 'Jedno i drugie. Możemy napisać prezentację od zera — na podstawie briefu, rozmów i materiałów źródłowych. Możemy też przeprojektować istniejącą prezentację: zredagować copy, uporządkować strukturę, zaprojektować nowy layout. Najczęstsza opcja: klient dostarcza surowe materiały (notatki, dane, stara prezentacja), a my budujemy storytelling, piszemy copy i projektujemy slajdy.'
  },
  {
    q: 'Jak długo trwa stworzenie prezentacji?',
    a: 'Standardowa prezentacja firmowa (15–25 slajdów) to 5–10 dni roboczych. Pitch deck z pogłębionym storytellingiem to 7–14 dni. Szablon prezentacji (master template) to 7–14 dni. Czas obejmuje: brief, copywriting, design, jedną rundę poprawek i rendering. Przy pilnych projektach oferujemy tryb ekspresowy (3–5 dni, +50% do ceny).'
  },
  {
    q: 'Czy tworzycie szablony prezentacji do wielokrotnego użytku?',
    a: 'Tak — master template to jedna z naszych najpopularniejszych usług. Projektujemy komplet wariantów slajdów (tytułowy, treściowy, dane/wykresy, cytat, porównanie, timeline, CTA, divider) w spójnym designie. Twój zespół wybiera odpowiedni layout i wypełnia treścią — bez grafika, bez ryzyka „zepsucia" designu. Template w PPTX, Google Slides lub Keynote.'
  },
  {
    q: 'Czy pomagacie z prezentacjami do konkretnych sytuacji?',
    a: 'Tak — każdą prezentację projektujemy pod konkretny kontekst: pitch deck dla inwestorów (storytelling, problem-solution, traction, ask), prezentacja sprzedażowa (benefit-driven, obiekcje, CTA), prezentacja konferencyjna (speaker support, storytelling wizualny), raport kwartalny (dane, wykresy, wnioski), onboarding / szkolenie (struktura dydaktyczna). Kontekst determinuje strukturę, ton i format.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/prezentacje/#service",
      "name": "Prezentacje",
      "description": "Profesjonalne tworzenie prezentacji. PowerPoint, Google Slides, Keynote, PDF. Pitch decki, prezentacje firmowe, sprzedażowe, konferencyjne. Copywriting, storytelling, design, szablony. Od briefu po gotowy plik.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Presentation design",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/prezentacje/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/prezentacje/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/prezentacje/",
      "name": "Prezentacje — Tworzenie Prezentacji PowerPoint, PDF i Google Slides | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie prezentacji. PowerPoint, Google Slides, PDF, Keynote. Pitch decki, prezentacje firmowe i sprzedażowe. Copywriting + design. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/prezentacje/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/prezentacje/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Prezentacje", "item": "https://www.ecopywriting.pl/uslugi/prezentacje/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Presentation types ──
const presTypes = [
  {
    title: 'Pitch decki',
    desc: 'Prezentacje inwestorskie i sprzedażowe — storytelling od problemu, przez rozwiązanie, po ask. Struktura, która prowadzi słuchacza do konkluzji. Dane, traction, team, roadmap. Format, który decyduje o finansowaniu.',
    context: 'Inwestorzy, VCs, partnerzy',
    icon: '🚀'
  },
  {
    title: 'Prezentacje firmowe',
    desc: 'Wizytówka firmy w formacie slajdów — misja, usługi, kompetencje, portfolio, zespół. Do spotkań B2B, przetargów, onboardingu klientów. Copy, które pozycjonuje firmę, nie opisuje jej.',
    context: 'Klienci B2B, przetargi, partnerzy',
    icon: '🏢'
  },
  {
    title: 'Prezentacje sprzedażowe',
    desc: 'Narzędzie dla handlowców — benefit-driven, adresujące obiekcje, z jasnym CTA. Struktura: problem klienta → rozwiązanie → dowody → następny krok. Customizowalne per prospect.',
    context: 'Sales team, spotkania handlowe',
    icon: '💼'
  },
  {
    title: 'Prezentacje konferencyjne',
    desc: 'Speaker support dla prelegentów — wizualny storytelling, minimalistyczne slajdy, punchline\'y. Prezentacja, która wspiera mówcę, nie zastępuje go. Speaker notes z timingiem i podpowiedziami.',
    context: 'Konferencje, webinary, keynote',
    icon: '🎤'
  },
  {
    title: 'Raporty i dashboardy',
    desc: 'Prezentacje danych — raporty kwartalne, podsumowania projektów, dashboardy strategiczne. Wykresy, tabele, KPI, trendy. Dane, które opowiadają historię, nie przytłaczają tabelami.',
    context: 'Zarząd, stakeholderzy, board',
    icon: '📊'
  },
  {
    title: 'Szablony prezentacji',
    desc: 'Master template z kompletem wariantów slajdów — tytułowy, treściowy, dane, cytat, porównanie, timeline, CTA, divider. Twój zespół tworzy nowe prezentacje w spójnym designie bez grafika. Inwestycja jednorazowa, użytek wielokrotny.',
    context: 'Cała firma, wielokrotne użycie',
    icon: '🎨'
  }
];

// ── Formats ──
const formats = [
  {
    name: 'PowerPoint',
    ext: '.pptx',
    desc: 'Najczęściej wybierany format. W pełni edytowalny, kompatybilny z Windows i Mac. Idealne do prezentacji na żywo i edycji przez zespół.',
    features: ['Edytowalny', 'Animacje', 'Speaker notes', 'Master slides']
  },
  {
    name: 'Google Slides',
    ext: 'cloud',
    desc: 'Do współpracy w chmurze — edycja zespołowa w real-time, komentarze, history. Idealne dla rozproszonych zespołów i firm na Google Workspace.',
    features: ['Współpraca online', 'Real-time edycja', 'Komentarze', 'Version history']
  },
  {
    name: 'PDF',
    ext: '.pdf',
    desc: 'Do wysyłki mailem, archiwizacji i druku. Wygląda identycznie na każdym urządzeniu. Opcjonalnie: interaktywny PDF z klikalnymi linkami i nawigacją.',
    features: ['Pixel-perfect', 'Uniwersalny', 'Druk', 'Interaktywny (opcja)']
  },
  {
    name: 'Keynote',
    ext: '.key',
    desc: 'Natywny format Apple. Płynniejsze animacje i lepsze renderowanie na Mac/iPad. Dla firm i prelegentów w ekosystemie Apple.',
    features: ['Animacje Apple', 'Retina', 'iPad support', 'Export do PPTX']
  }
];

// ── Slide anatomy ──
const slideRules = [
  { rule: 'Jeden slajd = jedna myśl', desc: 'Nigdy dwa kluczowe przesłania na jednym slajdzie. Publiczność zapamiętuje jedno — dajemy jej to jedno.' },
  { rule: 'Copy, nie zdania', desc: 'Slajd to wizualny support, nie dokument do czytania. Nagłówki, frazy, punchline\'y — nie paragrafy tekstu.' },
  { rule: 'Hierarchia wizualna', desc: 'Oko musi wiedzieć, gdzie patrzeć najpierw. Tytuł → key message → supporting detail. Rozmiar, kolor, przestrzeń.' },
  { rule: 'Dane jako historia', desc: 'Wykres bez kontekstu to szum. Każdy chart ma headline: „Wzrost o 47% w Q3" zamiast „Przychody 2024". Dane opowiadają, nie raportują.' },
  { rule: 'Przestrzeń = profesjonalizm', desc: 'White space to nie marnowanie miejsca — to sygnał jakości. Zatłoczone slajdy wyglądają amatorsko i przeciążają odbiorcę.' }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Brief i strategia',
    desc: 'Definiujemy: kto jest odbiorcą, jaki jest cel (przekonać, poinformować, sprzedać), kontekst (na żywo, wysyłka, konferencja), format i objętość. Analiza istniejących materiałów. Outline — struktura slajdów do akceptacji przed designem.'
  },
  {
    num: '02',
    title: 'Copywriting i storytelling',
    desc: 'Pisanie treści prezentacji — nagłówki, key messages, punchline\'y, speaker notes. Budowanie narracji: problem → napięcie → rozwiązanie → dowód → CTA. Każdy slajd ma jeden cel i jedno przesłanie. Copy do akceptacji przed designem.'
  },
  {
    num: '03',
    title: 'Projekt graficzny',
    desc: 'Projektowanie layoutu slajdów — siatka, typografia, paleta kolorów, ikony, wykresy, infografiki. Spójność z brandingiem firmy. Design dopasowany do kontekstu: prezentacja na żywo wymaga innego layoutu niż deck wysyłany mailem.'
  },
  {
    num: '04',
    title: 'Rendering i dostawa',
    desc: 'Rendering do wybranych formatów: PowerPoint (edytowalny, z master slides), Google Slides (z udostępnieniem), PDF (pixel-perfect, opcjonalnie interaktywny), Keynote. Testy na projektorze/ekranie. Dostawa plików finalnych + źródłowych.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Storytelling, nie bullet pointy',
    desc: 'Największy problem prezentacji firmowych? Bullet pointy, ściany tekstu, zero narracji. Budujemy prezentacje jako historię — problem, napięcie, rozwiązanie, dowód, CTA. Publiczność zapamiętuje historie, nie listy wypunktowane.'
  },
  {
    title: 'Copy + design w jednym zespole',
    desc: 'Nie projektujemy „ładnych slajdów do Twojego tekstu". Piszemy copy I projektujemy slajdy — razem, jednocześnie. Treść i forma powstają wspólnie, nie sekwencyjnie. Efekt: spójność, która jest niemożliwa, gdy copywriter i grafik pracują osobno.'
  },
  {
    title: 'Dowolny format — PPTX, Slides, PDF, Keynote',
    desc: 'Dostarczamy w formacie, którego potrzebujesz — PowerPoint do edycji, Google Slides do współpracy, PDF do wysyłki, Keynote dla Apple. Każdy format ma swoją specyfikę i optymalizujemy pod niego. Nie „eksportujemy" — renderujemy natywnie.'
  },
  {
    title: 'Szablony, które żyją dalej',
    desc: 'Master template to inwestycja jednorazowa, użytek wielokrotny. Twój zespół tworzy nowe prezentacje w spójnym designie — bez grafika, bez ryzyka „zepsucia" layoutu. Zdefiniowane warianty slajdów, paleta, typografia, placeholdery.'
  }
];

// ── Related ──
const related = [
  { title: 'Materiały szkoleniowe', href: '/uslugi/materialy-szkoleniowe/', desc: 'Prezentacje szkoleniowe i edukacyjne' },
  { title: 'Katalogi i broszury', href: '/uslugi/katalogi-broszury/', desc: 'Materiały drukowane i cyfrowe' },
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe i wizerunkowe' },
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Publikacje cyfrowe i lead magnety' }
];
---

<BaseLayout
  title="Prezentacje — Tworzenie Prezentacji PowerPoint, PDF i Google Slides | eCopywriting.pl"
  description="Profesjonalne tworzenie prezentacji. PowerPoint, Google Slides, PDF, Keynote. Pitch decki, prezentacje firmowe, sprzedażowe, konferencyjne. Copywriting, storytelling, design. Szablony do wielokrotnego użytku. Wycena w 24h."
  keywords="tworzenie prezentacji, prezentacje PowerPoint, prezentacje firmowe, pitch deck, prezentacja sprzedażowa, prezentacje Google Slides, prezentacje PDF, szablon prezentacji, prezentacje na zamówienie, design prezentacji"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/prezentacje/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Prezentacje</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Prezentacje & Pitch Decki</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Prezentacje, które<br><em>przekonują i&nbsp;zostają w&nbsp;głowie</em>
      </h1>
      <p class="srv-hero__subtitle">
        Pitch decki, prezentacje firmowe, sprzedażowe i&nbsp;konferencyjne.
        Storytelling, copywriting i&nbsp;design — w&nbsp;PowerPoint, Google Slides,
        PDF, Keynote lub dowolnym innym formacie.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#formaty" class="srv-hero__cta-secondary">Dostępne formaty</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Storytelling</strong> nie bullet pointy</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>PPTX + PDF + Slides + Keynote</strong></div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Copy + design</strong> w jednym zespole</div>
      </div>
    </div>
  </section>

  <!-- PRESENTATION TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co tworzymy"
          title="Rodzaje prezentacji"
          subtitle="Od pitch decka dla inwestorów po szablon do wielokrotnego użytku. Każdą prezentację projektujemy pod konkretny kontekst — odbiorca, cel, format, kanał."
        />
      </div>
      <div class="srv-types__grid">
        {presTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-context">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {d.context}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMATS -->
  <section class="srv-formats" id="formaty" aria-labelledby="srv-formats-title">
    <div class="container">
      <div class="srv-formats__inner reveal">
        <span class="srv-formats__label">Formaty</span>
        <h2 id="srv-formats-title" class="srv-formats__title">
          Dowolny format —<br><em>natywnie, nie „eksport"</em>
        </h2>
        <p class="srv-formats__desc">
          Nie tworzymy w jednym narzędziu i nie eksportujemy do reszty. Każdy format
          renderujemy natywnie — żeby PowerPoint wyglądał jak PowerPoint, a PDF jak PDF.
          Bo eksportowany PPTX→PDF to nie to samo co zaprojektowany PDF.
        </p>

        <div class="srv-formats__grid">
          {formats.map((f) => (
            <div class="srv-formats__card">
              <div class="srv-formats__card-header">
                <h3>{f.name}</h3>
                <span class="srv-formats__card-ext">{f.ext}</span>
              </div>
              <p>{f.desc}</p>
              <div class="srv-formats__card-features">
                {f.features.map((feat) => (
                  <span class="srv-formats__card-chip">{feat}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SLIDE RULES -->
  <section class="srv-rules" id="zasady" aria-labelledby="srv-rules-title">
    <div class="container">
      <div class="srv-rules__inner reveal">
        <span class="srv-rules__label">Nasze zasady</span>
        <h2 id="srv-rules-title" class="srv-rules__title">5 zasad dobrego slajdu</h2>
        <p class="srv-rules__desc">
          Każdą prezentację tworzymy w oparciu o sprawdzone zasady, które odróżniają
          profesjonalny deck od „slajdów z dużą ilością tekstu".
        </p>

        <div class="srv-rules__list">
          {slideRules.map((r, i) => (
            <div class="srv-rules__item">
              <span class="srv-rules__item-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <strong>{r.rule}</strong>
                <p>{r.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od briefu po gotową prezentację"
          subtitle="Cztery etapy, jeden zespół. Strategia → copywriting → design → rendering do wybranego formatu. Copy i design powstają razem, nie sekwencyjnie."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Prezentacje od copywriterów, nie tylko grafików"
          subtitle="Piękne slajdy z kiepskim copy nie przekonują. Brzydkie slajdy z dobrym copy — też nie. Łączymy storytelling z designem, bo jedno bez drugiego nie działa."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading label="FAQ" title="Najczęściej zadawane pytania" subtitle="Odpowiedzi na pytania o&nbsp;tworzeniu prezentacji, które słyszymy najczęściej." />
      </div>
      <div class="srv-faq__list">
        {faqs.map((faq, i) => (
          <details class="srv-faq__item reveal" style={`--delay: ${i * 0.04}s`}>
            <summary class="srv-faq__question">
              <span>{faq.q}</span>
