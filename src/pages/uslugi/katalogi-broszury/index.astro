---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie katalogu lub broszury?',
    a: 'Cena zależy od objętości, złożoności i zakresu prac. Broszura firmowa (8–16 stron, copy + design + skład) to 3000–7000 zł. Katalog produktowy (20–60 stron, opisy produktów, zdjęcia, tabele) to 6000–15 000 zł. Katalog premium (60–150+ stron, pełny copywriting, sesja zdjęciowa, skład, rendering) to 15 000–35 000 zł. W cenę wliczone: strategia, copywriting, projekt graficzny, skład i rendering do druku i/lub wersji cyfrowej.'
  },
  {
    q: 'Jak długo trwa stworzenie katalogu?',
    a: 'Broszura firmowa (8–16 stron) to 2–3 tygodnie. Katalog produktowy (20–60 stron) to 3–5 tygodni. Katalog premium (60–150+ stron) to 6–10 tygodni. Czas obejmuje: brief, copywriting, redakcję, projekt graficzny, skład typograficzny, rendering, testy i korektę. Przy sezonowych katalogach (np. kolekcja wiosna/lato) rekomendujemy start 8–12 tygodni przed deadlinem.'
  },
  {
    q: 'Czy dostarczacie pliki gotowe do druku?',
    a: 'Tak — dostarczamy print-ready PDF z profilem kolorów CMYK, spadami (bleed), znacznikami cięcia i osadzonymi fontami. Pliki zgodne ze standardami drukarni offsetowej i cyfrowej. Współpracujemy z drukarnią Twojego wyboru lub rekomendujemy sprawdzonych partnerów. Na życzenie dostarczamy też wersję cyfrową (RGB, interaktywną) do dystrybucji online.'
  },
  {
    q: 'Czy mogę zamówić sam skład (mam już teksty i zdjęcia)?',
    a: 'Tak — oferujemy sam skład i rendering z gotowych materiałów. Dostarczasz teksty i zdjęcia, a my zajmujemy się: redakcją, projektem graficznym, składem typograficznym i renderingiem do druku i/lub wersji cyfrowej. To opcja dla firm, które mają wewnętrzny copywriting, ale potrzebują profesjonalnego DTP.'
  },
  {
    q: 'Czy tworzycie też wersje cyfrowe katalogów?',
    a: 'Tak — oprócz print-ready PDF tworzymy wersje cyfrowe: interaktywny PDF (klikalne linki, spis treści, zakładki), flipbook online (do osadzenia na stronie), EPUB (czytniki), a nawet dedykowane landing page z katalogiem produktów. Wersja cyfrowa może mieć inny layout niż drukowana — zoptymalizowany pod ekran zamiast kartki A4.'
  },
  {
    q: 'Czy pomagacie z aktualizacją istniejących katalogów?',
    a: 'Tak — przejmujemy istniejące katalogi i aktualizujemy: nowe produkty, zmienione ceny, odświeżony design, nowe zdjęcia. Jeśli masz pliki źródłowe (InDesign, Figma) — pracujemy na nich. Jeśli nie — odtwarzamy layout i tworzymy nowe źródło, które ułatwi przyszłe aktualizacje. Rekomendujemy systematyczny cykl aktualizacji (kwartalny lub półroczny).'
  },
  {
    q: 'Jakich narzędzi używacie do składu katalogów?',
    a: 'Adobe InDesign i Figma (katalogi wizualne, lifestyle, produktowe), LaTeX/Quarto (katalogi techniczne z dużą ilością danych, tabel, specyfikacji). Przy dużych katalogach (100+ produktów) wykorzystujemy automatyzację — import danych z CSV/bazy produktowej do szablonu, co eliminuje ręczne wklejanie i redukuje ryzyko błędów.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/#service",
      "name": "Katalogi i broszury",
      "description": "Profesjonalne tworzenie katalogów produktowych i broszur firmowych. Copywriting, projekt graficzny, skład typograficzny, rendering do druku (CMYK) i wersji cyfrowej. Od briefu po print-ready PDF.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Catalog and brochure creation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/",
      "name": "Katalogi i Broszury — Tworzenie Katalogów Produktowych i Broszur | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie katalogów produktowych i broszur firmowych. Copywriting, design, skład DTP, print-ready PDF. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Katalogi i broszury", "item": "https://www.ecopywriting.pl/uslugi/katalogi-broszury/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Publication types ──
const pubTypes = [
  {
    title: 'Katalogi produktowe',
    desc: 'Kompletne katalogi z opisami produktów, specyfikacjami technicznymi, zdjęciami i cennikami. Od 20 do 300+ stron. Struktura ułatwiająca nawigację — spis treści, sekcje, indeksy. Język korzyści zamiast suchej specyfikacji.',
    format: 'A4 / A5 / niestandardowy',
    icon: '📦'
  },
  {
    title: 'Broszury firmowe',
    desc: 'Kompaktowe prezentacje firmy, usług lub oferty — 8–16 stron, które mówią wszystko, co klient musi wiedzieć. Idealne na targi, spotkania biznesowe i mailingi. Copy, które sprzedaje, nie opisuje.',
    format: 'A4 / A5 / DL / składane',
    icon: '📑'
  },
  {
    title: 'Lookbooki i katalogi lifestyle',
    desc: 'Wizualne publikacje dla marek fashion, beauty, HoReCa i design. Nacisk na fotografię, storytelling i estetykę. Minimalistyczny copy, maksymalny impact wizualny. Format drukowany i cyfrowy.',
    format: 'Dowolny / premium print',
    icon: '✨'
  },
  {
    title: 'Katalogi techniczne',
    desc: 'Publikacje z dużą ilością danych — specyfikacje, tabele, schematy, rysunki techniczne. Precyzyjny skład z automatycznym importem danych z bazy produktowej. Dla branż: przemysł, budownictwo, elektronika, automotive.',
    format: 'A4 / A3 rozkładówka',
    icon: '⚙️'
  },
  {
    title: 'Cenniki i ofertowniki',
    desc: 'Profesjonalne cenniki produktów i usług — z tabelami, wariantami, pakietami. Struktura umożliwiająca szybkie aktualizacje (modularny layout). Wersja drukowana + interaktywny PDF z kalkulatorem lub formularzem.',
    format: 'A4 / A5 / cyfrowy',
    icon: '💰'
  },
  {
    title: 'Foldery i ulotki premium',
    desc: 'Materiały 1–6 stron — składane foldery, ulotki, inserty. Kompaktowa forma, maksymalny przekaz. Idealne do dystrybucji na eventach, w paczkach e-commerce, w punktach sprzedaży. Copy + design + print-ready w jednym.',
    format: 'DL / A5 / A4 składane',
    icon: '📄'
  }
];

// ── Print vs Digital ──
const printVsDigital = [
  {
    type: 'Druk',
    label: 'Print-ready PDF',
    specs: [
      'Profil kolorów CMYK',
      'Spady 3–5 mm (bleed)',
      'Znaczniki cięcia (crop marks)',
      'Osadzone fonty i grafiki',
      'Rozdzielczość 300 DPI',
      'Zgodność z normami drukarni'
    ]
  },
  {
    type: 'Cyfrowy',
    label: 'Wersja online',
    specs: [
      'Profil kolorów RGB (ekran)',
      'Klikalne linki i spis treści',
      'Zakładki i nawigacja PDF',
      'Zoptymalizowany rozmiar pliku',
      'Flipbook do osadzenia na stronie',
      'Opcjonalnie: EPUB / landing page'
    ]
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Brief i struktura',
    desc: 'Definiujemy cel publikacji, grupę docelową, format, objętość i kanał dystrybucji (druk, digital, oba). Projektujemy strukturę — spis treści, podział na sekcje, hierarchię informacji. Flatplan (schemat rozkładówek) do akceptacji przed startem produkcji.'
  },
  {
    num: '02',
    title: 'Copywriting i redakcja',
    desc: 'Piszemy opisy produktów, teksty wizerunkowe, nagłówki, CTA. Język korzyści zamiast suchych specyfikacji. Dwuetapowa redakcja: merytoryczna (fakty, spójność) i językowa (styl, gramatyka). Przy katalogach technicznych — import danych z bazy z weryfikacją.'
  },
  {
    num: '03',
    title: 'Projekt graficzny i skład',
    desc: 'Projektowanie layoutu — siatka, typografia, paleta kolorów, traktowanie zdjęć. Skład typograficzny w InDesign lub Figma (wizualne) lub LaTeX (techniczne). Profesjonalny DTP: kerning, leading, hierarchia, paginacja, wdowy/sieroty, tabele, infografiki.'
  },
  {
    num: '04',
    title: 'Rendering i dostawa',
    desc: 'Rendering do print-ready PDF (CMYK, spady, crop marks, 300 DPI) i/lub wersji cyfrowej (RGB, interaktywny PDF, flipbook). Testy na urządzeniach i proof drukarski (softproof lub hardproof). Dostawa plików finalnych + źródłowych (InDesign/Figma) do przyszłych edycji.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Copy + design + DTP — jeden zespół',
    desc: 'Nie musisz koordynować copywritera, fotografa, grafika i składacza. Jeden zespół prowadzi projekt od briefu po print-ready PDF — z jednym harmonogramem i jednym punktem kontaktu. Zero luk między „tekst jest gotowy" a „grafik potrzebuje tekstu".'
  },
  {
    title: 'Język korzyści, nie specyfikacji',
    desc: 'Jesteśmy agencją copywriterską — pisanie to nasze DNA. Opisy produktów w katalogu piszemy tak, jak opisy na stronę czy ofertę handlową. Każdy produkt ma hook, benefit i powód do działania. Specyfikacja jest — ale wspiera, nie zastępuje język sprzedażowy.'
  },
  {
    title: 'Druk i digital w jednym projekcie',
    desc: 'Projektujemy katalog raz — renderujemy dwa razy. Print-ready PDF do drukarni (CMYK, spady, 300 DPI) i wersja cyfrowa na stronę (RGB, interaktywna, zoptymalizowana). Dwa kanały dystrybucji z jednego projektu — bez podwójnych kosztów.'
  },
  {
    title: 'Skalowalność i aktualizacje',
    desc: 'Przy dużych katalogach (100+ produktów) automatyzujemy import danych z CSV/bazy produktowej. Modularny layout umożliwia szybkie aktualizacje — nowe produkty, zmienione ceny, sezonowe kolekcje. Systematyczny cykl aktualizacji zamiast tworzenia od zera co rok.'
  }
];

// ── Related ──
const related = [
  { title: 'Opisy produktów', href: '/uslugi/opisy-produktow/', desc: 'Profesjonalne opisy do katalogów i sklepów' },
  { title: 'Ebooki', href: '/uslugi/ebooki/', desc: 'Publikacje cyfrowe i lead magnety' },
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe i oferty handlowe' },
  { title: 'Teksty na stronę', href: '/uslugi/teksty-na-strone/', desc: 'Copy na strony firmowe i produktowe' }
];
---

<BaseLayout
  title="Katalogi i Broszury — Tworzenie Katalogów Produktowych i Broszur | eCopywriting.pl"
  description="Profesjonalne tworzenie katalogów produktowych i broszur firmowych. Copywriting, projekt graficzny, skład DTP, rendering do druku (CMYK, print-ready PDF) i wersji cyfrowej. Od briefu po gotowy plik. Wycena w 24h."
  keywords="katalogi produktowe, broszury firmowe, tworzenie katalogów, składanie katalogów, katalog produktowy, broszura firmowa, DTP, skład katalogu, print-ready PDF, katalog druk"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/katalogi-broszury/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Katalogi i broszury</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Katalogi & DTP</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Katalogi i&nbsp;broszury,<br>które <em>sprzedają na papierze</em>
      </h1>
      <p class="srv-hero__subtitle">
        Profesjonalne tworzenie katalogów produktowych i&nbsp;broszur firmowych —
        copywriting, projekt graficzny, skład typograficzny i&nbsp;rendering do&nbsp;druku
        i&nbsp;wersji cyfrowej. Od&nbsp;briefu po&nbsp;print-ready PDF.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#rodzaje" class="srv-hero__cta-secondary">Rodzaje publikacji</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Copy + design + DTP</strong> w jednym zespole</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Print-ready</strong> CMYK + spady + 300 DPI</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Druk + digital</strong> z jednego projektu</div>
      </div>
    </div>
  </section>

  <!-- PUBLICATION TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Co tworzymy"
          title="Rodzaje katalogów i&nbsp;broszur"
          subtitle="Od 8-stronowej broszury firmowej po 300-stronowy katalog techniczny. Dobieramy format, objętość i&nbsp;styl do&nbsp;celu — sprzedaż, prezentacja, targi, mailing, dystrybucja online."
        />
      </div>
      <div class="srv-types__grid">
        {pubTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-format">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>
              {d.format}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRINT vs DIGITAL -->
  <section class="srv-output" id="formaty" aria-labelledby="srv-output-title">
    <div class="container">
      <div class="srv-output__inner reveal">
        <span class="srv-output__label">Formaty wyjściowe</span>
        <h2 id="srv-output-title" class="srv-output__title">
          Jeden projekt —<br><em>druk i&nbsp;digital</em>
        </h2>
        <p class="srv-output__desc">
          Projektujemy katalog raz, renderujemy dwa razy. Print-ready PDF do drukarni
          i&nbsp;wersja cyfrowa na stronę — z jednego projektu, bez podwójnych kosztów.
        </p>

        <div class="srv-output__grid">
          {printVsDigital.map((col) => (
            <div class="srv-output__col">
              <div class="srv-output__col-header">
                <span class="srv-output__col-type">{col.type}</span>
                <span class="srv-output__col-label">{col.label}</span>
              </div>
              <ul class="srv-output__col-specs">
                {col.specs.map((spec) => (
                  <li>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>{spec}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od briefu po print-ready PDF"
          subtitle="Cztery etapy, jeden zespół. Flatplan → copywriting → design i&nbsp;skład → rendering do druku i&nbsp;wersji cyfrowej. Z&nbsp;jednym punktem kontaktu i&nbsp;harmonogramem."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Katalogi tworzone przez copywriterów, nie tylko grafików"
          subtitle="Większość agencji DTP robi piękny layout z&nbsp;kiepskim copy. My robimy piękny layout z&nbsp;copy, które sprzedaje — bo jesteśmy agencją copywriterską z&nbsp;zespołem DTP."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AUTOMATION CALLOUT -->
  <section class="srv-auto" aria-labelledby="srv-auto-title">
    <div class="container">
      <div class="srv-auto__inner reveal">
        <span class="srv-auto__label">Duże katalogi?</span>
        <h2 id="srv-auto-title" class="srv-auto__title">
          100+ produktów?<br><em>Automatyzujemy skład.</em>
        </h2>
        <p class="srv-auto__desc">
          Przy katalogach z dużą liczbą produktów ręczne wklejanie opisów, cen i zdjęć
          to strata czasu i źródło błędów. Nasz zespół programistów automatyzuje import
          danych z&nbsp;CSV, bazy produktowej lub PIM do&nbsp;szablonu InDesign/LaTeX.
        </p>
        <div class="srv-auto__points">
          <div class="srv-auto__point">
            <span class="srv-auto__point-num">1</span>
            <div>
              <strong>Import z bazy danych</strong>
              <p>CSV, Excel, PIM, API sklepu — dane produktowe trafiają bezpośrednio do szablonu składu</p>
            </div>
          </div>
          <div class="srv-auto__point">
            <span class="srv-auto__point-num">2</span>
            <div>
              <strong>Modularny layout</strong>
              <p>Szablony stron z wariantami — produkty, kategorie, porównania. Raz zaprojektowane, wielokrotnie użyte</p>
            </div>
          </div>
          <div class="srv-auto__point">
            <span class="srv-auto__point-num">3</span>
            <div>
              <strong>Szybkie aktualizacje</strong>
              <p>Nowe produkty, zmienione ceny, sezonowe kolekcje — aktualizacja katalogu w godzinach, nie tygodniach</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="srv-faq" id="faq" aria-labelledby="srv-faq-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading label="FAQ" title="Najczęściej zadawane pytania" subtitle="Odpowiedzi na pytania o&nbsp;tworzeniu katalogów i&nbsp;broszur, które słyszymy najczęściej." />
      </div>
      <div class="srv-faq__list">
        {faqs.map((faq, i) => (
          <details class="srv-faq__item reveal" style={`--delay: ${i * 0.04}s`}>
            <summary class="srv-faq__question">
              <span>{faq.q}</span>
              <svg class="srv-faq__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
