---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje stworzenie landing page?',
    a: 'Cena zależy od złożoności i zakresu prac. Landing page lead gen (copy + design + development, formularz + integracja) to 3000–7000 zł. Landing page sprzedażowy (long-form, sekcje social proof, FAQ, warianty cenowe) to 5000–12 000 zł. Landing page + lejek (strona + sekwencja email + thank you page + A/B testy) to 8000–18 000 zł. W cenę wliczone: strategia, copywriting, projekt graficzny, development i wdrożenie.'
  },
  {
    q: 'Na jakiej technologii budujecie landing page?',
    a: 'Dobieramy technologię do kontekstu: HTML/CSS/JS (najszybsze, zero zależności, hosting na dowolnym serwerze), Astro/Next.js (jeśli strona wymaga dynamicznych elementów, integracji z API), WordPress/Elementor (jeśli klient chce samodzielnie edytować), Webflow (jeśli klient preferuje no-code), dedykowany CMS (jeśli strona jest częścią większego systemu). Rekomendujemy statyczny HTML — najszybszy, najtańszy w utrzymaniu, najlepszy dla SEO.'
  },
  {
    q: 'Czy landing page będzie responsywny?',
    a: 'Tak — każdy landing page projektujemy mobile-first. Ponad 60% ruchu to mobile, więc zaczynamy od wersji mobilnej i rozszerzamy na tablet i desktop. Testujemy na realnych urządzeniach (iPhone, Android, iPad) i w różnych przeglądarkach (Chrome, Safari, Firefox, Edge). Responsywność to nie „dostosowanie" — to osobny projekt dla każdego breakpointu.'
  },
  {
    q: 'Czy piszecie teksty na landing page, czy potrzebujecie gotowe?',
    a: 'Piszemy od zera — i to jest nasza główna przewaga. Jesteśmy agencją copywriterską, nie agencją webową, która „też robi teksty". Zaczynamy od researchu: grupa docelowa, obiekcje, język klienta, konkurencja. Na tej podstawie budujemy copy: nagłówek, subheadline, sekcje benefitów, social proof, FAQ, CTA. Copy do akceptacji przed designem.'
  },
  {
    q: 'Czy pomagacie z integracjami (formularze, CRM, email)?',
    a: 'Tak — wdrażamy kompletny lejek: formularz zapisu (z walidacją, honeypot antyspam), integracja z platformą email (Mailchimp, MailerLite, ConvertKit, ActiveCampaign, GetResponse), integracja z CRM (HubSpot, Pipedrive), tracking (GA4, GTM, Meta Pixel, LinkedIn Insight Tag), thank you page z next step. Nasz zespół programistów obsługuje integracje techniczne.'
  },
  {
    q: 'Czy robicie A/B testy landing page?',
    a: 'Tak — oferujemy A/B testowanie nagłówków, CTA, layoutu i social proof. Wdrażamy testy przez Google Optimize (lub alternatywę) i monitorujemy wyniki. Rekomendujemy minimum 2 warianty na starcie — nagłówek A vs B, bo nagłówek ma największy wpływ na konwersję. A/B testy to nie jednorazowe działanie — to ciągła optymalizacja.'
  },
  {
    q: 'Jak szybko powstaje landing page?',
    a: 'Standardowy landing page (copy + design + development + wdrożenie) to 7–14 dni roboczych. Landing page z lejkiem (+ sekwencja email + integracje + A/B testy) to 14–21 dni. Przy pilnych projektach oferujemy tryb ekspresowy: 3–5 dni (+50% do ceny). Czas obejmuje: brief, copywriting, design, development, jedną rundę poprawek, wdrożenie i testy.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/landing-page/#service",
      "name": "Landing page",
      "description": "Profesjonalne tworzenie landing page na zamówienie. Copywriting, design, development, integracje, A/B testy. Landing page, które konwertują — od briefu po wdrożenie i optymalizację.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Landing page creation",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/landing-page/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/landing-page/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/landing-page/",
      "name": "Landing Page — Tworzenie Landing Page na Zamówienie | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne tworzenie landing page. Copywriting, design, development, integracje, A/B testy. Strony lądowania, które konwertują. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/landing-page/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/landing-page/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Landing page", "item": "https://www.ecopywriting.pl/uslugi/landing-page/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Landing page types ──
const lpTypes = [
  {
    title: 'Lead generation',
    desc: 'Landing page z formularzem — email za wartość (ebook, webinar, demo, wycenę). Główny cel: pozyskanie kontaktu. Krótki lub średni format. Formularz + integracja z platformą email/CRM. Najczęstszy typ landing page w B2B.',
    goal: 'Pozyskanie leada',
    icon: '🧲'
  },
  {
    title: 'Sprzedażowy (sales page)',
    desc: 'Long-form landing page prowadzący do zakupu — problem, agitacja, rozwiązanie, dowody, oferta, gwarancja, CTA. Format dla produktów cyfrowych, kursów, usług premium. Każda sekcja adresuje inną obiekcję. Copy, które sprzedaje.',
    goal: 'Sprzedaż bezpośrednia',
    icon: '💳'
  },
  {
    title: 'Webinar / event',
    desc: 'Strona zapisu na webinar, konferencję, demo lub event. Countdown timer, speaker bio, agenda, social proof (liczba zapisanych). Integracja z platformą webinarową (Zoom, Livestorm, ClickMeeting) i sekwencją przypominającą.',
    goal: 'Zapisy na event',
    icon: '🎙️'
  },
  {
    title: 'Produkt / launch',
    desc: 'Landing page dla nowego produktu lub usługi — storytelling, demo/video, features, pricing, FAQ. Idealny do kampanii launchowych, Product Hunt, pre-sale. Buduje excitement i prowadzi do zakupu lub waitlisty.',
    goal: 'Launch i pre-sale',
    icon: '🚀'
  },
  {
    title: 'Squeeze page',
    desc: 'Minimalistyczny landing page z jednym celem — pozyskanie emaila. Nagłówek, 2–3 zdania, formularz. Zero dystraktorów. Najwyższy współczynnik konwersji przy dobrze dobranym traffic source. Idealny do paid ads.',
    goal: 'Maksymalna konwersja',
    icon: '⚡'
  },
  {
    title: 'Thank you / next step',
    desc: 'Strona po konwersji — podziękowanie, potwierdzenie, następny krok. Niedoceniany element lejka. Tu możesz: upsellować, podać link do calendly, poprosić o share, rozpocząć sekwencję onboardingową. Każda thank you page to szansa.',
    goal: 'Pogłębienie relacji',
    icon: '✅'
  }
];

// ── Anatomy of high-converting LP ──
const anatomy = [
  { label: 'Nagłówek (hero)', desc: 'Jedno zdanie, które zatrzymuje scroll. Adresuje główny problem lub obiecuje konkretny rezultat. Największy wpływ na konwersję — dlatego testujemy A/B.', critical: true },
  { label: 'Subheadline', desc: 'Rozwinięcie nagłówka — kto, co, jak. Jeśli nagłówek to hook, subheadline to kontekst. 1–2 zdania, które kwalifikują odwiedzającego.', critical: false },
  { label: 'Social proof (above fold)', desc: 'Logotypy klientów, liczba użytkowników, ocena. Jeden element zaufania widoczny bez scrollowania. „Zaufało nam 500+ firm" > nic.', critical: true },
  { label: 'Sekcja benefitów', desc: 'Nie features — benefits. Co klient zyskuje, nie co produkt robi. 3–5 benefitów z ikonami i krótkimi opisami. Język drugiej osoby: „Ty zyskujesz", nie „nasz produkt oferuje".', critical: false },
  { label: 'Dowody i testimoniale', desc: 'Case studies, cytaty klientów ze zdjęciem i firmą, wyniki w liczbach. Konkretne > ogólne. „Wzrost konwersji o 47% w 3 miesiące" > „świetna współpraca".', critical: true },
  { label: 'Obiekcje i FAQ', desc: 'Każda niezdecydowana osoba ma obiekcje. FAQ adresuje je proaktywnie: cena, czas, ryzyko, alternatywy. Usuwa bariery przed konwersją.', critical: false },
  { label: 'CTA (wezwanie do działania)', desc: 'Jasny, jednoznaczny, widoczny. Jeden główny CTA powtórzony 2–3× na stronie. Tekst przycisku: konkretna akcja, nie „Wyślij". „Pobierz ebook" / „Zarezerwuj demo" / „Zamów wycenę".', critical: true }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Strategia i research',
    desc: 'Definiujemy: cel landing page, grupę docelową, traffic source, ofertę, lejek po konwersji. Research: język klienta (recenzje, fora, social media), obiekcje, konkurencyjne LP. Wireframe tekstowy (copy-first) — struktura sekcji do akceptacji.'
  },
  {
    num: '02',
    title: 'Copywriting',
    desc: 'Pisanie copy w sprawdzonej strukturze: nagłówek → subheadline → social proof → benefity → dowody → obiekcje/FAQ → CTA. Każda sekcja ma jeden cel. Język drugiej osoby, konkretne rezultaty, adresowanie obiekcji. Copy do akceptacji przed designem.'
  },
  {
    num: '03',
    title: 'Design i UX',
    desc: 'Projekt graficzny — mobile-first, hierarchia wizualna, czytelność, ścieżka wzroku. Spójność z brandingiem firmy. Design wspiera copy, nie odwraca od niego uwagi. Prototyp w Figma do akceptacji i komentarzy przed developmentem.'
  },
  {
    num: '04',
    title: 'Development i wdrożenie',
    desc: 'Kodowanie landing page — HTML/CSS/JS, Astro, WordPress lub inna technologia. Responsywność na wszystkich urządzeniach, optymalizacja szybkości (Core Web Vitals), SEO on-page. Formularz, integracje (email, CRM, tracking), thank you page.'
  },
  {
    num: '05',
    title: 'Testy i optymalizacja',
    desc: 'Testy na urządzeniach i przeglądarkach, test formularza i integracji, testy szybkości. Wdrożenie A/B testów (nagłówek, CTA). Monitoring konwersji — GA4, GTM. Po 2–4 tygodniach: analiza danych, optymalizacja wariantu zwycięskiego.'
  }
];

// ── Copy vs Design ──
const copyVsDesign = [
  {
    myth: '„Ładny design = wysoka konwersja"',
    reality: 'Design wspiera copy, nie zastępuje go. Najlepiej konwertujące landing page mają przeciętny design i świetne copy. Brzydkie strony z dobrym copywritingiem konwertują lepiej niż piękne strony z kiepskim tekstem.'
  },
  {
    myth: '„Potrzebujemy więcej sekcji i features"',
    reality: 'Landing page to nie strona firmowa. Jeden cel, jedna oferta, jedno CTA. Każda dodatkowa opcja zmniejsza konwersję. Mniej = więcej. Prostota wymaga więcej pracy niż złożoność.'
  },
  {
    myth: '„Formularz powinien zbierać dużo danych"',
    reality: 'Każde dodatkowe pole formularza obniża konwersję o 5–10%. Na etapie lead gen wystarczy email (czasem + imię). Resztę informacji zbierzesz w sekwencji email lub na spotkaniu.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Copywriting-first, nie design-first',
    desc: 'Zaczynamy od copy, nie od designu. Wireframe tekstowy (copy-first) definiuje strukturę, argumentację i flow. Design powstaje POD copy, nie odwrotnie. Dlatego nasze landing page konwertują — bo mają solidny fundament perswazyjny, a nie tylko ładne slajdy.'
  },
  {
    title: 'Copy + design + dev — jeden zespół',
    desc: 'Nie musisz koordynować copywritera, grafika i programisty. Jeden zespół prowadzi landing page od briefu po wdrożenie — strategia, copy, design, development, integracje, A/B testy. Jeden harmonogram, zero „grafik czeka na tekst" i „dev czeka na design".'
  },
  {
    title: 'Programiści w zespole',
    desc: 'Nasz zespół programistów koduje landing page, wdraża integracje (formularze, CRM, email, tracking) i optymalizuje szybkość. Nie „eksportujemy z Figmy" i nie „używamy page buildera". Kod jest czysty, szybki i zoptymalizowany pod Core Web Vitals.'
  },
  {
    title: 'Landing page jako element lejka',
    desc: 'Nie tworzymy landing page w próżni. Projektujemy go jako element systemu: traffic source → LP → formularz → thank you page → sekwencja email → konwersja. Pomagamy z każdym elementem lejka — od copy na reklamę po sekwencję nurturingową.'
  }
];

// ── Tech chips ──
const techChips = [
  { group: 'Development', items: ['HTML / CSS / JS', 'Astro', 'Next.js', 'WordPress', 'Webflow'] },
  { group: 'Integracje', items: ['Mailchimp', 'MailerLite', 'ConvertKit', 'ActiveCampaign', 'HubSpot', 'Pipedrive'] },
  { group: 'Tracking', items: ['Google Analytics 4', 'Google Tag Manager', 'Meta Pixel', 'LinkedIn Insight Tag', 'Hotjar'] },
  { group: 'Optymalizacja', items: ['A/B testing', 'Core Web Vitals', 'PageSpeed 90+', 'SEO on-page'] }
];

// ── Related ──
const related = [
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe i oferty' },
  { title: 'Email marketing', href: '/uslugi/email-marketing/', desc: 'Sekwencje po konwersji' },
  { title: 'Teksty na stronę', href: '/uslugi/teksty-na-strone/', desc: 'Copy na strony firmowe' },
  { title: 'Strategia contentowa', href: '/uslugi/strategia-content-marketingowa/', desc: 'LP jako element strategii' }
];
---

<BaseLayout
  title="Landing Page — Tworzenie Landing Page na Zamówienie | eCopywriting.pl"
  description="Profesjonalne tworzenie landing page na zamówienie. Copywriting, design, development, integracje, A/B testy. Landing page na zlecenie — strony lądowania, które konwertują. Od briefu po wdrożenie. Wycena w 24h."
  keywords="tworzenie landing page, landing page na zamówienie, landing page na zlecenie, strona lądowania, landing page copywriting, landing page design, landing page konwersja, tworzenie stron lądowania"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/landing-page/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Landing page</li>
      </ol>
    </div>
  </nav>

  <!-- HERO -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true"><div class="srv-hero__grain"></div><div class="srv-hero__gradient"></div></div>
    <div class="container srv-hero__inner">
      <div class="srv-hero__badge"><span class="srv-hero__badge-dot"></span>Landing Page & Konwersja</div>
      <h1 id="srv-hero-title" class="srv-hero__title">
        Landing page, który<br><em>konwertuje, nie&nbsp;tylko wygląda</em>
      </h1>
      <p class="srv-hero__subtitle">
        Tworzenie landing page na zamówienie — copywriting-first, design, development,
        integracje i&nbsp;A/B testy. Strony lądowania z&nbsp;jednym celem: konwersja.
        Od&nbsp;briefu po&nbsp;wdrożenie i&nbsp;optymalizację.
      </p>
      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#anatomia" class="srv-hero__cta-secondary">Anatomia LP, który konwertuje</a>
      </div>
      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item"><strong>Copy-first</strong> — tekst przed designem</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>Copy + design + dev</strong> w jednym zespole</div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item"><strong>A/B testy</strong> od pierwszego dnia</div>
      </div>
    </div>
  </section>

  <!-- LP TYPES -->
  <section class="srv-types" id="rodzaje" aria-labelledby="srv-types-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Rodzaje"
          title="Rodzaje landing page"
          subtitle="Każdy landing page ma jeden cel. Dobieramy typ, strukturę i&nbsp;długość do&nbsp;celu — pozyskanie leada, sprzedaż, zapis na event, launch produktu."
        />
      </div>
      <div class="srv-types__grid">
        {lpTypes.map((d, i) => (
          <div class="srv-types__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-types__card-icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="srv-types__card-goal">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              {d.goal}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ANATOMY -->
  <section class="srv-anatomy" id="anatomia" aria-labelledby="srv-anatomy-title">
    <div class="container">
      <div class="srv-anatomy__inner reveal">
        <span class="srv-anatomy__label">Struktura</span>
        <h2 id="srv-anatomy-title" class="srv-anatomy__title">Anatomia landing page,<br>który <em>konwertuje</em></h2>
        <p class="srv-anatomy__desc">
          Wysoka konwersja to nie przypadek — to efekt struktury. Każda sekcja landing
          page ma swoją funkcję w procesie perswazji. Pomijasz jedną — tracisz konwersje.
        </p>

        <div class="srv-anatomy__stack">
          {anatomy.map((part) => (
            <div class={`srv-anatomy__part ${part.critical ? 'srv-anatomy__part--critical' : ''}`}>
              <span class="srv-anatomy__part-label">{part.label}</span>
              <span class="srv-anatomy__part-desc">{part.desc}</span>
              {part.critical && <span class="srv-anatomy__part-badge">Kluczowe</span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MYTHS -->
  <section class="srv-myths" aria-labelledby="srv-myths-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Mity konwersji"
          title="3 mity o&nbsp;landing page, które obniżają konwersję"
          subtitle="Większość landing page nie konwertuje, bo ich twórcy wierzą w mity. Oto trzy najczęstsze — i&nbsp;rzeczywistość."
        />
      </div>

      <div class="srv-myths__grid">
        {copyVsDesign.map((m, i) => (
          <div class="srv-myths__card reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-myths__card-myth">
              <span class="srv-myths__card-label">Mit</span>
              <p>{m.myth}</p>
            </div>
            <div class="srv-myths__card-reality">
              <span class="srv-myths__card-label srv-myths__card-label--accent">Rzeczywistość</span>
              <p>{m.reality}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS (dark) -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od briefu po wdrożenie i&nbsp;optymalizację"
          subtitle="Pięć etapów, jeden zespół. Strategia → copy → design → development → testy i&nbsp;A/B. Copy powstaje PRZED designem — bo design wspiera argumentację, nie odwrotnie."
          inverted
        />
      </div>
      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="srv-benefits" id="dlaczego" aria-labelledby="srv-benefits-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Dlaczego my"
          title="Landing page od copywriterów z&nbsp;zespołem dev"
          subtitle="Agencje webowe robią ładne strony ze słabym copy. Freelance copywriterzy piszą dobry tekst, ale nie kodują. My łączymy jedno z&nbsp;drugim — copywriting, design i&nbsp;development pod jednym dachem."
        />
      </div>
      <div class="srv-benefits__grid">
        {benefits.map((b, i) => (
          <div class="srv-benefit reveal" style={`--delay: ${i * 0.08}s`}>
            <div class="srv-benefit__accent" aria-hidden="true"></div>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
