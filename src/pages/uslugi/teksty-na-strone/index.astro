---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

// ── FAQ ──
const faqs = [
  {
    q: 'Ile kosztuje napisanie tekstów na stronę internetową?',
    a: 'Cena zależy od liczby podstron, złożoności branży i zakresu researchu. Teksty na stronę główną to zazwyczaj 1000–2500 zł, strona usługowa 600–1500 zł, strona „O nas" 500–1200 zł. Kompletny pakiet tekstów na stronę firmową (5–8 podstron) to 3000–8000 zł. Przy każdym projekcie przygotowujemy indywidualną wycenę w ciągu 24 godzin.'
  },
  {
    q: 'Jak długo trwa napisanie tekstów na stronę?',
    a: 'Kompletny zestaw tekstów na stronę firmową (5–8 podstron) dostarczamy w 7–14 dni roboczych, w zależności od złożoności branży i zakresu researchu. Pojedyncza podstrona to 3–5 dni. W cenę wliczony jest research, pisanie, redakcja i dwie rundy poprawek. W pilnych przypadkach oferujemy tryb ekspresowy.'
  },
  {
    q: 'Czy piszecie teksty pod konkretny CMS (WordPress, Webflow itp.)?',
    a: 'Tak — dostarczamy teksty w formacie dopasowanym do Twojego CMS. Możemy też wdrożyć treści bezpośrednio na stronę — nasz zespół programistów pracuje z WordPress, Webflow, Astro, Next.js i innymi platformami. To eliminuje etap „wklejania tekstów" i zapewnia, że treść jest poprawnie sformatowana z właściwą hierarchią nagłówków.'
  },
  {
    q: 'Czy teksty na stronę będą zoptymalizowane pod SEO?',
    a: 'Tak — każdy tekst na stronę jest domyślnie zoptymalizowany pod wyszukiwarki. Dobieramy frazy kluczowe, planujemy strukturę nagłówków H1–H6, piszemy meta title i description, planujemy linkowanie wewnętrzne. Jeśli potrzebujesz zaawansowanej strategii SEO z audytem i content planem, sprawdź naszą usługę SEO Copywriting.'
  },
  {
    q: 'Co jest potrzebne do rozpoczęcia pracy?',
    a: 'Na start potrzebujemy: krótkiego briefu (kim jesteś, co robisz, dla kogo, czym się wyróżniasz), informacji o grupie docelowej, dostępu do obecnej strony (jeśli istnieje) i ewentualnych materiałów firmowych (prezentacje, oferty, case studies). Przygotowaliśmy prosty formularz briefu, który ułatwia ten proces — wypełnienie zajmuje 10–15 minut.'
  },
  {
    q: 'Czy mogę zamówić teksty na pojedynczą podstronę?',
    a: 'Oczywiście. Możesz zamówić teksty na jedną podstronę (np. nową stronę usługową lub „O nas"), kilka wybranych podstron lub kompletny zestaw na całą stronę internetową. Rekomendujemy jednak spójne podejście do całej strony — teksty pisane w jednym procesie są bardziej spójne tonalnie i strategicznie.'
  },
  {
    q: 'Ile rund poprawek jest w cenie?',
    a: 'Każde zlecenie obejmuje dwie rundy poprawek w cenie. Dzięki szczegółowemu briefowi i etapowi akceptacji struktury przed pisaniem, w praktyce rzadko potrzebna jest druga runda. Dodatkowe poprawki wykraczające poza pierwotny zakres briefu wyceniamy osobno.'
  }
];

// ── Schema.org ──
const serviceSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/#service",
      "name": "Teksty na stronę internetową",
      "description": "Profesjonalne pisanie tekstów na strony internetowe. Strony firmowe, usługowe, produktowe, O nas, landing page. Treści zoptymalizowane pod SEO i konwersję.",
      "provider": { "@id": "https://www.ecopywriting.pl/#organization" },
      "serviceType": "Website copywriting",
      "areaServed": "PL",
      "url": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/"
    },
    {
      "@type": "WebPage",
      "@id": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/#webpage",
      "url": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/",
      "name": "Teksty na Stronę — Pisanie Treści na Strony WWW | eCopywriting.pl",
      "isPartOf": { "@id": "https://www.ecopywriting.pl/#website" },
      "description": "Profesjonalne teksty na strony internetowe. Pisanie treści na strony firmowe, usługowe, produktowe i landing page. SEO + konwersja. Wycena w 24h.",
      "breadcrumb": { "@id": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://www.ecopywriting.pl/" },
        { "@type": "ListItem", "position": 2, "name": "Usługi", "item": "https://www.ecopywriting.pl/uslugi/" },
        { "@type": "ListItem", "position": 3, "name": "Teksty na stronę", "item": "https://www.ecopywriting.pl/uslugi/teksty-na-strone/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
};

// ── Page types ──
const pageTypes = [
  {
    title: 'Strona główna',
    desc: 'Pierwszych 5 sekund decyduje, czy odwiedzający zostanie. Strona główna musi natychmiast komunikować: kim jesteś, co robisz, dlaczego Ty, i co zrobić dalej. Piszemy strony główne z jasną hierarchią informacji, przekonującym value proposition i mocnym CTA.',
    icon: '🏠'
  },
  {
    title: 'Strony usługowe',
    desc: 'Każda usługa zasługuje na dedykowaną podstronę — to podstawa SEO i konwersji. Piszemy strony usługowe, które łączą opis wartości z adresowaniem obiekcji, social proof i jasnym wezwaniem do działania. Zoptymalizowane pod frazy „usługa + miasto".',
    icon: '⚡'
  },
  {
    title: 'Strona „O nas" / „O firmie"',
    desc: 'Jedna z najczęściej odwiedzanych podstron — i najczęściej zmarnowanych. Dobra strona „O nas" to nie sucha historia firmy, ale strategicznie napisana narracja budująca zaufanie: kto stoi za firmą, dlaczego robicie to, co robicie, i jakie macie doświadczenie.',
    icon: '👥'
  },
  {
    title: 'Strony produktowe',
    desc: 'Teksty na strony produktowe dla SaaS, e-commerce i firm technologicznych. Opis funkcji przetłumaczony na język korzyści, porównania planów, sekcje FAQ, social proof. Treści, które edukują i konwertują jednocześnie.',
    icon: '📦'
  },
  {
    title: 'Landing page',
    desc: 'Strony lądowania z jednym celem — konwersją. Headline, który zatrzymuje, copy, które przekonuje, CTA, które domyka. Struktura oparta na sprawdzonych frameworkach (PAS, AIDA, StoryBrand) dopasowana do Twojego odbiorcy i oferty.',
    icon: '🎯'
  },
  {
    title: 'FAQ i bazy wiedzy',
    desc: 'Strony z pytaniami i odpowiedziami, cenniki, bazy wiedzy, strony pomocy. Treści, które odciążają dział obsługi klienta, budują zaufanie i — dzięki schema markup FAQ — mogą zająć znacznie więcej miejsca w wynikach Google.',
    icon: '❓'
  },
  {
    title: 'Strony „Kariera" i employer branding',
    desc: 'Teksty na strony rekrutacyjne, opisy kultury firmy, EVP (Employee Value Proposition). Treści przyciągające talenty i budujące wizerunek pracodawcy. Każda strona pisana pod konkretną grupę docelową — inaczej do dewelopera, inaczej do handlowca.',
    icon: '🤝'
  },
  {
    title: 'Strony portfolio i case studies',
    desc: 'Prezentacja Twoich realizacji w sposób, który sprzedaje. Nie lista logotypów klientów, a strategicznie napisane case studies: kontekst, wyzwanie, rozwiązanie, rezultat. Format, który buduje social proof i wspiera decyzję zakupową.',
    icon: '📊'
  }
];

// ── Problems we solve ──
const problems = [
  {
    before: 'Strona jest, ale nie konwertuje',
    after: 'Teksty z jasnym CTA, strukturą i językiem korzyści — konwersja zamiast bounce rate',
    label: 'Konwersja'
  },
  {
    before: 'Odwiedzający nie rozumie, czym się zajmujesz',
    after: 'Czytelne value proposition w 5 sekund — od hero section po footer',
    label: 'Klarowność'
  },
  {
    before: 'Strona nie widoczna w Google',
    after: 'Teksty zoptymalizowane pod frazy, z nagłówkami, meta tagami i linkowaniem',
    label: 'SEO'
  },
  {
    before: 'Teksty pisane „kiedyś" przez kogoś z zespołu',
    after: 'Profesjonalny, spójny ton komunikacji na każdej podstronie',
    label: 'Spójność'
  },
  {
    before: 'Treść nie wyróżnia marki na tle konkurencji',
    after: 'Unikalne USP, storytelling marki i komunikacja, której nie da się skopiować',
    label: 'Wyróżnienie'
  }
];

// ── Process ──
const steps = [
  {
    num: '01',
    title: 'Brief i immersja',
    desc: 'Poznajemy Twoją firmę od środka — usługi, produkty, grupę docelową, konkurencję, wyróżniki. Wypełniasz brief, rozmawiamy, analizujemy obecną stronę. Na tym etapie zanurzamy się w Twój biznes, żeby pisać z pozycji eksperta, nie turysty.'
  },
  {
    num: '02',
    title: 'Research i architektura treści',
    desc: 'Analizujemy frazy kluczowe, język Twoich klientów, komunikację konkurencji. Projektujemy architekturę treści — jakie podstrony, w jakiej kolejności, z jaką hierarchią informacji. Mapa strony do akceptacji przed pisaniem.'
  },
  {
    num: '03',
    title: 'Wireframe tekstowy',
    desc: 'Dla każdej podstrony przygotowujemy wireframe tekstowy — struktura sekcji, nagłówki, kluczowe przekazy, CTA. To szkielet strony w formie tekstu, który pozwala zobaczyć flow przed pisaniem pełnego copy. Do akceptacji i feedbacku.'
  },
  {
    num: '04',
    title: 'Pisanie i optymalizacja',
    desc: 'Na podstawie zatwierdzonego wireframe\'u piszemy pełne teksty — każda sekcja, każdy nagłówek, każde CTA. Optymalizujemy pod SEO (frazy, nagłówki, meta tagi) i pod UX (czytelność, skanowanie, hierarchia). Ton dopasowany do Twojej marki.'
  },
  {
    num: '05',
    title: 'Dostawa i wdrożenie',
    desc: 'Dostarczamy teksty w ustalonym formacie (Google Docs, Markdown, Figma annotations) lub wdrażamy bezpośrednio w CMS. Nasz zespół programistów zapewnia poprawną hierarchię nagłówków, schema markup i optymalizację techniczną. Dwie rundy poprawek w cenie.'
  }
];

// ── Benefits ──
const benefits = [
  {
    title: 'Wireframe tekstowy, nie tylko „tekst"',
    desc: 'Nie dostarczamy luźnego tekstu w dokumencie. Każda podstrona zaczyna się od wireframe\'u — struktury sekcji, nagłówków i kluczowych przekazów. Dzięki temu widzisz flow strony zanim napiszemy pojedyncze zdanie. To oszczędza czas i eliminuje niespodzianki.'
  },
  {
    title: 'Tekst + wdrożenie = jeden dostawca',
    desc: 'Nie zostawiamy Cię z dokumentem, który musisz sam wkleić na stronę. Nasz zespół programistów może wdrożyć teksty bezpośrednio w CMS z poprawną hierarchią nagłówków, schema markup i formatowaniem. Albo zaprojektować całą stronę od zera.'
  },
  {
    title: 'SEO natywnie w każdym tekście',
    desc: 'Każdy tekst na stronę jest pisany z myślą o widoczności w Google — research fraz, optymalna struktura nagłówków, meta tagi, linkowanie wewnętrzne. Strona, która dobrze wygląda, ale nie jest widoczna w wyszukiwarce, to zmarnowana inwestycja.'
  },
  {
    title: 'Spójność komunikacji',
    desc: 'Gdy piszemy teksty na całą stronę, dbamy o spójność tonu, terminologii i stylu na każdej podstronie. Efekt: profesjonalna, jednolita komunikacja, która buduje zaufanie — nie kolekcja tekstów pisanych przez różne osoby w różnym czasie.'
  }
];

// ── Related ──
const related = [
  { title: 'Copywriting', href: '/uslugi/copywriting/', desc: 'Teksty sprzedażowe, oferty handlowe, slogany i hasła reklamowe' },
  { title: 'SEO Copywriting', href: '/uslugi/seo-copywriting/', desc: 'Zaawansowana optymalizacja treści z researchem fraz i wdrożeniem' },
  { title: 'Landing page', href: '/uslugi/landing-page/', desc: 'Strony lądowania z tekstem, designem i wdrożeniem technicznym' },
  { title: 'Opisy produktów', href: '/uslugi/opisy-produktow/', desc: 'Teksty e-commerce — opisy produktów i kategorii' }
];
---

<BaseLayout
  title="Teksty na Stronę — Pisanie Treści na Strony WWW | eCopywriting.pl"
  description="Profesjonalne teksty na strony internetowe. Pisanie treści na strony firmowe, usługowe, produktowe, O nas i landing page. Zoptymalizowane pod SEO i konwersję. Od wireframe'u tekstowego po wdrożenie. Wycena w 24h."
  keywords="teksty na stronę, pisanie tekstów na stronę, tworzenie tekstów na strony www, teksty na stronę internetową, treści na stronę, teksty www, copywriting stron internetowych, teksty na stronę firmową"
  schema={serviceSchema}
  canonical="https://www.ecopywriting.pl/uslugi/teksty-na-strone/"
>

  <!-- BREADCRUMBS -->
  <nav class="breadcrumbs" aria-label="Ścieżka nawigacji">
    <div class="container">
      <ol class="breadcrumbs__list">
        <li><a href="/">Strona główna</a></li>
        <li><a href="/uslugi/">Usługi</a></li>
        <li aria-current="page">Teksty na stronę</li>
      </ol>
    </div>
  </nav>

  <!-- ═══════════════════════════════════════
       HERO
       ═══════════════════════════════════════ -->
  <section class="srv-hero" aria-labelledby="srv-hero-title">
    <div class="srv-hero__bg" aria-hidden="true">
      <div class="srv-hero__grain"></div>
      <div class="srv-hero__gradient"></div>
    </div>

    <div class="container srv-hero__inner">
      <div class="srv-hero__badge">
        <span class="srv-hero__badge-dot"></span>
        Content & Copywriting
      </div>

      <h1 id="srv-hero-title" class="srv-hero__title">
        Teksty na stronę, które<br>
        <em>budują zaufanie i&nbsp;konwertują</em>
      </h1>

      <p class="srv-hero__subtitle">
        Profesjonalne pisanie tekstów na strony internetowe — od strony głównej
        po FAQ. Treści, które jasno komunikują wartość, wyróżniają Twoją markę
        i&nbsp;zamieniają odwiedzających w&nbsp;klientów.
      </p>

      <div class="srv-hero__actions">
        <a href="/kontakt/" class="srv-hero__cta-primary">
          Zamów wycenę
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a href="#podstrony" class="srv-hero__cta-secondary">
          Jakie podstrony piszemy
        </a>
      </div>

      <div class="srv-hero__proof">
        <div class="srv-hero__proof-item">
          <strong>Wireframe</strong> tekstowy przed pisaniem
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>SEO + konwersja</strong> w standardzie
        </div>
        <div class="srv-hero__proof-sep" aria-hidden="true"></div>
        <div class="srv-hero__proof-item">
          <strong>Tekst + wdrożenie</strong> w CMS
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PROBLEMS WE SOLVE
       ═══════════════════════════════════════ -->
  <section class="srv-problems" aria-label="Problemy, które rozwiązujemy">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Rozwiązujemy problemy"
          title="Rozpoznajesz któryś z&nbsp;tych problemów?"
          subtitle="Większość stron firmowych ma treści pisane &bdquo;na szybko&rdquo; przez kogoś z&nbsp;zespołu, a&nbsp;potem nigdy nie aktualizowane. Oto co zmieniamy."
        />
      </div>

      <div class="srv-problems__grid">
        {problems.map((p, i) => (
          <div class="srv-problems__card reveal" style={`--delay: ${i * 0.06}s`}>
            <span class="srv-problems__label">{p.label}</span>
            <div class="srv-problems__before">
              <span class="srv-problems__marker srv-problems__marker--before" aria-hidden="true">✕</span>
              <p>{p.before}</p>
            </div>
            <div class="srv-problems__divider" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </div>
            <div class="srv-problems__after">
              <span class="srv-problems__marker srv-problems__marker--after" aria-hidden="true">✓</span>
              <p>{p.after}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PAGE TYPES
       ═══════════════════════════════════════ -->
  <section class="srv-pages" id="podstrony" aria-labelledby="srv-pages-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Zakres usług"
          title="Jakie podstrony piszemy?"
          subtitle="Tworzenie tekstów na strony WWW obejmuje każdą podstronę, która wpływa na decyzję klienta — od pierwszego kontaktu na stronie głównej po FAQ i&nbsp;case studies."
        />
      </div>

      <div class="srv-pages__grid">
        {pageTypes.map((p, i) => (
          <div class="srv-pages__card reveal" style={`--delay: ${i * 0.05}s`}>
            <span class="srv-pages__card-icon" aria-hidden="true">{p.icon}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PROCESS
       ═══════════════════════════════════════ -->
  <section class="srv-process" id="proces" aria-labelledby="srv-process-title">
    <div class="container">
      <div class="reveal">
        <SectionHeading
          label="Jak pracujemy"
          title="Od briefu po gotowe teksty na&nbsp;stronę"
          subtitle="Nasz proces zaczyna się od zrozumienia Twojego biznesu, a&nbsp;kończy na gotowych tekstach wdrożonych na stronę. Wireframe tekstowy do akceptacji przed pisaniem — żadnych niespodzianek."
          inverted
        />
      </div>

      <div class="srv-process__steps">
        {steps.map((step) => (
          <div class="srv-process__step reveal">
            <div class="srv-process__step-num">{step.num}</div>
            <div class="srv-process__step-content">
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WIREFRAME EXPLAINER
       ═══════════════════════════════════════ -->
  <section class="srv-wireframe" id="wireframe" aria-labelledby="srv-wireframe-title">
    <div class="container">
      <div class="srv-wireframe__inner reveal">
        <span class="srv-wireframe__label">Nasze podejście</span>
        <h2 id="srv-wireframe-title" class="srv-wireframe__title">
          Wireframe tekstowy —<br>
          <em>zanim napiszemy słowo</em>
        </h2>
        <p class="srv-wireframe__desc">
          Nie zaczynamy od pisania. Zaczynamy od struktury. Dla każdej podstrony
          przygotowujemy wireframe tekstowy — szkielet z nagłówkami, kluczowymi przekazami,
          CTA i flow informacji. Dopiero po jego akceptacji przechodzimy do pełnego copy.
        </p>

        <div class="srv-wireframe__example" aria-label="Przykład wireframe tekstowego">
          <div class="srv-wireframe__section">
            <span class="srv-wireframe__tag">Hero</span>
            <div class="srv-wireframe__block srv-wireframe__block--lg"></div>
            <div class="srv-wireframe__block srv-wireframe__block--md"></div>
            <div class="srv-wireframe__block srv-wireframe__block--btn"></div>
          </div>
          <div class="srv-wireframe__section">
            <span class="srv-wireframe__tag">Value proposition</span>
            <div class="srv-wireframe__row">
              <div class="srv-wireframe__block srv-wireframe__block--card"></div>
              <div class="srv-wireframe__block srv-wireframe__block--card"></div>
              <div class="srv-wireframe__block srv-wireframe__block--card"></div>
            </div>
          </div>
          <div class="srv-wireframe__section">
            <span class="srv-wireframe__tag">Social proof</span>
            <div class="srv-wireframe__block srv-wireframe__block--md"></div>
          </div>
          <div class="srv-wireframe__section">
            <span class="srv-wireframe__tag">CTA</span>
            <div class="srv-wireframe__block srv-wireframe__block--sm"></div>
            <div class="srv-wireframe__block srv-wireframe__block--btn"></div>
          </div>
        </div>

        <p class="srv-wireframe__benefit">
